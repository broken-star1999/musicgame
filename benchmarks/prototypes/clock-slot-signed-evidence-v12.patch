+ * from qualification, loss, nearest choice and best-visit selection. */
+export function fitSlotClock(input: FitSlotClockInput): FitSlotClockResult {
+  validate(input);
+  const work = newWork(), cues: Cue[] = [], members: RegularMember[] = [];
+  let previousTime = -Infinity, previousIndex = -1;
+  input.events.forEach((event, arrayIndex) => {
+    work.inputReads++;
