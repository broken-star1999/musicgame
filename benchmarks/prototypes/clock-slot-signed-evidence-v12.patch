+/** EC2 source-specific all-explained-slot alternating affine fit. Static preparation only until
+ * ROOT's independent mathematical freeze. No audio, FFT, GT or old clock path. */
+export type SlotSourceId = 0 | 1 | 2 | 3;
+export interface SlotSourceEvent {
+  readonly time: number;
+  readonly strength?: number;
+  readonly boundary?: boolean;
+  /** Original member index, if supplied; otherwise the original array index. */
+  readonly index?: number;
+}
+export interface FitSlotClockInput {
+  readonly duration: number;
+  readonly events: readonly SlotSourceEvent[];
+  readonly period: number;
+  readonly anchor: number;
+  readonly from: number;
+  readonly to: number;
+  readonly ownerFrom: number;
+  readonly ownerTo: number;
+  readonly source: SlotSourceId;
+}
+export interface SlotClock {
+  readonly period: number;
+  /** Conventional n=0 anchor, supplied for external phase comparison. */
+  readonly anchor: number;
+  /** Primary-frame projection; exact emitted records use evaluationAxis. */
+  readonly pivotOrdinal: number;
+  readonly pivotTime: number;
+  readonly tolerance: number;
+  readonly subdivisionTolerance: number;
+  /** Primitive observation view normalized from this visit's actual fit rows. */
+  readonly physicalAxis: SlotPhysicalAxis;
+  /** Exact axis used to evaluate this visit's records before view normalization. */
+  readonly evaluationAxis: SlotPhysicalAxis;
+  readonly axisCertificate: { readonly checkedTargets: number; readonly maximumPredictionDifference: number; readonly toleranceSeconds: 1e-10 };
+}
+export interface SlotPhysicalAxis {
+  readonly originTick: number;
+  readonly coordinateGCD: number;
+  /** Primitive physical seconds per canonical integer coordinate, not tactus P. */
+  readonly period: number;
+  readonly pivotOrdinal: number;
+  readonly pivotTime: number;
+}
+export type SlotPhaseTick = 0 | 3 | 4 | 6 | 8 | 9;
+export interface SlotPrimaryTarget {
+  readonly localOrdinal: number;
+  readonly virtualTime: number;
+  readonly sourceMemberIndex: number | null;
+  readonly actualTime: number | null;
+  readonly residual: number | null;
+  readonly compatibility: number | null;
+  readonly inFitWindow: boolean;
+  readonly fitOpportunity: boolean;
+  readonly targetInOwner: boolean;
+  readonly ownerOpportunity: boolean;
+  readonly recordingUncensored: boolean;
+}
+export interface SlotBinding {
+  readonly source: SlotSourceId;
+  readonly sourceMemberIndex: number;
+  readonly time: number;
+  readonly targetTime: number;
+  readonly denominator: 1 | 2 | 3 | 4;
+  readonly compatibility: number;
+  readonly localOrdinal: number;
+  readonly fraction: number;
+  readonly primary: boolean;
+  readonly phaseTick: SlotPhaseTick;
+  readonly coordinateNumerator: number;
+  readonly coordinateDenominator: 12;
+}
+export interface SlotDomainCounts {
+  readonly rawMembers: number;
+  readonly sourceCues: number;
+  readonly duplicateMembers: number;
+  readonly primaryOpportunities: number;
+  readonly matchedPrimaryOpportunities: number;
+  readonly coverage: number | null;
+  readonly matchedPrimarySpan: number;
+  readonly explainedCues: number;
+  readonly unexplainedCues: number;
+  readonly primaryBindings: number;
+  readonly subdivisionBindings: number;
+}
+export interface SlotLoss {
+  /** Metrical diagnostic, explicitly excluded from physical total. */
+  readonly missingPrimaryFraction: number;
+  readonly unexplainedSourceFraction: number;
+  /** Legacy timing diagnostic only; never an EC2 objective or fit weight. */
+  readonly meanPrimaryNormalizedResidual: number;
+  readonly physicalScaleSeconds: .09;
+  readonly allCueResidualSumSeconds: number;
+  readonly meanExplainedAbsoluteResidualSeconds: number;
+  readonly allCueSquaredNormalizedResidualSum: number;
+  /** sum(explained (residual seconds/.09)^2) / all actual unique source cues. */
+  readonly allCueSquaredResidualContribution: number;
+  readonly total: number;
+  /** Fit total is unscaled; owner total is additionally scaled by width/2. */
+  readonly scaledTotal: number;
+}
+export interface SlotFitPoint {
+  readonly sourceMemberIndex: number;
+  readonly time: number;
+  readonly targetTime: number;
+  readonly localOrdinal: number;
+  readonly phaseTick: SlotPhaseTick;
+  readonly coordinateNumerator: number;
+  readonly canonicalIndex: number;
+}
+export interface SlotCanonicalRows {
+  readonly originTick: number;
+  readonly coordinateGCD: number;
+  readonly points: readonly SlotFitPoint[];
+}
+export interface SlotFitTrial {
+  readonly iteration: number;
+  readonly proposalKind: 'initial' | 'all-slots' | 'primary-seed';
+  readonly clock: SlotClock;
+  readonly eligible: boolean;
+  readonly reason: string;
+  readonly counts: SlotDomainCounts;
+  readonly loss: SlotLoss;
+  readonly primaryTargets: readonly SlotPrimaryTarget[];
+  readonly fitBindings: readonly SlotBinding[];
+  readonly fitRows: SlotCanonicalRows | null;
+  readonly olsFromIteration: number | null;
+  readonly unconstrainedPeriod: number | null;
+  readonly unconstrainedPhysicalStepSeconds: number | null;
+  readonly periodClamped: boolean;
+}
+export interface SlotClockWork {
+  inputReads: number;
+  boundaryMembersExcluded: number;
+  regularMembers: number;
+  uniqueCues: number;
+  duplicateMembers: number;
+  evaluations: number;
