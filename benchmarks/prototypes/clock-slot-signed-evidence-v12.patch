+}
+export interface FitSlotClockResult {
+  readonly version: 'EC2-source-slot-affine/v1';
+  readonly source: SlotSourceId;
+  readonly duration: number;
+  readonly from: number;
+  readonly to: number;
+  readonly ownerFrom: number;
+  readonly ownerTo: number;
+  readonly eligible: boolean;
+  readonly reason: string;
+  readonly period: number;
+  readonly anchor: number;
+  readonly clock: SlotClock;
+  readonly primaryTargets: readonly SlotPrimaryTarget[];
+  /** All bound cues with actual time in [from,to). */
+  readonly fitBindings: readonly SlotBinding[];
+  /** All bound cues with actual time in [ownerFrom,ownerTo), including halos. */
+  readonly ownerBindings: readonly SlotBinding[];
+  readonly fitCounts: SlotDomainCounts;
+  readonly ownerCounts: SlotDomainCounts;
+  readonly fitLoss: SlotLoss;
+  readonly ownerLoss: SlotLoss;
+  readonly fitRows: SlotCanonicalRows | null;
+  readonly trials: readonly SlotFitTrial[];
+  readonly selectedIteration: number;
+  readonly stopReason: 'maximum-updates' | 'degenerate-least-squares' | 'repeated-clock';
+  readonly work: SlotClockWork;
+}
+
+export const SLOT_CLOCK_LIMITS = Object.freeze({ minimumPeriod: .27, maximumPeriod: 1.2,
+  maximumWindowSeconds: 8, maximumUpdates: 4, minimumOpportunities: 4, minimumMatched: 4,
+  minimumMatchedSpan: 1, minimumCoverage: .5, maximumRawEvents: 200000,
+  maximumPrimaryRecords: 128, maximumSubdivisionRecords: 1024, maximumAbsOrdinal: 2147482624,
+  maximumFitPoints: 1152, physicalScaleSeconds: .09, maximumCoordinateGCD: 1536, maximumCanonicalPivot: 4096 });
+
+interface Cue { readonly time: number; readonly sourceMemberIndex: number; readonly cueIndex: number }
+interface RegularMember { readonly time: number; readonly sourceMemberIndex: number }
+interface Slot { readonly time: number; readonly localOrdinal: number; readonly fraction: number; readonly denominator: 2 | 3 | 4; readonly phaseTick: SlotPhaseTick }
+interface Evaluation {
+  readonly clock: SlotClock;
+  readonly primaryTargets: readonly SlotPrimaryTarget[];
+  readonly fitBindings: readonly SlotBinding[];
+  readonly ownerBindings: readonly SlotBinding[];
+  readonly fitCounts: SlotDomainCounts;
+  readonly ownerCounts: SlotDomainCounts;
+  readonly fitLoss: SlotLoss;
+  readonly ownerLoss: SlotLoss;
+  readonly fitRows: SlotCanonicalRows | null;
+  readonly eligible: boolean;
+  readonly reason: string;
+}
+const FRACTIONS = [{ fraction: 1 / 4, denominator: 4, phaseTick: 3 }, { fraction: 1 / 3, denominator: 3, phaseTick: 4 },
+  { fraction: 1 / 2, denominator: 2, phaseTick: 6 }, { fraction: 2 / 3, denominator: 3, phaseTick: 8 },
+  { fraction: 3 / 4, denominator: 4, phaseTick: 9 }] as const;
+
+function newWork(): SlotClockWork {
+  return { inputReads: 0, boundaryMembersExcluded: 0, regularMembers: 0, uniqueCues: 0, duplicateMembers: 0,
+    evaluations: 0, leastSquaresProposals: 0, leastSquaresPointReads: 0, leastSquaresDegenerate: 0,
+    leastSquaresClamped: 0, repeatedClockStops: 0, primaryTargetRecords: 0, subdivisionSlotRecords: 0,
+    nearestQueries: 0, binaryComparisons: 0, distanceComparisons: 0, assignedPrimaryCues: 0,
+    assignedSubdivisionCues: 0, domainCueReads: 0, domainMemberReads: 0, bindingsCreated: 0,
+    trialRecords: 0, maximumPrimaryRecords: 0, maximumSubdivisionRecords: 0, physicalFitPointReads: 0,
+    gcdSteps: 0, canonicalFitPoints: 0, maximumCanonicalFitPoints: 0, canonicalAxisNormalizations: 0,
+    axisCertificateTargets: 0, maximumAxisPredictionDifference: 0, proposalAttempts: 0,
+    allSlotProposalAttempts: 0, primarySeedProposalAttempts: 0, skippedDegenerateProposals: 0,
+    skippedRepeatedProposals: 0, explicitTypedBytes: 0 };
+}
+function validOrdinal(value: number): void {
+  if (!Number.isSafeInteger(value) || Math.abs(value) > SLOT_CLOCK_LIMITS.maximumAbsOrdinal) throw Error('Unsafe affine target ordinal');
+}
+function finite(value: number, name: string): void { if (!Number.isFinite(value)) throw Error(`${name} must be finite`); }
+function validate(input: FitSlotClockInput): void {
+  if (!input || !Array.isArray(input.events) || input.events.length > SLOT_CLOCK_LIMITS.maximumRawEvents) throw Error('Invalid or excessive raw source inventory');
+  for (const key of ['duration', 'period', 'anchor', 'from', 'to', 'ownerFrom', 'ownerTo'] as const) finite(input[key], key);
+  if (input.duration <= 0 || input.period < SLOT_CLOCK_LIMITS.minimumPeriod || input.period > SLOT_CLOCK_LIMITS.maximumPeriod)
+    throw Error('Duration/initial period outside finite clock domain');
+  if (input.from < 0 || input.to <= input.from || input.to > input.duration || input.to - input.from > SLOT_CLOCK_LIMITS.maximumWindowSeconds
+    || input.ownerFrom < input.from || input.ownerTo > input.to || input.ownerTo <= input.ownerFrom)
+    throw Error('Fit/owner intervals must be nonempty observed half-open domains of at most eight seconds');
+  if (!Number.isInteger(input.source) || input.source < 0 || input.source > 3) throw Error('Four-source identifier required');
+}
+
+/** At most initial+four centered OLS visits. All assignments use immutable raw
