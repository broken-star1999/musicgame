+  base.forEach((event, baseIndex) => {
+    validEvent(event, duration);
+    if (event.time < previousBase || canonical.has(event.time)) throw Error('Canonical baseline times must be ordered and unique');
+    previousBase = event.time;
+    // A new third-role overlay is not an acceptable pre-bridge baseline.
+    if (event.role !== undefined && !['beat', 'half', 'quarter', 'free'].includes(event.role)) throw Error('Expected original baseline roles');
