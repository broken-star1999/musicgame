+  return Object.freeze({ version: SALIENCE_VERSION, fingerprint: baseline.fingerprint, duration,
+    byTime: new FixedIndex(ordered), originsByTime: new FixedIndex(ordered.map(([time]) => [time, origins.get(time)!] as const)),
+    basePool: Object.freeze(basePool), domains: Object.freeze(domains), thresholds: Object.freeze(thresholds),
+    regularFrames: maxima.size, originalMembers, excludedBoundaryMembers });
+}
