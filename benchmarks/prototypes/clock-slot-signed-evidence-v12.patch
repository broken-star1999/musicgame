+    const sorted = baseIndices.map(index => basePool[index].strength).sort((a, b) => a - b);
+    const value = sorted[Math.floor(sorted.length * .75)];
+    // Preserve the ORIGINAL zero/empty fallback and arithmetic grouping exactly.
+    const threshold = Math.min(spec.threshold, (value || spec.threshold) * .55);
+    domains[mode] = Object.freeze({ mode, basis: baseline.pulse ? 'baseline-pulse' : 'baseline-onsets',
+      baseIndices: Object.freeze(baseIndices), count: baseIndices.length, q75: value ?? null, threshold });
+    thresholds[mode] = threshold;
+  }
