+    { from: input.ownerFrom, to: input.ownerTo, cueFrom: lowerBound(cues, input.ownerFrom), cueTo: lowerBound(cues, input.ownerTo),
+      rawFrom: lowerBound(members, input.ownerFrom, 0, true), rawTo: lowerBound(members, input.ownerTo, 0, true) },
