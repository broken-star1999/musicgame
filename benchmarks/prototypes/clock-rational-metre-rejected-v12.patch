@@ -0,0 +1,584 @@
+import { evaluateConditionalContent, ConditionalContentIndex, type ConditionalContentResult } from './conditional-content';
+import { matchFrontier, type MatchEvent, type MatchTarget, type MatchRole, type MatchDenominator, type MatchResult, type MatchNode } from './metrical-matching';
+
+export const OWNED_SECONDS = 2;
+export const MAX_PERIOD_HYPOTHESES = 22;
+export const MAX_PHASES_PER_HYPOTHESIS = 4;
+export const MAX_BASIC_STATES = 88;
+export const BEAM_LIMIT = 104;
+const EPS = 1e-9;
+
+export interface PhysicalMember {
+  readonly source: 0 | 1 | 2 | 3;
+  readonly index: number;
+  readonly time: number;
+  readonly strength: number;
+  readonly boundary?: boolean;
+}
+export interface PhysicalBundle {
+  readonly id: number;
+  readonly time: number;
+  readonly strength: number;
+  readonly sourceMask: number;
+  readonly members: readonly PhysicalMember[];
+}
+export interface OriginalPhase {
+  readonly anchor: number | null;
+  readonly meanResidual: number | null;
+  readonly coverage: number | null;
+  readonly supported: boolean;
+  readonly unknown: boolean;
+}
+export interface OriginalHypothesis {
+  readonly period: number | null;
+  readonly phases: readonly OriginalPhase[];
+}
+export interface OriginalBlock {
+  readonly time: number;
+  readonly from: number;
+  readonly to: number;
+  readonly hypotheses: readonly OriginalHypothesis[];
+  /** Retained caller metadata only; the consumer never filters to this value. */
+  readonly preferredPeriod?: number | null;
+}
+export interface RationalMetreInput {
+  readonly duration: number;
+  readonly events: readonly PhysicalBundle[];
+  readonly blocks: readonly OriginalBlock[];
+  readonly content: ConditionalContentIndex;
+  readonly progress?: (blockIndex: number, totalBlocks: number) => void;
+}
+export interface PrimaryTarget { readonly time: number; readonly ordinal: number; readonly fraction: 0; readonly denominator: 1 }
+export interface ContentSummary {
+  readonly score: number | null;
+  readonly rawScore: number | null;
+  readonly loss: number;
+  readonly reason: ConditionalContentResult['reason'];
+  readonly cells: number;
+  readonly validCells: number;
+  readonly work: Readonly<Record<string, number>>;
+}
+export interface CandidateDiagnostic {
+  readonly candidateId: string;
+  readonly hypothesisIndex: number;
+  readonly phaseIndex: number;
+  readonly period: number | null;
+  readonly anchor: number | null;
+  readonly originalCoverage: number | null;
+  readonly originalSupported: boolean;
+  readonly originalUnknown: boolean;
+  readonly eligible: boolean;
+  readonly reason: string;
+  targets?: number;
+  primaryTargets?: number;
+  primaryCoefficient?: number;
+  localConstant?: number;
+  content?: ContentSummary;
+}
+export interface BlockDiagnostic {
+  readonly blockIndex: number;
+  readonly inputBlockIndex: number | null;
+  readonly time: number;
+  readonly ownedFrom: number;
+  readonly ownedTo: number;
+  readonly weight: number;
+  readonly eventMass: number;
+  reason: string;
+  readonly candidates: CandidateDiagnostic[];
+  retained: number;
+  proposed: number;
+  pruned: number;
+  basicRepresentatives: number;
+  localCacheEntries: number;
+}
+export interface MatchPathProof {
+  readonly cacheId: number;
+  readonly blockIndex: number;
+  readonly candidateId: string;
+  readonly canonicalAfterId: number;
+  readonly node: number;
+  readonly reward: number;
+  /** Actual records copied from this call's returned forest, with original IDs. */
+  readonly nodes: readonly { readonly node: number; readonly record: MatchNode }[];
+}
+export interface JointAssignment {
+  readonly eventId: number;
+  readonly eventTime: number;
+  readonly strength: number;
+  readonly blockIndex: number;
+  readonly ownedFrom: number;
+  readonly ownedTo: number;
+  readonly candidateId: string;
+  readonly hypothesisIndex: number;
+  readonly phaseIndex: number;
+  readonly period: number;
+  readonly anchor: number;
+  readonly localTargetIndex: number;
+  readonly targetTime: number;
+  readonly tolerance: number;
+  readonly ordinal: number;
+  readonly fraction: number;
+  readonly denominator: MatchDenominator;
+  readonly role: MatchRole;
+  readonly matchCacheId: number;
+  readonly matchNode: number;
+  readonly compatibility: number;
+  readonly edgeReward: number;
+}
+export interface SelectedState {
+  readonly graphNode: number;
+  readonly blockIndex: number;
+  readonly ownedFrom: number;
+  readonly ownedTo: number;
+  readonly weight: number;
+  readonly unknown: boolean;
+  readonly reason: string;
+  readonly candidateId: string | null;
+  readonly hypothesisIndex: number | null;
+  readonly phaseIndex: number | null;
+  readonly period: number | null;
+  readonly anchor: number | null;
+  readonly primaryTargets: readonly PrimaryTarget[];
+  readonly assignments: readonly JointAssignment[];
+  readonly endingCursor: number;
+  readonly totalLoss: number;
+  readonly predecessor: number;
+  readonly localConstant: number;
+  readonly transitionCost: number;
+  readonly rho: number | null;
+  readonly match: { readonly cacheId: number; readonly node: number; readonly reward: number; readonly canonicalAfterId: number; readonly callerAfterId: number } | null;
+  readonly content: ContentSummary | null;
+}
+export interface RationalMetreWork {
+  physicalBundles: number;
+  physicalMembers: number;
+  sourceBlocks: number;
+  ownedBlocks: number;
+  contextOnlyBlocks: number;
+  originalHypotheses: number;
+  originalPhases: number;
+  eligibleBasicStates: number;
+  contentQueries: number;
+  targetTrials: number;
+  targets: number;
+  primaryTargets: number;
+  eventBinaryComparisons: number;
+  localEventCopies: number;
+  matchingCalls: number;
+  matchingCacheHits: number;
+  matchingCacheEntries: number;
+  matchingReturnedNodes: number;
+  matchingReturnedFrontierEntries: number;
+  frontierExpansions: number;
+  emptyCursorRebases: number;
+  transitionRequests: number;
+  transitionEvaluations: number;
+  transitionCacheHits: number;
+  rhoTrials: number;
+  graphProposals: number;
+  graphSameCursorPruned: number;
+  graphDominatedPruned: number;
+  graphBeamPruned: number;
+  graphRetainedNodes: number;
+  unknownRetainedNodes: number;
+  materializeCalls: number;
+  materializedPairs: number;
+  pathProofNodesStored: number;
+  peakLocalCacheEntries: number;
+  peakLocalMatcherNodes: number;
+  peakFrontierProposals: number;
+  peakRetainedBeam: number;
+  primaryTargetRecordsStored: number;
+  /** Unique immutable JointAssignment objects allocated, not graph references. */
+  assignmentRecordsStored: number;
+  assignmentArraysAllocated: number;
+  assignmentArrayReferences: number;
+  assignmentRecordReferences: number;
+  tieComparisons: number;
+  tieIndexArraysAllocated: number;
+  tieIndexEntriesAllocated: number;
+  peakTieIndexEntries: number;
+  tieAncestorReads: number;
+  tieNodePairComparisons: number;
+  explicitOwnedTypedArrays: number;
+  explicitOwnedTypedBytes: number;
+  contentWork: Record<string, number>;
+  matcherWork: Record<string, number>;
+}
+export interface RationalMetreResult {
+  readonly version: 'RME1-Q';
+  readonly totalLoss: number;
+  readonly selectedStates: readonly SelectedState[];
+  readonly assignments: readonly JointAssignment[];
+  readonly primaryIds: readonly number[];
+  readonly primaryEventTimes: readonly number[];
+  /** Only targets with actual primary assignments; no invented playable heads. */
+  readonly chosenPrimaryTargetTimes: readonly number[];
+  readonly unknownIntervals: readonly { readonly from: number; readonly to: number; readonly blockIndex: number; readonly reason: string }[];
+  readonly blocks: readonly BlockDiagnostic[];
+  readonly contextBlocks: readonly { readonly inputBlockIndex: number; readonly time: number; readonly reason: 'out-of-owned-domain'; readonly candidates: readonly CandidateDiagnostic[] }[];
+  readonly matchingProofs: readonly MatchPathProof[];
+  readonly retainedGraph: readonly SelectedState[];
+  readonly work: RationalMetreWork;
+  readonly approximation: { readonly basicLimit: 88; readonly beamLimit: 104; readonly exactGlobalOptimumClaim: false };
+}
+
+interface BasicState {
+  candidateId: string; hypothesisIndex: number; phaseIndex: number; period: number; anchor: number;
+  targets: MatchTarget[]; primaryTargets: PrimaryTarget[]; primaryCoefficient: number; localConstant: number;
+  content: ContentSummary; localEvents: MatchEvent[];
+}
+interface CachedPath { assignments: readonly JointAssignment[]; proof: MatchPathProof }
+interface LocalCache {
+  id: number; canonicalAfterId: number; result: MatchResult; state: BasicState; blockIndex: number;
+  materialized: Map<number, CachedPath>;
+}
+interface Transition { cost: number; rho: number; rhoOrder: number }
+interface Proposal {
+  state: BasicState | null; cursor: number; loss: number; predecessor: number; predecessorOrder: number;
+  transition: Transition | null; cache: LocalCache | null; node: number; reward: number;
+  callerAfterId: number; order: number; unknownConstant: number;
+}
