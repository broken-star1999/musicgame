index 0000000..850af43
--- /dev/null
+++ b/src/core/metrical-matching.ts
@@ -0,0 +1,296 @@
+/** Sparse monotone assignment of existing physical events to fixed targets.
+ * No role carried by an input event is read. Empty path is node -1.
+ * Rewards are engineering scores, not probabilities or calibrated likelihoods.
+ */
+export type MatchRole = 'primary' | 'half' | 'third' | 'quarter';
+export type MatchDenominator = 1 | 2 | 3 | 4;
+
+export interface MatchEvent {
+  readonly id: number;
+  readonly time: number;
+  readonly strength: number;
+  /** Already computed from the EVENT owner's weight/salience mass. */
+  readonly explanationWeight: number;
+}
+
+export interface MatchTarget {
+  readonly time: number;
+  readonly tolerance: number;
+  readonly denominator: MatchDenominator;
+  readonly role: MatchRole;
+  readonly ordinal: number;
+  readonly fraction: number;
+}
+
+export interface MatchNode {
+  readonly eventId: number;
+  /** Index in this call's original local event subset, not its global ID. */
+  readonly eventIndex: number;
+  readonly targetIndex: number;
+  readonly previous: number;
+  readonly reward: number;
+  readonly edgeReward: number;
+  readonly compatibility: number;
+  readonly eventTime: number;
+  readonly targetTime: number;
+  readonly tolerance: number;
+  readonly denominator: MatchDenominator;
+  readonly role: MatchRole;
+  readonly ordinal: number;
+  readonly fraction: number;
+}
+
+export interface FrontierEntry {
+  readonly endId: number;
+  readonly reward: number;
+  readonly node: number;
+}
+
+export interface MatchedPair {
+  readonly node: number;
+  readonly eventId: number;
+  readonly eventIndex: number;
+  readonly targetIndex: number;
+  readonly eventTime: number;
+  readonly targetTime: number;
+  readonly tolerance: number;
+  readonly denominator: MatchDenominator;
+  readonly role: MatchRole;
+  readonly ordinal: number;
+  readonly fraction: number;
+  readonly compatibility: number;
+  readonly edgeReward: number;
+}
+
+export interface MatchingWork {
+  inputEvents: number;
+  inputTargets: number;
+  eventValidationReads: number;
+  targetValidationReads: number;
+  firstAllowedIndex: number;
+  allowedEvents: number;
+  binarySearchComparisons: number;
+  legalEdges: number;
+  positiveRewardEdges: number;
+  nonPositiveEdgesSkipped: number;
+  sameEndDominatedCandidates: number;
+  nodesCreated: number;
+  fenwickQueries: number;
+  fenwickQueryVisits: number;
+  fenwickUpdateCalls: number;
+  fenwickUpdateVisits: number;
+  maximumTargetLegalEdges: number;
+  maximumTargetCreatedNodes: number;
+  frontierEndingCandidates: number;
+  frontierPrunedEndings: number;
+  frontierEntries: number;
+  /** Two Int32 scratch arrays: (allowedEvents+1) plus allowedEvents cells. */
+  peakExplicitTypedBytes: number;
+  /** Returned nodes/frontier/backtrace are plain records, not typed arrays. */
+  returnedTypedBytes: number;
+  materializeCalls: number;
+  backtraceNodes: number;
+}
+
+export interface MatchResult {
+  /** Ascending endId and strictly increasing reward, including empty path. */
+  readonly frontier: readonly FrontierEntry[];
+  readonly nodes: readonly MatchNode[];
+  readonly work: MatchingWork;
+  /** Backtrace only; no matching, edge evaluation or solver rerun. */
+  readonly materialize: (node: number) => MatchedPair[];
+}
+
+const MAX_NODE = 0x7fff_fffe;
+
+function targetMetadataConsistent(target: MatchTarget): boolean {
+  switch (target.denominator) {
+    case 1: return target.role === 'primary' && target.fraction === 0;
+    case 2: return target.role === 'half' && target.fraction === .5;
+    case 3: return target.role === 'third' && (target.fraction === 1 / 3 || target.fraction === 2 / 3);
+    case 4: return target.role === 'quarter' && (target.fraction === .25 || target.fraction === .75);
+    default: return false;
+  }
+}
+
+// A separate factory deliberately captures only nodes/work, never scratch
+// Fenwick arrays or the caller's event/target arrays.
+function backtracer(nodes: readonly MatchNode[], work: MatchingWork): (node: number) => MatchedPair[] {
+  return (node: number): MatchedPair[] => {
+    work.materializeCalls++;
+    if (!Number.isSafeInteger(node) || node < -1 || node >= nodes.length)
+      throw Error('Matching backtrace node is outside the returned forest');
+    const result: MatchedPair[] = [];
+    while (node >= 0) {
+      const current = nodes[node];
+      work.backtraceNodes++;
+      result.push({ node, eventId: current.eventId, eventIndex: current.eventIndex,
+        targetIndex: current.targetIndex, eventTime: current.eventTime,
+        targetTime: current.targetTime, tolerance: current.tolerance,
+        denominator: current.denominator, role: current.role,
+        ordinal: current.ordinal, fraction: current.fraction,
+        compatibility: current.compatibility, edgeReward: current.edgeReward });
+      node = current.previous;
+    }
+    result.reverse();
+    return result;
+  };
+}
+
+/** Events have strictly increasing global IDs and nondecreasing times.
+ * Targets are in their fixed nondecreasing time/input order. The canonical
+ * Fenwick index is the event's position AFTER afterId, never its global ID.
+ */
+export function matchFrontier(events: readonly MatchEvent[], targets: readonly MatchTarget[],
+  afterId: number, primaryCoefficient: number): MatchResult {
+  if (!Array.isArray(events) || !Array.isArray(targets)) throw Error('Matching inputs must be arrays');
+  if (!Number.isSafeInteger(afterId) || afterId < -1) throw Error('Invalid global event cursor');
+  if (!Number.isFinite(primaryCoefficient) || primaryCoefficient < 0) throw Error('Invalid primary coefficient');
+  if (events.length > MAX_NODE) throw Error('Too many local physical events');
+  const work: MatchingWork = {
+    inputEvents: events.length, inputTargets: targets.length,
+    eventValidationReads: 0, targetValidationReads: 0,
+    firstAllowedIndex: 0, allowedEvents: 0, binarySearchComparisons: 0,
+    legalEdges: 0, positiveRewardEdges: 0, nonPositiveEdgesSkipped: 0,
+    sameEndDominatedCandidates: 0, nodesCreated: 0,
+    fenwickQueries: 0, fenwickQueryVisits: 0, fenwickUpdateCalls: 0,
+    fenwickUpdateVisits: 0, maximumTargetLegalEdges: 0,
+    maximumTargetCreatedNodes: 0, frontierEndingCandidates: 0,
+    frontierPrunedEndings: 0, frontierEntries: 0,
+    peakExplicitTypedBytes: 0, returnedTypedBytes: 0,
+    materializeCalls: 0, backtraceNodes: 0,
+  };
+  let previousId = -1, previousTime = -Infinity;
+  for (const event of events) {
+    work.eventValidationReads++;
+    if (!event || !Number.isSafeInteger(event.id) || event.id < 0 || event.id <= previousId
+      || !Number.isFinite(event.time) || event.time < 0 || event.time < previousTime
+      || !Number.isFinite(event.strength) || event.strength < 0 || event.strength > 1
+      || !Number.isFinite(event.explanationWeight) || event.explanationWeight < 0)
+      throw Error('Invalid or unordered physical matching event');
+    previousId = event.id; previousTime = event.time;
+  }
+  previousTime = -Infinity;
+  for (const target of targets) {
+    work.targetValidationReads++;
+    if (!target || !Number.isFinite(target.time) || target.time < 0 || target.time < previousTime
+      || !Number.isFinite(target.tolerance) || target.tolerance <= 0
+      || !Number.isFinite(target.time - target.tolerance) || !Number.isFinite(target.time + target.tolerance)
+      || !targetMetadataConsistent(target)
+      || !Number.isSafeInteger(target.ordinal) || !Number.isFinite(target.fraction)
+      || target.fraction < 0 || target.fraction >= 1)
+      throw Error('Invalid or unordered fixed matching target');
+    previousTime = target.time;
+  }
+  let low = 0, high = events.length;
+  while (low < high) {
+    const middle = (low + high) >>> 1;
+    work.binarySearchComparisons++;
+    if (events[middle].id <= afterId) low = middle + 1;
+    else high = middle;
+  }
+  const first = low, count = events.length - first;
+  work.firstAllowedIndex = first; work.allowedEvents = count;
+  const fenwick = new Int32Array(count + 1).fill(-1);
+  const bestEnd = new Int32Array(count).fill(-1);
+  work.peakExplicitTypedBytes = fenwick.byteLength + bestEnd.byteLength;
+  const nodes: MatchNode[] = [];
+  const score = (node: number): number => node < 0 ? 0 : nodes[node].reward;
+  // Query traversal order is not event order. Resolve exact score ties by the
+  // earliest ending event, then the first created node, independent of tree shape.
+  const better = (a: number, b: number): boolean => {
+    if (a === b) return false;
+    const aScore = score(a), bScore = score(b);
+    if (aScore !== bScore) return aScore > bScore;
+    if (a < 0) return true;
+    if (b < 0) return false;
+    if (nodes[a].eventIndex !== nodes[b].eventIndex) return nodes[a].eventIndex < nodes[b].eventIndex;
+    return a < b;
+  };
+  const prefix = (lastAllowedPosition: number): number => {
+    work.fenwickQueries++;
+    let winner = -1;
+    for (let index = lastAllowedPosition + 1; index > 0; index -= index & -index) {
+      work.fenwickQueryVisits++;
+      if (better(fenwick[index], winner)) winner = fenwick[index];
+    }
+    return winner;
+  };
+  const update = (position: number, node: number): void => {
+    work.fenwickUpdateCalls++;
+    for (let index = position + 1; index <= count; index += index & -index) {
+      work.fenwickUpdateVisits++;
+      if (better(node, fenwick[index])) fenwick[index] = node;
+    }
+  };
+  for (let targetIndex = 0; targetIndex < targets.length; targetIndex++) {
+    const target = targets[targetIndex], startNode = nodes.length;
+    // Use the ORIGINAL closed subtraction predicate, not t +/- tolerance, so
+    // rounding near the boundary cannot exclude an otherwise legal edge.
+    low = first; high = events.length;
+    while (low < high) {
+      const middle = (low + high) >>> 1, time = events[middle].time;
+      work.binarySearchComparisons++;
+      if (time < target.time && Math.abs(time - target.time) > target.tolerance) low = middle + 1;
+      else high = middle;
+    }
+    const from = low;
+    high = events.length;
+    while (low < high) {
+      const middle = (low + high) >>> 1, time = events[middle].time;
+      work.binarySearchComparisons++;
+      if (time > target.time && Math.abs(time - target.time) > target.tolerance) high = middle;
+      else low = middle + 1;
+    }
+    const to = low;
+    work.maximumTargetLegalEdges = Math.max(work.maximumTargetLegalEdges, to - from);
+    for (let eventIndex = from; eventIndex < to; eventIndex++) {
+      const event = events[eventIndex], distance = Math.abs(event.time - target.time);
+      if (distance > target.tolerance) throw Error('Internal closed matching range is inconsistent');
+      work.legalEdges++;
+      const compatibility = .75 * (1 - distance / target.tolerance) + .25 * event.strength;
+      const complexity = 1 - 1 / target.denominator;
+      const edgeReward = (target.denominator === 1 ? primaryCoefficient * compatibility : 0)
+        + event.explanationWeight * (compatibility - complexity);
+      if (!Number.isFinite(compatibility) || !Number.isFinite(edgeReward)) throw Error('Nonfinite matching edge arithmetic');
+      // A nonpositive edge consumes a later cursor without improving reward;
+      // skipping this edge/target always retains a dominating prefix path.
+      if (!(edgeReward > 0)) { work.nonPositiveEdgesSkipped++; continue; }
+      work.positiveRewardEdges++;
+      const position = eventIndex - first, previous = prefix(position - 1);
+      const reward = score(previous) + edgeReward;
+      if (!Number.isFinite(reward)) throw Error('Nonfinite matching path arithmetic');
+      if (bestEnd[position] >= 0 && !(reward > nodes[bestEnd[position]].reward)) {
+        work.sameEndDominatedCandidates++;
+        continue;
+      }
+      if (nodes.length >= MAX_NODE) throw Error('Too many sparse matching nodes');
+      const node = nodes.length;
+      nodes.push(Object.freeze({ eventId: event.id, eventIndex, targetIndex, previous,
+        reward, edgeReward, compatibility, eventTime: event.time, targetTime: target.time,
+        tolerance: target.tolerance, denominator: target.denominator,
+        role: target.role, ordinal: target.ordinal, fraction: target.fraction }));
+      work.nodesCreated++;
+      bestEnd[position] = node;
+    }
+    work.maximumTargetCreatedNodes = Math.max(work.maximumTargetCreatedNodes, nodes.length - startNode);
+    // Crucial target-batched update: nodes created by this target were NOT
+    // queryable while any other edge of this same target was being evaluated.
+    for (let node = startNode; node < nodes.length; node++) update(nodes[node].eventIndex - first, node);
+  }
+  const frontier: FrontierEntry[] = [Object.freeze({ endId: afterId, reward: 0, node: -1 })];
+  let maximumReward = 0;
+  for (let position = 0; position < count; position++) {
+    const node = bestEnd[position];
+    if (node < 0) continue;
+    work.frontierEndingCandidates++;
+    if (nodes[node].reward > maximumReward) {
+      maximumReward = nodes[node].reward;
+      frontier.push(Object.freeze({ endId: nodes[node].eventId, reward: maximumReward, node }));
+    } else work.frontierPrunedEndings++;
+  }
+  work.frontierEntries = frontier.length;
+  const frozenNodes = Object.freeze(nodes);
+  return Object.freeze({ frontier: Object.freeze(frontier), nodes: frozenNodes,
+    work, materialize: backtracer(frozenNodes, work) });
+}
