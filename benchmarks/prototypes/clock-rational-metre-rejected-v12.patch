diff --git a/src/core/conditional-content.ts b/src/core/conditional-content.ts
new file mode 100644
index 0000000..334d561
--- /dev/null
+++ b/src/core/conditional-content.ts
@@ -0,0 +1,199 @@
+/** Candidate-conditioned content arithmetic only. No FFT, audio, I/O, search or GT. */
+export const CONTENT_DIMENSIONS = 12;
+export const CONTENT_SOURCE_HALF_WINDOW = 2048;
+export const MAX_QUERY_CELL_TRIALS = 4096;
+
+export type FrameReason = 'valid' | 'invalid-vector' | 'zero-vector' | 'incomplete-source-window';
+const REASONS: readonly FrameReason[] = ['valid', 'invalid-vector', 'zero-vector', 'incomplete-source-window'];
+
+export interface ConditionalContentInput {
+  readonly chroma: readonly (readonly number[])[];
+  readonly step: number;
+  readonly duration: number;
+  readonly sampleRate: number;
+}
+export interface ConditionalPhase {
+  readonly period: number;
+  readonly anchor: number;
+  readonly from: number;
+  readonly to: number;
+}
+export interface BuildWork {
+  readonly frames: number;
+  readonly validFrames: number;
+  readonly invalidVectors: number;
+  readonly zeroVectors: number;
+  readonly incompleteWindows: number;
+  readonly normEvaluations: number;
+  readonly prefixComponentsStored: number;
+  readonly normalizedComponents: number;
+  readonly typedArrays: 3;
+  readonly typedBytes: number;
+}
+export interface QuarterDescription {
+  readonly from: number;
+  readonly to: number;
+  readonly firstFrame: number;
+  readonly endFrameExclusive: number;
+  readonly validFrames: number;
+  readonly mean: readonly number[] | null;
+}
+export interface ContentCell {
+  readonly k: number;
+  readonly boundary: number;
+  readonly quarters: readonly QuarterDescription[];
+  readonly valid: boolean;
+  readonly reason: 'available' | 'empty-quarter';
+  readonly dOn: number | null;
+  readonly dOff: number | null;
+  readonly difference: number | null;
+}
+export interface QueryWork {
+  candidateCellTrials: number;
+  completeCells: number;
+  validCells: number;
+  unavailableCells: number;
+  lowerBoundQueries: number;
+  binaryComparisons: number;
+  meanComponents: number;
+  squaredDifferenceComponents: number;
+}
+export interface ConditionalContentResult {
+  readonly phase: ConditionalPhase;
+  readonly cells: readonly ContentCell[];
+  readonly score: number | null;
+  readonly rawScore: number | null;
+  readonly rangeClamped: boolean;
+  readonly onSum: number;
+  readonly offSum: number;
+  readonly differenceSum: number;
+  readonly reason: 'available' | 'no-complete-cell' | 'no-valid-cell';
+  readonly work: QueryWork;
+}
+
+/** Prefix storage is an immutable snapshot. Caller vectors are never retained. */
+export class ConditionalContentIndex {
+  readonly frameCount: number;
+  readonly step: number;
+  readonly duration: number;
+  readonly sampleRate: number;
+  readonly buildWork: BuildWork;
+  #prefix: Float64Array;
+  #counts: Uint32Array;
+  #reasons: Uint8Array;
+
+  constructor(input: ConditionalContentInput) {
+    if (!input || !Array.isArray(input.chroma) || ![input.step, input.duration, input.sampleRate].every(Number.isFinite)
+      || input.step <= 0 || input.duration <= 0 || input.sampleRate <= 0) throw Error('Invalid content timeline');
+    const count = input.chroma.length, prefixLength = (count + 1) * CONTENT_DIMENSIONS;
+    if (!Number.isSafeInteger(prefixLength) || count > 0xffffffff || (count > 0 && !Number.isFinite((count - 1) * input.step)))
+      throw Error('Content prefix size or frame times are not representable');
+    const half = CONTENT_SOURCE_HALF_WINDOW / input.sampleRate;
+    if (!Number.isFinite(half) || half <= 0) throw Error('Content source window is not representable');
+    this.frameCount = count; this.step = input.step; this.duration = input.duration; this.sampleRate = input.sampleRate;
+    this.#prefix = new Float64Array(prefixLength);
+    this.#counts = new Uint32Array(count + 1);
+    this.#reasons = new Uint8Array(count);
+    let validFrames = 0, invalidVectors = 0, zeroVectors = 0, incompleteWindows = 0, normEvaluations = 0;
+    for (let i = 0; i < count; i++) {
+      const before = i * CONTENT_DIMENSIONS, after = (i + 1) * CONTENT_DIMENSIONS;
+      for (let pitch = 0; pitch < CONTENT_DIMENSIONS; pitch++) this.#prefix[after + pitch] = this.#prefix[before + pitch];
+      this.#counts[i + 1] = this.#counts[i];
+      const row = input.chroma[i];
+      if (!Array.isArray(row) || row.length !== CONTENT_DIMENSIONS || !row.every(value => Number.isFinite(value) && value >= 0)) {
+        this.#reasons[i] = 1; invalidVectors++; continue;
+      }
+      normEvaluations++;
+      const norm = Math.hypot(...row);
+      if (!Number.isFinite(norm)) { this.#reasons[i] = 1; invalidVectors++; continue; }
+      if (!(norm > 0)) { this.#reasons[i] = 2; zeroVectors++; continue; }
+      const time = i * input.step;
+      if (time - half < 0 || time + half > input.duration) { this.#reasons[i] = 3; incompleteWindows++; continue; }
+      validFrames++; this.#counts[i + 1]++;
+      for (let pitch = 0; pitch < CONTENT_DIMENSIONS; pitch++) this.#prefix[after + pitch] += row[pitch] / norm;
+    }
+    this.buildWork = Object.freeze({ frames: count, validFrames, invalidVectors, zeroVectors, incompleteWindows,
+      normEvaluations, prefixComponentsStored: count * CONTENT_DIMENSIONS, normalizedComponents: validFrames * CONTENT_DIMENSIONS,
+      typedArrays: 3, typedBytes: this.#prefix.byteLength + this.#counts.byteLength + this.#reasons.byteLength });
+    Object.freeze(this);
+  }
+
+  frameState(index: number): { index: number; time: number; valid: boolean; reason: FrameReason } {
+    if (!Number.isSafeInteger(index) || index < 0 || index >= this.frameCount) throw Error('Invalid content frame index');
+    return { index, time: index * this.step, valid: this.#reasons[index] === 0, reason: REASONS[this.#reasons[index]] };
+  }
+
+  #lowerBound(time: number, work: QueryWork): number {
+    work.lowerBoundQueries++;
+    let low = 0, high = this.frameCount;
+    while (low < high) {
+      const middle = low + Math.floor((high - low) / 2); work.binaryComparisons++;
+      if (middle * this.step < time) low = middle + 1; else high = middle;
+    }
+    return low;
+  }
+
+  describe(phase: ConditionalPhase): ConditionalContentResult {
+    if (!phase || ![phase.period, phase.anchor, phase.from, phase.to].every(Number.isFinite)
+      || phase.period <= 0 || phase.from < 0 || phase.to < phase.from || phase.to > this.duration)
+      throw Error('Invalid fixed content phase domain');
+    const q = phase.period / 4;
+    if (!(q > 0) || !Number.isFinite(3 * q)) throw Error('Content quarter is not representable');
+    const lowRatio = (phase.from + q - phase.anchor) / phase.period;
+    const highRatio = (phase.to - 3 * q - phase.anchor) / phase.period;
+    const first = Math.floor(lowRatio) - 1, last = Math.ceil(highRatio) + 1;
+    if (![lowRatio, highRatio].every(Number.isFinite) || !Number.isSafeInteger(first) || !Number.isSafeInteger(last)
+      || Math.abs(first) > Number.MAX_SAFE_INTEGER - 2 || Math.abs(last) > Number.MAX_SAFE_INTEGER - 2)
+      throw Error('Content lattice ordinal is not safely representable');
+    if (last - first + 1 > MAX_QUERY_CELL_TRIALS) throw Error('Content phase exceeds explicit 4096-cell query budget');
+    const work: QueryWork = { candidateCellTrials: 0, completeCells: 0, validCells: 0, unavailableCells: 0,
+      lowerBoundQueries: 0, binaryComparisons: 0, meanComponents: 0, squaredDifferenceComponents: 0 };
+    const cells: ContentCell[] = [];
+    let onSum = 0, offSum = 0, differenceSum = 0;
+    for (let k = first; k <= last; k++) {
+      work.candidateCellTrials++;
+      const b = phase.anchor + k * phase.period;
+      const bounds = [b - q, b, b + q, b + 2 * q, b + 3 * q];
+      if (!bounds.every(Number.isFinite)) throw Error('Content cell boundaries are not finite');
+      if (bounds[0] < phase.from || bounds[4] > phase.to || bounds[0] < 0 || bounds[4] > this.duration) continue;
+      if (!bounds.every((value, i) => i === 0 || value > bounds[i - 1])) throw Error('Distinct content quarter boundaries are not representable');
+      work.completeCells++;
+      const indices = bounds.map(value => this.#lowerBound(value, work));
+      const quarters: QuarterDescription[] = [];
+      for (let quarter = 0; quarter < 4; quarter++) {
+        const from = indices[quarter], to = indices[quarter + 1], valid = this.#counts[to] - this.#counts[from];
+        const mean = valid ? Array<number>(CONTENT_DIMENSIONS) : null;
+        if (mean) for (let pitch = 0; pitch < CONTENT_DIMENSIONS; pitch++) {
+          mean[pitch] = (this.#prefix[to * CONTENT_DIMENSIONS + pitch] - this.#prefix[from * CONTENT_DIMENSIONS + pitch]) / valid;
+          work.meanComponents++;
+        }
+        quarters.push({ from: bounds[quarter], to: bounds[quarter + 1], firstFrame: from, endFrameExclusive: to, validFrames: valid, mean });
+      }
+      if (quarters.some(quarter => quarter.mean === null)) {
+        work.unavailableCells++; cells.push({ k, boundary: b, quarters, valid: false, reason: 'empty-quarter', dOn: null, dOff: null, difference: null }); continue;
+      }
+      let dOn = 0, dOff = 0;
+      for (let pitch = 0; pitch < CONTENT_DIMENSIONS; pitch++) {
+        const on = quarters[0].mean![pitch] - quarters[1].mean![pitch];
+        const off = quarters[2].mean![pitch] - quarters[3].mean![pitch];
+        dOn += .5 * on * on; dOff += .5 * off * off; work.squaredDifferenceComponents += 2;
+      }
+      if (!Number.isFinite(dOn) || !Number.isFinite(dOff)) throw Error('Content distance is not finite');
+      const difference = dOn - dOff;
+      onSum += dOn; offSum += dOff; differenceSum += difference; work.validCells++;
+      cells.push({ k, boundary: b, quarters, valid: true, reason: 'available', dOn, dOff, difference });
+    }
+    const rawScore = work.validCells ? differenceSum / work.validCells : null;
+    if (rawScore !== null && !Number.isFinite(rawScore)) throw Error('Content score is not finite');
+    // The exact unit-vector mean geometry bounds S. Preserve any floating overshoot.
+    const score = rawScore === null ? null : Math.max(-1, Math.min(1, rawScore));
+    return { phase: { ...phase }, cells, score, rawScore, rangeClamped: score !== rawScore, onSum, offSum, differenceSum,
+      reason: work.validCells ? 'available' : work.completeCells ? 'no-valid-cell' : 'no-complete-cell', work };
+  }
+}
+
+export function buildConditionalContentIndex(input: ConditionalContentInput): ConditionalContentIndex { return new ConditionalContentIndex(input); }
+export function evaluateConditionalContent(index: ConditionalContentIndex, phase: ConditionalPhase): ConditionalContentResult {
+  if (!(index instanceof ConditionalContentIndex)) throw Error('Conditional content index required');
+  return index.describe(phase);
+}
diff --git a/src/core/metrical-matching.ts b/src/core/metrical-matching.ts
