diff --git a/src/core/rational-application.ts b/src/core/rational-application.ts
new file mode 100644
index 0000000..73165e7
--- /dev/null
+++ b/src/core/rational-application.ts
@@ -0,0 +1,202 @@
+import type { Analysis, Onset, Rhythm, RhythmSection } from '../types';
+import { buildConditionalContentIndex } from './conditional-content';
+import { trackRationalMetre, type PhysicalBundle, type PhysicalMember, type OriginalBlock } from './rational-metre';
+
+export type RationalRole = 'beat' | 'half' | 'third' | 'quarter' | 'free';
+export interface RationalOnset extends Omit<Onset, 'role'> { role?: RationalRole }
+export interface RationalMetadata {
+  version: 'RME1-Q';
+  primaryHeads: { time: number; targetTime: number; ordinal: number; chain: number; period: number }[];
+  roleEvidence: { time: number; denominator: 1 | 2 | 3 | 4; compatibility: number }[];
+  unknownIntervals: { from: number; to: number }[];
+  knownBlocks: number;
+  sourceFrames: number;
+  assignments: number;
+}
+export interface RationalAnalysis extends Omit<Analysis, 'pulse' | 'rhythm'> {
+  pulse?: { onsets: RationalOnset[]; sections: RhythmSection[] };
+  rhythm?: Rhythm & { method?: 'RME1-Q' };
+  rational?: RationalMetadata;
+}
+export interface RationalContext {
+  /** Mixed, low, mid, high ORIGINAL detector streams, before old role binding. */
+  readonly streams: readonly (readonly Onset[])[];
+  readonly blocks: readonly OriginalBlock[];
+  readonly sampleRate: number;
+}
+export interface BundlePreparation {
+  readonly events: readonly PhysicalBundle[];
+  readonly representatives: readonly Onset[];
+  readonly memberCount: number;
+  readonly boundaryMembersExcluded: number;
+}
+
+/** Exact-time grouping only. No nearby-time clustering, averaging or old roles. */
+export function prepareRationalBundles(streams: readonly (readonly Onset[])[], duration: number): BundlePreparation {
+  if (!Array.isArray(streams) || streams.length !== 4 || !Number.isFinite(duration) || duration <= 0)
+    throw Error('Four original physical streams and a finite duration are required');
+  const groups = new Map<number, { members: PhysicalMember[]; representative: Onset; representativeSource: number }>();
+  let memberCount = 0, boundaryMembersExcluded = 0;
+  streams.forEach((stream, sourceIndex) => {
+    if (!Array.isArray(stream)) throw Error('Physical stream must be an array');
+    let last = -Infinity;
+    stream.forEach((event, index) => {
+      if (!event || !Number.isFinite(event.time) || event.time < 0 || event.time >= duration || event.time < last
+        || !Number.isFinite(event.strength) || event.strength < 0 || !Number.isSafeInteger(event.band) || event.band < 0 || event.band > 2)
+        throw Error('Invalid original physical event');
+      last = event.time;
+      if (event.boundary) { boundaryMembersExcluded++; return; }
+      const member: PhysicalMember = { source: sourceIndex as 0 | 1 | 2 | 3, index, time: event.time, strength: event.strength };
+      const copy = { ...event }; delete copy.role;
+      const old = groups.get(event.time);
+      if (!old) groups.set(event.time, { members: [member], representative: copy, representativeSource: sourceIndex });
+      else {
+        old.members.push(member);
+        if (event.strength > old.representative.strength || event.strength === old.representative.strength && sourceIndex < old.representativeSource) {
+          old.representative = copy; old.representativeSource = sourceIndex;
+        }
+      }
+      memberCount++;
+    });
+  });
+  const representatives: Onset[] = [];
+  const events = [...groups.entries()].sort((a, b) => a[0] - b[0]).map(([time, group], id): PhysicalBundle => {
+    let sourceMask = 0, strength = 0;
+    for (const member of group.members) { sourceMask |= 1 << member.source; strength = Math.max(strength, Math.min(1, Math.max(0, member.strength))); }
+    representatives.push({ ...group.representative });
+    return { id, time, strength, sourceMask, members: group.members };
+  });
+  return { events, representatives, memberCount, boundaryMembersExcluded };
+}
+
+const roleOf = (denominator: number): RationalRole => denominator === 1 ? 'beat' : denominator === 2 ? 'half' : denominator === 3 ? 'third' : 'quarter';
+function tempoFrom(beats: readonly number[]): { time: number; bpm: number }[] {
+  return beats.slice(1).map((time, i) => {
+    const from = Math.max(0, i - 1), to = Math.min(beats.length - 1, i + 2);
+    return { time, bpm: Math.round(60 * (to - from) / (beats[to] - beats[from]) * 10) / 10 };
+  });
+}
+
+/** Keep the chosen lattice only between actual matched primary TARGETS.
+ * Event residuals never clip a legal endpoint. Interior unmatched targets remain
+ * geometry, not new physical heads. Each connected known chain calls this once.
+ */
+export function rationalChainGeometry(targetTimes: readonly number[], matchedTargetTimes: readonly number[], duration: number): number[] {
+  if (!matchedTargetTimes.length) return [];
+  let first = Infinity, last = -Infinity;
+  for (const time of matchedTargetTimes) {
+    if (!Number.isFinite(time) || time < 0 || time >= duration) throw Error('Matched primary target is outside the audio domain');
+    first = Math.min(first, time); last = Math.max(last, time);
+  }
+  const geometry = targetTimes.filter(time => time >= first && time <= last && time >= 0 && time < duration);
+  const retained = new Set(geometry);
+  if (matchedTargetTimes.some(time => !retained.has(time))) throw Error('Selected primary target is missing from its chain geometry');
+  return geometry;
+}
+
+/** Automatic RME onsets are original physical events, including unassigned
+ * unknown-region events and known-target matches whose event lies in an unknown
+ * halo. None is retimed by the new global confidence/grid. Without RME metadata,
+ * or with an explicit manual BPM, delegate to the unchanged legacy timing path.
+ */
+export function rationalNoteTime(onset: RationalOnset, metadata: RationalMetadata | undefined, bpmOverride: number | undefined,
+  legacyTiming: (onset: RationalOnset) => number): number {
+  return metadata !== undefined && bpmOverride === undefined ? onset.time : legacyTiming(onset);
+}
+
+/** Apply exactly one joint explanation AFTER the unchanged baseline canonical pass.
+ * The old binder must not run again on this result. All heads retain original times.
+ */
+export function applyRationalAnalysis(baseline: Analysis, context: RationalContext,
+  progress?: (fraction: number, stage: string) => void): {
+    analysis: RationalAnalysis;
+    explanation: ReturnType<typeof trackRationalMetre>;
+    bundles: BundlePreparation;
+  } {
+  if (!Number.isFinite(context.sampleRate) || context.sampleRate <= 0) throw Error('Invalid original sample rate');
+  const bundles = prepareRationalBundles(context.streams, baseline.duration);
+  const content = buildConditionalContentIndex({ chroma: baseline.chroma ?? [], step: baseline.chromaStep ?? .05,
+    duration: baseline.duration, sampleRate: context.sampleRate });
+  const explanation = trackRationalMetre({ duration: baseline.duration, events: bundles.events, blocks: context.blocks, content,
+    progress: (block, total) => progress?.((block + 1) / Math.max(1, total), '正在联合选择节拍层级与音符角色') });
+  const known = explanation.selectedStates.filter(state => !state.unknown);
+  // A wholly unavailable original candidate lattice preserves the exact old
+  // object, without an RME marker. Mixed unknown input instead uses the explicit
+  // physical-time / finite-utility bridge, not a partial legacy chart fallback.
+  if (!known.length) return { analysis: baseline, explanation, bundles };
+  const primary = explanation.assignments.filter(assignment => assignment.denominator === 1);
+  if (primary.length < 2) throw Error('联合节拍选择没有建立足够的主拍起点，请更换节奏更清楚的音乐。');
+  const unknown = explanation.unknownIntervals.map(interval => ({ from: interval.from, to: interval.to }));
+  const isUnknown = (time: number): boolean => unknown.some(interval => time >= interval.from && time < interval.to);
+  const pulse = baseline.pulse ?? { onsets: baseline.onsets, sections: [] };
+  const byTime = new Map<number, RationalOnset>();
+  for (const event of pulse.onsets) {
+    const copy: RationalOnset = { ...event };
+    if (!event.boundary && !isUnknown(event.time)) copy.role = 'free';
+    byTime.set(event.time, copy);
+  }
+  for (const assignment of explanation.assignments) {
+    const event = bundles.representatives[assignment.eventId];
+    if (!event || event.time !== assignment.eventTime) throw Error('Joint assignment lost its original physical representative');
+    byTime.set(event.time, { ...event, role: roleOf(assignment.denominator) });
+  }
+  const regular = [...byTime.values()].filter(event => !event.boundary);
+  for (const event of byTime.values()) if (event.boundary && regular.some(other => Math.abs(other.time - event.time) <= .085)) byTime.delete(event.time);
+  const onsets = [...byTime.values()].sort((a, b) => a.time - b.time);
+
+  // Geometry uses selected primary lattice targets. Only matched IDs produce heads.
+  // Exact matched TARGET bounds retain legal 80--90ms residual endpoint matches.
+  const geometry: number[] = [];
+  const primaryHeads: RationalMetadata['primaryHeads'] = [];
+  let chain = -1, ordinal = 0, wasUnknown = true;
+  let current: typeof explanation.selectedStates[number][] = [];
+  const finishChain = () => {
+    if (!current.length) return;
+    const actual = current.flatMap(state => state.assignments.filter(assignment => assignment.denominator === 1));
+    geometry.push(...rationalChainGeometry(current.flatMap(state => state.primaryTargets.map(target => target.time)),
+      actual.map(assignment => assignment.targetTime), baseline.duration));
+    current = [];
+  };
+  for (const state of explanation.selectedStates) {
+    if (state.unknown) { finishChain(); wasUnknown = true; continue; }
+    if (wasUnknown) { chain++; ordinal = 0; wasUnknown = false; }
+    current.push(state);
+    const matched = new Map(state.assignments.filter(assignment => assignment.denominator === 1).map(assignment => [assignment.targetTime, assignment]));
+    for (const target of state.primaryTargets) {
+      const assignment = matched.get(target.time);
+      if (assignment) primaryHeads.push({ time: assignment.eventTime, targetTime: target.time, ordinal, chain, period: assignment.period });
+      ordinal++;
+    }
+  }
+  finishChain();
+  if (primaryHeads.length !== primary.length) throw Error('Selected primary identities and complete target ordinals differ');
+  for (const time of baseline.rhythm?.beats ?? []) if (isUnknown(time)) geometry.push(time);
+  geometry.sort((a, b) => a - b);
+  const beats = geometry.filter((time, i) => i === 0 || time > geometry[i - 1]);
+  if (beats.length < 2) throw Error('联合节拍选择没有形成可用的连续参考。');
+  const totalPrimaryTargets = known.reduce((sum, state) => sum + state.primaryTargets.length, 0);
+  const confidence = primary.reduce((sum, assignment) => sum + assignment.compatibility, 0) / Math.max(1, totalPrimaryTargets);
+  const periods = known.map(state => ({ period: state.period!, weight: state.ownedTo - state.ownedFrom })).sort((a, b) => a.period - b.period);
+  const halfWeight = periods.reduce((sum, value) => sum + value.weight, 0) / 2;
+  let accumulated = 0, dominantPeriod = periods[0].period;
+  for (const value of periods) { accumulated += value.weight; dominantPeriod = value.period; if (accumulated >= halfWeight) break; }
+  const metadata: RationalMetadata = { version: 'RME1-Q', primaryHeads,
+    roleEvidence: explanation.assignments.map(assignment => ({ time: assignment.eventTime, denominator: assignment.denominator, compatibility: assignment.compatibility })),
+    unknownIntervals: unknown, knownBlocks: known.length, sourceFrames: bundles.events.length, assignments: explanation.assignments.length };
+  const analysis: RationalAnalysis = { ...baseline, bpm: Math.round(60 / dominantPeriod * 10) / 10, confidence: Math.max(0, Math.min(1, confidence)),
+    rhythm: { beats, tempo: tempoFrom(beats), confidence: Math.max(0, Math.min(1, confidence)), downbeats: [], meterConfidence: 0, method: 'RME1-Q' },
+    pulse: { ...pulse, onsets }, rational: metadata };
+  return { analysis, explanation, bundles };
+}
+
+/** Stable single-finger thinning is based on the complete target ordinal,
+ * including unmatched targets. It never alternates phase according to salience.
+ */
+export function rationalSingleFingerEvents(events: readonly RationalOnset[], metadata: RationalMetadata, gap: number): RationalOnset[] {
+  const heads = new Map(metadata.primaryHeads.map(head => [head.time, head]));
+  return events.filter(event => {
+    if (event.role !== 'beat') return true;
+    const head = heads.get(event.time);
+    return !head || head.ordinal % Math.max(1, Math.ceil(gap / head.period)) === 0;
+  });
+}
