+import type { RationalOnset, RationalMetadata } from './rational-application';
+
+/** Finite metrical evidence; an erroneous label is never lexicographically infinite.
+ * All automatic RME regions, including unknown remainder, share this new utility:
+ * strength^2 + .005 + (assigned ? compatibility/denominator : 0).
+ * Unknown old roles remain threshold/filter candidates but confer no new bonus.
+ * This is not exact legacy selection for mixed unknown input; whole-unknown input
+ * has no RME marker and the chart bridge never calls this selector for it.
+ * The actual chart bridge supplies rationalNoteTime, preserving physical order.
+ */
+export function selectRationalOnsets(onsets: readonly RationalOnset[], gap: number, threshold: number,
+  timing: (onset: RationalOnset) => number, metadata: RationalMetadata): RationalOnset[] {
+  const evidence = new Map(metadata.roleEvidence.map(value => [value.time, value]));
+  const events = onsets.filter(onset => onset.strength >= threshold || onset.role === 'beat').slice().sort((a, b) => a.time - b.time);
+  const times = events.map(timing), scores = new Float64Array(events.length + 1), previous = new Int32Array(events.length), take = new Uint8Array(events.length);
+  for (let i = 0; i < events.length; i++) {
+    let low = 0, high = i;
+    while (low < high) {
+      const middle = (low + high) >>> 1;
+      if (times[i] - times[middle] >= gap - 1e-6) low = middle + 1; else high = middle;
+    }
+    previous[i] = low;
+    const observation = evidence.get(events[i].time);
+    const finiteRoleValue = observation ? observation.compatibility / observation.denominator : 0;
+    const value = scores[low] + events[i].strength ** 2 + .005 + finiteRoleValue;
+    const choose = value > scores[i] + 1e-10;
+    scores[i + 1] = choose ? value : scores[i]; take[i] = Number(choose);
+  }
+  const selected: RationalOnset[] = [];
+  for (let i = events.length - 1; i >= 0;) {
+    if (take[i]) { selected.push(events[i]); i = previous[i] - 1; } else i--;
+  }
+  return selected.reverse();
+}
