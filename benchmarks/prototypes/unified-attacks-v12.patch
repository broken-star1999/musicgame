+++ b/src/core/unified-attack-application.ts
@@ -0,0 +1,148 @@
+import type { Analysis, Onset, Rhythm } from '../types';
+import { estimateTempo } from './signal-analysis';
+import { trackBeats } from './rhythm';
+import { prepareUnifiedAtoms, type UnifiedAtomsResult } from './unified-attack-atoms';
+import { bindUnifiedRoles } from './unified-attack-roles';
+import { prepareSalience, compactSalience, type ArrangementSalience, type SaliencePreparation } from './unified-attack-salience';
+
+export interface UnifiedAttackContext {
+  readonly streams: readonly (readonly Onset[])[];
+  readonly sampleRate: number;
+}
+export interface UnifiedAttackObservations {
+  readonly version: 'UA1-observation-stats/v1';
+  readonly fingerprint: string;
+  readonly duration: number;
+  readonly atoms: number;
+  readonly regularMembers: number;
+  readonly excludedBoundaryMembers: number;
+  readonly sourceMemberCounts: readonly number[];
+  readonly representativeSourceCounts: readonly number[];
+  readonly sourceMaskCounts: Readonly<Record<string, number>>;
+}
+export interface UnifiedAttackClockMetadata {
+  readonly version: 'UA1-common-attack/v1';
+  readonly primaryHeads: readonly { readonly time: number; readonly period: number }[];
+  readonly counts: { readonly atoms: number; readonly bindings: number; readonly primary: number; readonly half: number; readonly quarter: number };
+}
+export interface UnifiedAttackFeatureAnalysis extends Analysis { readonly unifiedAttackObservations: UnifiedAttackObservations }
+export interface UnifiedAttackAnalysis extends UnifiedAttackFeatureAnalysis {
+  readonly unifiedAttackClock: UnifiedAttackClockMetadata;
+  readonly arrangementSalience: ArrangementSalience;
+}
+export type UnifiedRoleResult = ReturnType<typeof bindUnifiedRoles>;
+export interface UnifiedAttackApplication {
+  readonly analysis: UnifiedAttackAnalysis;
+  readonly atoms: UnifiedAtomsResult;
+  readonly roles: UnifiedRoleResult;
+  readonly seed: ReturnType<typeof estimateTempo>;
+  readonly rhythm: Rhythm;
+  readonly salience: SaliencePreparation;
+}
+
+function contextFor(baseline: Analysis, context: UnifiedAttackContext): void {
+  if (!baseline || typeof baseline.fingerprint !== 'string' || !Number.isFinite(baseline.duration) || baseline.duration <= 0
+    || !context || !Number.isFinite(context.sampleRate) || context.sampleRate <= 0)
+    throw Error('Invalid original common-attack context');
+}
+
+export function unifiedAttackStatistics(baseline: Analysis, prepared: UnifiedAtomsResult): UnifiedAttackObservations {
+  const sourceMemberCounts = [0, 0, 0, 0], representativeSourceCounts = [0, 0, 0, 0], sourceMaskCounts: Record<string, number> = {};
+  for (const atom of prepared.atoms) {
+    representativeSourceCounts[atom.representative.source]++;
+    sourceMaskCounts[String(atom.sourceMask)] = (sourceMaskCounts[String(atom.sourceMask)] ?? 0) + 1;
+    for (const member of atom.members) sourceMemberCounts[member.source]++;
+  }
+  return { version: 'UA1-observation-stats/v1', fingerprint: baseline.fingerprint, duration: baseline.duration,
+    atoms: prepared.atoms.length, regularMembers: prepared.members, excludedBoundaryMembers: prepared.excludedBoundaryMembers,
+    sourceMemberCounts, representativeSourceCounts, sourceMaskCounts };
+}
+
+/** Feature-only control: one physical grouping, no clock, role, normalizer or B-field replacement. */
+export function prepareUnifiedAttackFeatures(baseline: Analysis, context: UnifiedAttackContext): UnifiedAttackFeatureAnalysis {
+  contextFor(baseline, context);
+  const atoms = prepareUnifiedAtoms(context.streams, baseline.duration);
+  return { ...baseline, unifiedAttackObservations: unifiedAttackStatistics(baseline, atoms) };
+}
+
+function tempoFrom(beats: readonly number[]): Rhythm['tempo'] {
+  return beats.slice(1).map((time, i) => {
+    const from = Math.max(0, i - 1), to = Math.min(beats.length - 1, i + 2);
+    return { time, bpm: Math.round(60 * (to - from) / (beats[to] - beats[from]) * 10) / 10 };
+  });
+}
+
+/** Only accepted tracker output is clipped; this does not create physical note events. */
+export function normalizeUnifiedRhythm(rhythm: Rhythm, duration: number): Rhythm {
+  const beats = rhythm.beats.filter(time => Number.isFinite(time) && time >= 0 && time < duration);
+  if (beats.some((time, i) => i > 0 && time <= beats[i - 1])) throw Error('Common-attack reference does not progress');
+  if (beats.length < 2) throw Error('共同起音没有形成足够的连续拍点，请更换节奏更清楚的音乐。');
+  const retained = new Set(beats);
+  return { ...rhythm, beats, tempo: tempoFrom(beats), downbeats: rhythm.downbeats.filter(time => retained.has(time)) };
+}
+
+/** Actual materialization seam, with no hidden process registry or second role fit. */
+export function materializeUnifiedAttackAnalysis(baseline: Analysis, context: UnifiedAttackContext, prepared: UnifiedAtomsResult,
+  roles: UnifiedRoleResult, rhythm: Rhythm, seed: ReturnType<typeof estimateTempo>, salience: SaliencePreparation): UnifiedAttackAnalysis {
+  if (salience.fingerprint !== baseline.fingerprint || salience.duration !== baseline.duration)
+    throw Error('Common-attack salience input identity differs');
+  const byTime = new Map<number, Onset>();
+  for (const event of salience.basePool) {
+    const copy: Onset = { ...event };
+    if (!event.boundary) copy.role = 'free';
+    byTime.set(event.time, copy);
+  }
+  const atoms = new Map(prepared.atoms.map(atom => [atom.id, atom]));
+  const targets = new Map<number, UnifiedRoleResult['targets'][number]>();
+  for (const target of roles.targets) if (target.atomId !== null) {
+    if (targets.has(target.atomId)) throw Error('One common atom was reserved by two targets');
+    targets.set(target.atomId, target);
+  }
+  const used = new Set<number>();
+  const primaryHeads: { time: number; period: number }[] = [];
+  const counts = { atoms: prepared.atoms.length, bindings: roles.bindings.length, primary: 0, half: 0, quarter: 0 };
+  for (const binding of roles.bindings) {
+    const atom = atoms.get(binding.atomId), member = context.streams[binding.source]?.[binding.sourceMemberIndex];
+    const canonical = salience.byTime.get(binding.time), target = targets.get(binding.atomId);
+    if (!atom || used.has(binding.atomId) || atom.time !== binding.time || !member || member.boundary || member.time !== binding.time
+      || atom.representative.source !== binding.source || atom.representative.index !== binding.sourceMemberIndex
+      || !canonical || !target || target.actualTime !== binding.time || target.targetTime !== binding.targetTime
+      || target.role !== binding.role || target.period !== binding.period || target.compatibility !== binding.compatibility
+      || !Number.isFinite(binding.period) || binding.period <= 0 || !Number.isFinite(binding.targetTime)
+      || binding.targetTime < 0 || binding.targetTime >= baseline.duration
+      || !Number.isFinite(binding.compatibility) || binding.compatibility < 0 || binding.compatibility > 1
+      || Math.abs(binding.time - binding.targetTime) > target.tolerance)
+      throw Error('Common-attack binding lost its real member/target identity');
+    const copy: Onset = { ...canonical, role: binding.role }; delete copy.boundary;
+    byTime.set(binding.time, copy); used.add(binding.atomId);
+    if (binding.role === 'beat') { counts.primary++; primaryHeads.push({ time: binding.time, period: binding.period }); }
+    else counts[binding.role]++;
+  }
+  if (targets.size !== roles.bindings.length) throw Error('Common-attack target tape differs from actual bindings');
+  const regular = [...byTime.values()].filter(event => !event.boundary);
+  for (const event of byTime.values()) if (event.boundary && regular.some(other => Math.abs(other.time - event.time) <= .085)) byTime.delete(event.time);
+  const onsets = [...byTime.values()].sort((a, b) => a.time - b.time);
+  const unifiedAttackClock: UnifiedAttackClockMetadata = { version: 'UA1-common-attack/v1', primaryHeads, counts };
+  return { ...baseline, bpm: seed.bpm, confidence: seed.confidence, rhythm,
+    pulse: { onsets, sections: [{ start: 0, end: baseline.duration, band: 'mixed', support: rhythm.confidence }] },
+    unifiedAttackObservations: unifiedAttackStatistics(baseline, prepared), unifiedAttackClock, arrangementSalience: compactSalience(salience) };
+}
+
+/** Full candidate: one atoms call, one accepted tempo call, one accepted tracker call, one role binder. */
+export function applyUnifiedAttackAnalysis(baseline: Analysis, context: UnifiedAttackContext,
+  progress?: (fraction: number, stage: string) => void): UnifiedAttackApplication {
+  contextFor(baseline, context);
+  progress?.(.05, '正在合并多声部起音');
+  const atoms = prepareUnifiedAtoms(context.streams, baseline.duration);
+  const salience = prepareSalience(baseline, context.streams);
+  const clockPoints: Onset[] = atoms.atoms.map(atom => ({ time: atom.time, strength: 1, band: 1 }));
+  progress?.(.25, '正在估计共同节拍');
+  const seed = estimateTempo(clockPoints);
+  progress?.(.5, '正在跟踪共同拍点');
+  const rhythm = normalizeUnifiedRhythm(trackBeats(clockPoints, baseline.duration, seed.bpm, clockPoints), baseline.duration);
+  progress?.(.8, '正在绑定真实起音');
+  const roles = bindUnifiedRoles(atoms.atoms, rhythm.beats, baseline.duration);
+  const analysis = materializeUnifiedAttackAnalysis(baseline, context, atoms, roles, rhythm, seed, salience);
+  progress?.(1, '共同起音谱面分析完成');
+  return { analysis, atoms, roles, seed, rhythm, salience };
+}
