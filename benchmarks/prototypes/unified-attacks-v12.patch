+++ b/src/core/unified-attack-atoms.ts
@@ -0,0 +1,109 @@
+/** UA1 hypothesis-independent observation families. This module preserves raw
+ * witnesses and never assigns musical roles or scores source amplitudes. */
+export type SourceId = 0 | 1 | 2 | 3;
+export interface SourceEvent {
+  readonly time: number;
+  readonly strength: number;
+  readonly band: number;
+  readonly boundary?: boolean;
+}
+export interface AtomMember {
+  readonly source: SourceId;
+  readonly index: number;
+  readonly time: number;
+  readonly strength: number;
+  readonly band: number;
+}
+export interface UnifiedAtom {
+  readonly id: number;
+  readonly time: number;
+  readonly sourceMask: number;
+  readonly members: readonly AtomMember[];
+  readonly representative: AtomMember;
+}
+export type Atom = UnifiedAtom;
+export interface AtomWork {
+  inputReads: number;
+  regularMembers: number;
+  boundaryMembers: number;
+  cursorAdvances: number;
+  mergeSlotComparisons: number;
+  memberRecords: number;
+  distinctTimeRecords: number;
+  families: number;
+  maximumMembersInFamily: number;
+  maximumDistinctTimesInFamily: number;
+}
+export interface UnifiedAtomsResult {
+  readonly version: 'UA1-atoms/v1';
+  readonly atoms: readonly UnifiedAtom[];
+  /** Total regular raw members. Each is retained in exactly one atom. */
+  readonly members: number;
+  readonly excludedBoundaryMembers: number;
+  readonly work: AtomWork;
+}
+export const UNIFIED_ATOM_LIMITS = Object.freeze({
+  sources: 4, maximumDuration: 300, maximumMembersPerSource: 200000,
+  maximumMembers: 800000, maximumAtoms: 800000, maximumFamilySpanSeconds: .05,
+});
+
+/** Sources must be the four original sorted pre-role streams. Boundary members
+ * are validated but excluded before both exact-time union and family formation.
+ * Four-way merge gives time/source/index order without amplitude-based ties.
+ */
+export function prepareUnifiedAtoms(streams: readonly (readonly SourceEvent[])[], duration: number): UnifiedAtomsResult {
+  const L = UNIFIED_ATOM_LIMITS;
+  if (!Number.isFinite(duration) || duration <= 0 || duration > L.maximumDuration
+    || !Array.isArray(streams) || streams.length !== L.sources) throw Error('UA1 requires four original streams and a finite recording domain');
+  const work: AtomWork = { inputReads: 0, regularMembers: 0, boundaryMembers: 0,
+    cursorAdvances: 0, mergeSlotComparisons: 0, memberRecords: 0, distinctTimeRecords: 0,
+    families: 0, maximumMembersInFamily: 0, maximumDistinctTimesInFamily: 0 };
+  for (const stream of streams) {
+    if (!Array.isArray(stream) || stream.length > L.maximumMembersPerSource) throw Error('UA1 original stream exceeds its member domain');
+    let previous = -Infinity;
+    for (const event of stream) {
+      work.inputReads++;
+      if (!event || !Number.isFinite(event.time) || event.time < 0 || event.time >= duration || event.time < previous
+        || !Number.isFinite(event.strength) || event.strength < 0 || !Number.isInteger(event.band) || event.band < 0 || event.band > 2
+        || event.boundary !== undefined && typeof event.boundary !== 'boolean') throw Error('UA1 original source member is invalid or unordered');
+      previous = event.time;
+      if (event.boundary) work.boundaryMembers++; else work.regularMembers++;
+    }
+  }
+  const cursor = [0, 0, 0, 0], atoms: UnifiedAtom[] = [];
+  let family: AtomMember[] = [], distinctRepresentatives: AtomMember[] = [], sourceMask = 0;
+  const skipBoundary = (source: number): void => {
+    const stream = streams[source];
+    while (cursor[source] < stream.length && stream[cursor[source]].boundary) {
+      cursor[source]++; work.cursorAdvances++;
+    }
+  };
+  const flush = (): void => {
+    if (!family.length) return;
+    const representative = distinctRepresentatives[Math.floor((distinctRepresentatives.length - 1) / 2)];
+    atoms.push({ id: atoms.length, time: representative.time, sourceMask, members: family, representative });
+    work.families++; work.maximumMembersInFamily = Math.max(work.maximumMembersInFamily, family.length);
+    work.maximumDistinctTimesInFamily = Math.max(work.maximumDistinctTimesInFamily, distinctRepresentatives.length);
+    family = []; distinctRepresentatives = []; sourceMask = 0;
+  };
+  for (let source = 0; source < L.sources; source++) skipBoundary(source);
+  while (true) {
+    let chosen = -1;
+    for (let source = 0; source < L.sources; source++) {
+      if (cursor[source] >= streams[source].length) continue;
+      work.mergeSlotComparisons++;
+      if (chosen < 0 || streams[source][cursor[source]].time < streams[chosen][cursor[chosen]].time) chosen = source;
+    }
+    if (chosen < 0) break;
+    const index = cursor[chosen], event = streams[chosen][index];
+    const member: AtomMember = { source: chosen as SourceId, index, time: event.time, strength: event.strength, band: event.band };
+    if (family.length && member.time - family[0].time > L.maximumFamilySpanSeconds) flush();
+    if (!family.length || member.time !== family[family.length - 1].time) {
+      distinctRepresentatives.push(member); work.distinctTimeRecords++;
+    }
+    family.push(member); sourceMask |= 1 << chosen; work.memberRecords++;
+    cursor[chosen]++; work.cursorAdvances++; skipBoundary(chosen);
+  }
+  flush();
+  return { version: 'UA1-atoms/v1', atoms, members: work.regularMembers, excludedBoundaryMembers: work.boundaryMembers, work };
+}
