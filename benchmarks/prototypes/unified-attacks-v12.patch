@@ -0,0 +1,177 @@
+import { UNIFIED_ATOM_LIMITS, type AtomMember, type SourceId, type UnifiedAtom } from './unified-attack-atoms';
+
+export type UnifiedRole = 'beat' | 'half' | 'quarter';
+export interface UnifiedRoleBinding {
+  readonly atomId: number;
+  readonly time: number;
+  readonly targetTime: number;
+  readonly role: UnifiedRole;
+  readonly source: SourceId;
+  readonly sourceMemberIndex: number;
+  readonly period: number;
+  readonly compatibility: number;
+}
+export interface UnifiedRoleTarget {
+  readonly targetTime: number;
+  readonly role: UnifiedRole;
+  readonly period: number;
+  readonly tolerance: number;
+  readonly intervalIndex: number;
+  readonly atomId: number | null;
+  readonly actualTime: number | null;
+  readonly compatibility: number | null;
+}
+export interface UnifiedRoleWork {
+  atomValidationReads: number;
+  memberValidationReads: number;
+  medianScanReads: number;
+  beatValidationReads: number;
+  targets: number;
+  nearestQueries: number;
+  binaryComparisons: number;
+  successorTraversals: number;
+  predecessorTraversals: number;
+  selectedAtoms: number;
+  primaryBindings: number;
+  halfBindings: number;
+  quarterBindings: number;
+  bindingSortComparisons: number;
+  explicitTypedBytes: number;
+}
+export interface UnifiedRoleResult {
+  readonly version: 'UA1-roles/v1';
+  /** Sorted by actual member time/id. Targets preserve reservation traversal. */
+  readonly bindings: readonly UnifiedRoleBinding[];
+  readonly targets: readonly UnifiedRoleTarget[];
+  readonly work: UnifiedRoleWork;
+}
+export const UNIFIED_ROLE_LIMITS = Object.freeze({ maximumBeatRecords: 30001, maximumAtoms: 800000, maximumMembers: 800000 });
+
+function validMember(member: AtomMember, duration: number): boolean {
+  return !!member && Number.isInteger(member.source) && member.source >= 0 && member.source < 4
+    && Number.isSafeInteger(member.index) && member.index >= 0 && member.index < UNIFIED_ATOM_LIMITS.maximumMembersPerSource
+    && Number.isFinite(member.time) && member.time >= 0 && member.time < duration
+    && Number.isFinite(member.strength) && member.strength >= 0 && Number.isInteger(member.band) && member.band >= 0 && member.band <= 2;
+}
+function sameMember(a: AtomMember, b: AtomMember): boolean {
+  return a.source === b.source && a.index === b.index && a.time === b.time && a.strength === b.strength && a.band === b.band;
+}
+
+/** Validate the prepared canonical value shape, not JS reference identity. The
+ * caller/bridge still owns correspondence to its original raw source arrays.
+ */
+function validateAtoms(atoms: readonly UnifiedAtom[], duration: number, work: UnifiedRoleWork): void {
+  let lastTime = -Infinity, lastFamilyFirst = -Infinity, lastFamilyLast = -Infinity, memberCount = 0;
+  const lastSourceIndex = [-1, -1, -1, -1];
+  for (let at = 0; at < atoms.length; at++) {
+    const atom = atoms[at]; work.atomValidationReads++;
+    if (!atom || atom.id !== at || !Number.isFinite(atom.time) || atom.time < 0 || atom.time >= duration || atom.time <= lastTime
+      || !Number.isSafeInteger(atom.sourceMask) || atom.sourceMask < 1 || atom.sourceMask > 15
+      || !Array.isArray(atom.members) || !atom.members.length || !validMember(atom.representative, duration)) throw Error('UA1 role input is not a canonical atom');
+    let mask = 0, previous: AtomMember | null = null, distinct = 0;
+    for (const member of atom.members) {
+      work.memberValidationReads++; memberCount++;
+      if (memberCount > UNIFIED_ROLE_LIMITS.maximumMembers || !validMember(member, duration)
+        || member.index <= lastSourceIndex[member.source]
+        || previous && (member.time < previous.time || member.time === previous.time
