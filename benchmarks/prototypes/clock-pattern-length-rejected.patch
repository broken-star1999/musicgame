index 0000000..0cc7e19
--- /dev/null
+++ b/src/core/pattern-length.ts
@@ -0,0 +1,409 @@
+import { config } from './tempo-family-config';
+
+export type PatternLength = 1 | 2 | 4;
+export interface PatternOriginalPhase {
+  readonly anchor: number;
+  readonly meanResidual: number;
+  readonly coverage: number;
+  readonly supported: boolean;
+  readonly unknown: boolean;
+}
+export interface PatternLengthBlock {
+  readonly time: number;
+  readonly from: number;
+  readonly to: number;
+  readonly preferredPeriod: number | null;
+  readonly hypotheses: readonly { readonly period: number; readonly phases: readonly PatternOriginalPhase[] }[];
+}
+export interface PatternLagEvidence {
+  readonly lag: PatternLength;
+  readonly pairs: number;
+  readonly mean: number | null;
+}
+export interface PatternPhaseEvidence {
+  readonly phaseIndex: number;
+  readonly anchor: number | null;
+  readonly originalCoverage: number | null;
+  readonly originalSupported: boolean;
+  readonly originalUnknown: boolean;
+  readonly lags: readonly PatternLagEvidence[];
+}
+export interface PatternEvidenceBlock {
+  readonly blockIndex: number;
+  readonly time: number;
+  readonly period: number | null;
+  readonly hypothesisIndex: number | null;
+  readonly phases: readonly PatternPhaseEvidence[];
+}
+export interface PatternEvidenceResult {
+  readonly recurrenceBlocks: readonly PatternEvidenceBlock[];
+}
+export interface PatternLengthObservation {
+  length: PatternLength;
+  pairs: number;
+  mean: number | null;
+  emission: number;
+  established: boolean;
+  locallyApplicable: boolean;
+}
+export interface PatternJointState {
+  slot: number;
+  phaseSlot: number;
+  phaseIndex: number;
+  length: PatternLength;
+  prefixSeen: 0 | 1;
+  marker: boolean;
+  emission: number;
+  locallyApplicable: boolean;
+  reachable: boolean;
+  canComplete: boolean;
+  qualified: boolean;
+  forward: number | null;
+  backward: number | null;
+  maxMarginal: number | null;
+  predecessorSlot: number | null;
+}
+export interface PatternPhaseProfile {
+  phaseIndex: number;
+  phaseSlot: number | null;
+  anchor: number | null;
+  originalCoverage: number | null;
+  originalSupported: boolean;
+  originalUnknown: boolean;
+  temporalEligible: boolean;
+  reason: 'invalid-period' | 'invalid-window' | 'invalid-phase' | 'original-unknown' | 'original-unsupported' | 'eligible';
+  lengths: PatternLengthObservation[];
+  states: PatternJointState[];
+  maxMarginal: number | null;
+}
+export interface PatternBlockProfile {
+  index: number;
+  time: number;
+  period: number | null;
+  hypothesisIndex: number | null;
+  reason: 'missing-period' | 'missing-hypothesis' | 'invalid-period' | 'invalid-window' | 'no-original-supported-phase' | 'eligible';
+  phases: PatternPhaseProfile[];
+  chainIndex: number | null;
+  qualification: 'no-temporal-phase' | 'no-established-path' | 'qualified';
+  chosenState: number | null;
+  chosenPhaseIndex: number | null;
+  chosenPatternLength: PatternLength | null;
+  chosenPrefixSeen: 0 | 1 | null;
+  chosenAnchor: number | null;
+  chosenObservation: PatternLengthObservation | null;
+  chainScore: number | null;
+  otherScore: number | null;
+  margin: number | null;
+  rawReliability: number;
+  appliedReliability: number;
+}
+export interface PatternChainProfile {
+  index: number;
+  fromBlock: number;
+  toBlock: number;
+  qualified: boolean;
+  chosenLength: PatternLength | null;
+  score: number | null;
+  terminalState: number | null;
+}
+export interface PatternLengthWork {
+  frames: number;
+  blocks: number;
+  originalPhases: number;
+  eligibleBlocks: number;
+  temporalPhases: number;
+  maximumTemporalPhases: number;
+  patternStates: number;
+  flagStates: number;
+  maximumFlagStates: number;
+  chains: number;
+  qualifiedChains: number;
+  unqualifiedChains: number;
+  initializedForwardStates: number;
+  forwardLegalTransitions: number;
+  forwardReachableCandidates: number;
+  backwardLegalTransitions: number;
+  backwardCompletableCandidates: number;
+  maxMarginalComparisons: number;
+  positiveFrames: number;
+  alignmentEvaluations: number;
+  changedFrames: number;
+  typedBytes: number;
+  returnedTypedBytes: number;
+  scratchTypedBytes: number;
+  profileBlocks: number;
+  profilePhases: number;
+  profileLengths: number;
+  profileStates: number;
+  profileChains: number;
+}
+export interface PatternLengthResult {
+  effectiveEnvelope: Float64Array;
+  /** Original phase indices, not dense eligible-state slots; -1 means no qualified path. */
+  path: Int8Array;
+  /** Actual 1/2/4 repetition lengths, constant within each qualified chain. */
+  patternLengths: Int8Array;
+  /** Selected prefix establishment flag, including future-qualified h0 prefixes. */
+  evidenceFlags: Int8Array;
+  /** Local joint slot: lengthIndex*8 + eligiblePhaseSlot*2 + prefixSeen. */
+  statePath: Int8Array;
+  rawReliability: Float64Array;
+  appliedReliability: Float64Array;
+  score: number;
+  blocks: PatternBlockProfile[];
+  chains: PatternChainProfile[];
+  work: PatternLengthWork;
+}
+
+const LENGTHS = [1, 2, 4] as const;
+const EPS = 1e-9, STEP = .01, TOLERANCE = .05, MAX_PHASES = 4, SLOTS = 24;
+const finiteOrNull = (value: number): number | null => Number.isFinite(value) ? value : null;
+const same = (actual: unknown, expected: unknown, name: string): void => {
+  if (!Object.is(actual, expected)) throw Error('Misaligned pattern evidence: ' + name);
+};
+
+/** A pure joint phase/length/establishment DP. It never calls a collector, FFT,
+ * clock or Chart. Collector evidence must correspond to these original blocks. */
+export function applyPatternLength(
+  envelope: Float64Array,
+  input: readonly PatternLengthBlock[],
+  evidence: PatternEvidenceResult,
+): PatternLengthResult {
+  if (!(envelope instanceof Float64Array)) throw Error('Pattern length requires a Float64 envelope');
+  for (const value of envelope) if (!Number.isFinite(value) || value < 0) throw Error('Invalid original pattern envelope');
+  if (!Array.isArray(input as unknown) || !evidence || !Array.isArray(evidence.recurrenceBlocks as unknown)) throw Error('Pattern length requires original blocks and associated evidence');
+  if (evidence.recurrenceBlocks.length !== input.length) throw Error('Pattern evidence block count differs');
+  const n = input.length, effectiveEnvelope = envelope.slice();
+  const counts = new Uint8Array(n), periods = new Float64Array(n), anchors = new Float64Array(n * MAX_PHASES);
+  const coverage = new Float64Array(n * MAX_PHASES), phaseIndices = new Int8Array(n * MAX_PHASES);
+  const emissions = new Float64Array(n * 12), markers = new Uint8Array(n * 12), applicable = new Uint8Array(n * 12);
+  const forward = new Float64Array(n * SLOTS), backward = new Float64Array(n * SLOTS), predecessor = new Int8Array(n * SLOTS);
+  const marginals = new Float64Array(n * MAX_PHASES);
+  const statePath = new Int8Array(n), path = new Int8Array(n), patternLengths = new Int8Array(n), evidenceFlags = new Int8Array(n);
+  const rawReliability = new Float64Array(n), appliedReliability = new Float64Array(n);
