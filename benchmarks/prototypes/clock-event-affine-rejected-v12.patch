+      if (old) work.exactStateMerges++;
+      if (better(state, old)) next.set(k, state);
+      if (next.size > PATH_LIMITS.maximumFrontier) throw Error('EC1 exact frontier budget exceeded');
+    }
+    frontier = [...next.values()];
+    if (!frontier.length) throw Error('EC1 finite path has no legal state');
+    work.maximumFrontier = Math.max(work.maximumFrontier, frontier.length); work.retainedStates += frontier.length;
+    frontiers.push(frontier.length);
+  }
+  let best: State | null = null;
+  for (const state of frontier) if (better(state, best)) best = state;
+  if (!best) throw Error('Missing terminal clock path');
+  const terminal = best, choices: PathChoice[] = [];
+  while (best && best.owner >= 0) {
+    choices.push({ candidateId: best.candidate?.id ?? null, edge: best.edge, loss: best.candidate?.loss ?? 1 });
+    best = best.previous;
+  }
+  choices.reverse();
+  if (choices.length !== owners.length) throw Error('Incomplete clock backtrace');
+  return { choices, loss: terminal.loss, resets: terminal.resets, sourceChanges: terminal.sourceChanges, frontiers, work };
+}
