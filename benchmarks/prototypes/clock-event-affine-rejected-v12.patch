+interface State {
+  readonly owner: number; readonly candidate: PathCandidate | null; readonly cursor: number;
+  readonly lastOrdinal: number | null; readonly lastTarget: number; readonly loss: number;
+  readonly resets: number; readonly sourceChanges: number; readonly rank: number;
+  readonly previous: State | null; readonly edge: PathEdge;
+}
+export const PATH_LIMITS = Object.freeze({ maximumFrontier: 8192, maximumEdges: 100000000,
+  maximumOwners: 150, maximumCandidatesPerOwner: 4096, maximumAbsOrdinal: 2147482624,
+  unknownTransitionCost: 1, resetCost: 1 });
+
+function better(a: State, b: State | null): boolean {
+  if (!b) return true;
+  if (a.loss < b.loss) return true;
+  if (a.loss > b.loss) return false;
+  return a.resets < b.resets || a.resets === b.resets && (a.sourceChanges < b.sourceChanges
+    || a.sourceChanges === b.sourceChanges && a.rank < b.rank);
+}
+function key(state: State): string {
+  return JSON.stringify([state.candidate?.id ?? null, state.cursor, state.lastOrdinal, state.lastTarget]);
+}
+
+/** Exact dynamic programming over the supplied finite local clocks. All timing
