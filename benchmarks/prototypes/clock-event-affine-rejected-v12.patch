+  readonly roleBindings: readonly RoleBinding[]; readonly geometry: readonly GeometryTarget[];
+  readonly knownSegments: readonly KnownSegment[]; readonly unknownIntervals: readonly UnknownInterval[];
+  readonly owners: readonly OwnerSummary[]; readonly changes: readonly ClockChange[]; readonly work: ClockWork;
+  readonly pathObjective: { readonly loss: number; readonly resets: number; readonly sourceChanges: number };
