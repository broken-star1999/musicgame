+  readonly ownerBindings: readonly AffineBinding[];
+  readonly fitCounts: AffineDomainCounts;
+  readonly ownerCounts: AffineDomainCounts;
+  readonly fitLoss: AffineLoss;
+  readonly ownerLoss: AffineLoss;
+  readonly eligible: boolean;
+  readonly reason: string;
