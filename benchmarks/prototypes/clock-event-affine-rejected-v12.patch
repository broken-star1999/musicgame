+      || owner.candidates.length > PATH_LIMITS.maximumCandidatesPerOwner) throw Error('Invalid owner/candidate boundary');
+    previousTo = owner.to;
+    for (const c of owner.candidates) {
+      if (typeof c.id !== 'string' || !c.id || ids.has(c.id) || !Number.isFinite(c.period) || c.period < .27 || c.period > 1.2
+        || !Number.isFinite(c.anchor) || !Number.isFinite(c.loss) || c.loss < 0 || !Number.isSafeInteger(c.rank) || c.rank < 0
+        || !Number.isSafeInteger(c.pivotOrdinal) || Math.abs(c.pivotOrdinal) > PATH_LIMITS.maximumAbsOrdinal || !Number.isFinite(c.pivotTime)
+        || !Number.isInteger(c.source) || c.source < 0 || c.source > 3 || !Array.isArray(c.heads)) throw Error('Invalid immutable clock candidate');
