+        loss: prior.loss + emission + cost,
+        resets: prior.resets + Number(reset && prior.owner >= 0),
+        sourceChanges: prior.sourceChanges + Number(!!current && !!prior.candidate && current.source !== prior.candidate.source),
+        rank: prior.rank + (current?.rank ?? 0), previous: prior,
+        edge: { shift, reset, phaseDistance, cost } };
