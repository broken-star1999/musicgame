+export interface PathHead { readonly eventId: number; readonly time: number; readonly targetTime: number; readonly localOrdinal: number }
+export interface PathCandidate {
+  readonly id: string; readonly period: number; readonly anchor: number; readonly source: SourceId;
+  readonly pivotOrdinal: number; readonly pivotTime: number;
+  readonly loss: number; readonly rank: number; readonly heads: readonly PathHead[];
+}
+export interface PathOwner { readonly from: number; readonly to: number; readonly candidates: readonly PathCandidate[] }
+export interface PathEdge { readonly shift: number; readonly reset: boolean; readonly phaseDistance: number; readonly cost: number }
+export interface PathChoice { readonly candidateId: string | null; readonly edge: PathEdge; readonly loss: number }
