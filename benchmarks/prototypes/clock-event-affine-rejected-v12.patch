+ * full clock identity and every past value used by a future legality check.
+ * Resource exhaustion throws; no beam or quality-dependent fallback is hidden.
+ */
+export function chooseClockPath(owners: readonly PathOwner[]): PathResult {
+  if (!Array.isArray(owners) || !owners.length || owners.length > PATH_LIMITS.maximumOwners) throw Error('Invalid finite path owners');
