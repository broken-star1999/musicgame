+  proposals: number; finiteProposals: number; fitCalls: number; eligibleCandidates: number;
+  edgeTrials: number; validEdges: number; exactStateMerges: number; maximumFrontier: number;
+  retainedStates: number; geometryRestTargets: number; selectedHeads: number; selectedBindings: number;
