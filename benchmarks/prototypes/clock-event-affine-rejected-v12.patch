+export interface InputBlock { readonly time: number; readonly from: number; readonly to: number; readonly preferredPeriod?: number | null; readonly hypotheses: readonly PeriodProposal[] }
+export interface PhysicalIdentity { readonly id: number; readonly time: number }
+export interface ClockInput {
+  readonly duration: number;
+  readonly streams: readonly (readonly SourceEvent[])[];
+  readonly physical: readonly PhysicalIdentity[];
+  readonly blocks: readonly InputBlock[];
+  readonly progress?: (owner: number, total: number) => void;
+}
+export interface ClockHead {
+  readonly eventId: number; readonly time: number; readonly targetTime: number;
+  readonly ordinal: number; readonly chain: number; readonly period: number;
+  readonly source: SourceId; readonly sourceMemberIndex: number; readonly compatibility: number;
+  readonly blockIndex: number; readonly candidateId: string; readonly localOrdinal: number;
+}
+export interface RoleBinding {
+  readonly eventId: number; readonly time: number; readonly source: SourceId; readonly sourceMemberIndex: number;
+  readonly denominator: 1 | 2 | 3 | 4; readonly compatibility: number; readonly fraction: number;
+  readonly primary: boolean; readonly localOrdinal: number; readonly candidateId: string; readonly blockIndex: number;
+}
+export interface GeometryTarget {
