+        if (last) { cursor = last.eventId; lastTarget = last.targetTime; lastOrdinal = last.localOrdinal; }
+        if (lastOrdinal !== null && (!Number.isSafeInteger(lastOrdinal) || Math.abs(lastOrdinal) > PATH_LIMITS.maximumAbsOrdinal))
