+    loss: 0, resets: 0, sourceChanges: 0, rank: 0, previous: null, edge: { shift: 0, reset: true, phaseDistance: 0, cost: 0 } }];
+  for (let ownerIndex = 0; ownerIndex < owners.length; ownerIndex++) {
+    const owner = owners[ownerIndex], next = new Map<string, State>();
+    const choices: readonly (PathCandidate | null)[] = [...owner.candidates, null];
+    for (const current of choices) for (const prior of frontier) {
+      if (++work.edgeTrials > PATH_LIMITS.maximumEdges) throw Error('EC1 path edge budget exceeded');
+      let shift = 0, reset = false, phaseDistance = 0, cost = 0;
+      let cursor = prior.cursor, lastTarget = prior.lastTarget, lastOrdinal: number | null = null;
+      if (current) {
+        if (prior.candidate) {
+          const fractionalDelta = (owner.from - prior.candidate.pivotTime) / prior.candidate.period - (owner.from - current.pivotTime) / current.period;
+          const rounded = Math.round(fractionalDelta);
+          shift = prior.candidate.pivotOrdinal - current.pivotOrdinal + rounded;
+          phaseDistance = Math.abs(fractionalDelta - rounded);
+          if (!Number.isSafeInteger(shift) || Math.abs(shift) > PATH_LIMITS.maximumAbsOrdinal || !Number.isFinite(phaseDistance))
+            throw Error('Unsafe phase composition');
+          cost = Math.abs(Math.log(current.period / prior.candidate.period)) + 4 * phaseDistance;
+          reset = phaseDistance > .25;
+          if (reset) cost += PATH_LIMITS.resetCost;
+          else if (prior.lastOrdinal !== null) lastOrdinal = prior.lastOrdinal - shift;
