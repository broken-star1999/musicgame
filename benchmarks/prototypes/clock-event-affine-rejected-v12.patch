+  readonly source: SourceId; readonly eventId: number | null; readonly blockIndex: number;
+  readonly kind: 'observed' | 'interpolated-rest';
+}
+export interface KnownSegment { readonly from: number; readonly to: number; readonly chain: number; readonly period: number; readonly source: SourceId }
+export interface UnknownInterval { readonly from: number; readonly to: number; readonly reason: string; readonly blockIndex: number }
+export interface ClockChange {
+  readonly kind: 'tempo-update' | 'phase-reset' | 'source-relay'; readonly from: number;
+  readonly beforePeriod: number; readonly afterPeriod: number; readonly beforeSource: SourceId; readonly afterSource: SourceId;
+  readonly phaseDistance: number;
+}
+export interface OwnerSummary {
+  readonly blockIndex: number; readonly from: number; readonly to: number; readonly inputBlockIndex: number | null;
+  readonly fitCandidates: number; readonly eligibleCandidates: number; readonly frontier: number;
+  readonly selectedId: string | null; readonly selectedLoss: number; readonly source: SourceId | null;
+  readonly period: number | null; readonly heads: number; readonly roleBindings: number;
+  readonly transition: { readonly shift: number; readonly reset: boolean; readonly phaseDistance: number; readonly cost: number } | null;
+}
+export interface ClockWork {
