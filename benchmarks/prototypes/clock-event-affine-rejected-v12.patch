+/** EC1 source-specific alternating affine fit. Static preparation only until
+ * ROOT's independent mathematical freeze. No audio, FFT, GT or old clock path. */
+export type AffineSourceId = 0 | 1 | 2 | 3;
+export interface AffineSourceEvent {
+  readonly time: number;
+  readonly strength?: number;
+  readonly boundary?: boolean;
+  /** Original member index, if supplied; otherwise the original array index. */
+  readonly index?: number;
+}
+export interface FitSourceClockInput {
+  readonly duration: number;
+  readonly events: readonly AffineSourceEvent[];
+  readonly period: number;
+  readonly anchor: number;
+  readonly from: number;
+  readonly to: number;
+  readonly ownerFrom: number;
+  readonly ownerTo: number;
+  readonly source: AffineSourceId;
+}
+export interface AffineClock {
+  readonly period: number;
+  /** Conventional n=0 anchor, supplied for external phase comparison. */
+  readonly anchor: number;
+  /** Actual stable evaluation is pivotTime+(n-pivotOrdinal)*period. */
+  readonly pivotOrdinal: number;
+  readonly pivotTime: number;
+  readonly tolerance: number;
+  readonly subdivisionTolerance: number;
+}
+export interface AffinePrimaryTarget {
+  readonly localOrdinal: number;
+  readonly virtualTime: number;
+  readonly sourceMemberIndex: number | null;
+  readonly actualTime: number | null;
+  readonly residual: number | null;
+  readonly compatibility: number | null;
+  readonly inFitWindow: boolean;
+  readonly fitOpportunity: boolean;
+  readonly targetInOwner: boolean;
+  readonly ownerOpportunity: boolean;
+  readonly recordingUncensored: boolean;
+}
+export interface AffineBinding {
+  readonly source: AffineSourceId;
+  readonly sourceMemberIndex: number;
+  readonly time: number;
+  readonly targetTime: number;
+  readonly denominator: 1 | 2 | 3 | 4;
+  readonly compatibility: number;
+  readonly localOrdinal: number;
+  readonly fraction: number;
+  readonly primary: boolean;
+}
+export interface AffineDomainCounts {
+  readonly rawMembers: number;
+  readonly sourceCues: number;
+  readonly duplicateMembers: number;
+  readonly primaryOpportunities: number;
+  readonly matchedPrimaryOpportunities: number;
+  readonly coverage: number | null;
+  readonly matchedPrimarySpan: number;
+  readonly explainedCues: number;
+  readonly unexplainedCues: number;
+  readonly primaryBindings: number;
+  readonly subdivisionBindings: number;
+}
+export interface AffineLoss {
+  readonly missingPrimaryFraction: number;
+  readonly unexplainedSourceFraction: number;
+  readonly meanPrimaryNormalizedResidual: number;
+  readonly total: number;
+  /** Fit total is unscaled; owner total is additionally scaled by width/2. */
+  readonly scaledTotal: number;
+}
+export interface AffineFitTrial {
+  readonly iteration: number;
+  readonly clock: AffineClock;
+  readonly eligible: boolean;
+  readonly reason: string;
+  readonly counts: AffineDomainCounts;
+  readonly loss: AffineLoss;
+  readonly primaryTargets: readonly AffinePrimaryTarget[];
+  readonly olsFromIteration: number | null;
+  readonly unconstrainedPeriod: number | null;
+  readonly periodClamped: boolean;
+}
+export interface AffineClockWork {
+  inputReads: number;
+  boundaryMembersExcluded: number;
+  regularMembers: number;
+  uniqueCues: number;
+  duplicateMembers: number;
+  evaluations: number;
+  leastSquaresProposals: number;
+  leastSquaresPointReads: number;
+  leastSquaresDegenerate: number;
+  leastSquaresClamped: number;
+  repeatedClockStops: number;
+  primaryTargetRecords: number;
+  subdivisionSlotRecords: number;
+  nearestQueries: number;
+  binaryComparisons: number;
+  distanceComparisons: number;
+  assignedPrimaryCues: number;
+  assignedSubdivisionCues: number;
+  domainCueReads: number;
+  domainMemberReads: number;
+  bindingsCreated: number;
+  trialRecords: number;
+  maximumPrimaryRecords: number;
+  maximumSubdivisionRecords: number;
+  explicitTypedBytes: 0;
+}
+export interface FitSourceClockResult {
+  readonly version: 'EC1-source-affine/v1';
+  readonly source: AffineSourceId;
+  readonly duration: number;
+  readonly from: number;
+  readonly to: number;
+  readonly ownerFrom: number;
+  readonly ownerTo: number;
+  readonly eligible: boolean;
+  readonly reason: string;
+  readonly period: number;
+  readonly anchor: number;
+  readonly clock: AffineClock;
+  readonly primaryTargets: readonly AffinePrimaryTarget[];
+  /** All bound cues with actual time in [from,to). */
+  readonly fitBindings: readonly AffineBinding[];
+  /** All bound cues with actual time in [ownerFrom,ownerTo), including halos. */
+  readonly ownerBindings: readonly AffineBinding[];
+  readonly fitCounts: AffineDomainCounts;
+  readonly ownerCounts: AffineDomainCounts;
+  readonly fitLoss: AffineLoss;
+  readonly ownerLoss: AffineLoss;
+  readonly trials: readonly AffineFitTrial[];
+  readonly selectedIteration: number;
+  readonly stopReason: 'maximum-updates' | 'degenerate-least-squares' | 'repeated-clock';
