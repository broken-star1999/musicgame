+    leastSquaresClamped: 0, repeatedClockStops: 0, primaryTargetRecords: 0, subdivisionSlotRecords: 0,
+    nearestQueries: 0, binaryComparisons: 0, distanceComparisons: 0, assignedPrimaryCues: 0,
+    assignedSubdivisionCues: 0, domainCueReads: 0, domainMemberReads: 0, bindingsCreated: 0,
+    trialRecords: 0, maximumPrimaryRecords: 0, maximumSubdivisionRecords: 0, explicitTypedBytes: 0 };
+}
+function validOrdinal(value: number): void {
+  if (!Number.isSafeInteger(value) || Math.abs(value) > AFFINE_CLOCK_LIMITS.maximumAbsOrdinal) throw Error('Unsafe affine target ordinal');
