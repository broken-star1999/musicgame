index 0000000..0ff694e
--- /dev/null
+++ b/src/core/event-clock-salience.ts
@@ -0,0 +1,169 @@
+import type { Analysis, Difficulty, Onset } from '../types';
+
+export const SALIENCE_VERSION = 'baseline-canonical-first/v1' as const;
+const MODES = ['one', 'two', 'three', 'four'] as const;
+const SPECS = Object.freeze({
+  one: Object.freeze({ max: 1, threshold: .23 }),
+  two: Object.freeze({ max: 2, threshold: .16 }),
+  three: Object.freeze({ max: 3, threshold: .105 }),
+  four: Object.freeze({ max: 4, threshold: .055 }),
+});
+
+export interface SalienceOrigin {
+  readonly kind: 'baseline-canonical' | 'raw-member-max';
+  readonly baseIndex: number | null;
+  /** Arrangement representative only; never a selected clock-source witness. */
+  readonly source: 0 | 1 | 2 | 3 | null;
+  readonly memberIndex: number | null;
+}
+export interface SalienceDomain {
+  readonly mode: Difficulty;
+  readonly basis: 'baseline-pulse' | 'baseline-onsets';
+  /** Frozen OLD automatic-role membership, before new bindings/manual rebind. */
+  readonly baseIndices: readonly number[];
+  readonly count: number;
+  readonly q75: number | null;
+  readonly threshold: number;
+}
+export interface SaliencePreparation {
+  readonly version: typeof SALIENCE_VERSION;
+  readonly fingerprint: string;
+  readonly duration: number;
+  readonly byTime: ReadonlyMap<number, Readonly<Onset>>;
+  readonly originsByTime: ReadonlyMap<number, SalienceOrigin>;
+  readonly basePool: readonly Readonly<Onset>[];
+  readonly domains: Readonly<Record<Difficulty, SalienceDomain>>;
+  readonly thresholds: Readonly<Record<Difficulty, number>>;
+  readonly regularFrames: number;
+  readonly originalMembers: number;
+  readonly excludedBoundaryMembers: number;
+}
+/** Small structured-clone-safe context, carried even for wholly unknown clocks. */
+export interface ArrangementSalience {
+  readonly version: typeof SALIENCE_VERSION;
+  readonly fingerprint: string;
+  readonly duration: number;
+  readonly domains: Readonly<Record<Difficulty, { readonly count: number; readonly q75: number | null; readonly threshold: number }>>;
+}
+
+export function compactSalience(prepared: SaliencePreparation): ArrangementSalience {
+  const domains = {} as Record<Difficulty, { readonly count: number; readonly q75: number | null; readonly threshold: number }>;
+  for (const mode of MODES) {
+    const value = prepared.domains[mode];
+    domains[mode] = Object.freeze({ count: value.count, q75: value.q75, threshold: value.threshold });
+  }
+  return Object.freeze({ version: SALIENCE_VERSION, fingerprint: prepared.fingerprint, duration: prepared.duration, domains: Object.freeze(domains) });
+}
+
+/** Auto AND manual use the same pre-bridge domain after worker transport. An
+ * absent field means original B behavior; a malformed present field is an error.
+ */
+export function fixedSalienceThreshold(analysis: Pick<Analysis, 'duration' | 'fingerprint'> & { arrangementSalience?: ArrangementSalience }, mode: Difficulty,
+  legacyThreshold: number): number {
+  const value = analysis.arrangementSalience;
+  if (value === undefined) return legacyThreshold;
+  if (value.version !== SALIENCE_VERSION || value.fingerprint !== analysis.fingerprint || value.duration !== analysis.duration || !value.domains)
+    throw Error('Arrangement salience belongs to a different input/version');
+  for (const difficulty of MODES) {
+    const domain = value.domains[difficulty], cap = SPECS[difficulty].threshold;
+    if (!domain || !Number.isSafeInteger(domain.count) || domain.count < 0
+      || domain.q75 !== null && (!Number.isFinite(domain.q75) || domain.q75 < 0)
+      || (domain.count === 0) !== (domain.q75 === null)
+      || domain.threshold !== Math.min(cap, (domain.q75 || cap) * .55)) throw Error('Invalid fixed arrangement salience domain');
+  }
+  return value.domains[mode].threshold;
+}
+
+/** Read-only lookup facade: callbacks do not expose the mutable backing Map. */
+class FixedIndex<K, V> implements ReadonlyMap<K, V> {
+  readonly #map: Map<K, V>;
+  constructor(entries: Iterable<readonly [K, V]>) { this.#map = new Map(entries); Object.freeze(this); }
+  get size(): number { return this.#map.size; }
+  get(key: K): V | undefined { return this.#map.get(key); }
+  has(key: K): boolean { return this.#map.has(key); }
+  keys() { return this.#map.keys(); }
+  values() { return this.#map.values(); }
+  entries() { return this.#map.entries(); }
+  [Symbol.iterator]() { return this.#map[Symbol.iterator](); }
+  forEach(callback: (value: V, key: K, map: ReadonlyMap<K, V>) => void, thisArg?: unknown): void {
+    for (const [key, value] of this.#map) callback.call(thisArg, value, key, this);
+  }
+}
+
+function validEvent(event: Onset, duration: number): void {
+  if (!event || !Number.isFinite(event.time) || event.time < 0 || event.time >= duration
+    || !Number.isFinite(event.strength) || event.strength < 0
+    || !Number.isSafeInteger(event.band) || event.band < 0 || event.band > 2)
+    throw Error('Invalid physical/canonical salience event');
+}
+function oldRoleEligible(event: Onset, maximum: number): boolean {
+  return !event.role || event.role === 'beat' || maximum >= 2 && event.role === 'half'
+    || maximum >= 3 && event.role === 'quarter' || maximum === 4;
+}
+
+/** Prepare once BEFORE any new clock/source/role decision. No score, target,
+ * new role, BPM override, genre or quality result is an input to this function.
+ * Old physical frames retain the canonical arrangement strength/band; new frame
+ * times get the greatest original regular member strength with fixed source/index
+ * ties. All original source evidence remains separately owned by the caller.
+ */
+export function prepareSalience(baseline: Analysis, streams: readonly (readonly Onset[])[]): SaliencePreparation {
+  if (!baseline || !Number.isFinite(baseline.duration) || baseline.duration <= 0
+    || !Array.isArray(streams) || streams.length !== 4) throw Error('Baseline and four original streams are required');
+  const duration = baseline.duration;
+  const maxima = new Map<number, { event: Onset; source: 0 | 1 | 2 | 3; memberIndex: number }>();
+  let originalMembers = 0, excludedBoundaryMembers = 0;
+  streams.forEach((stream, sourceIndex) => {
+    if (!Array.isArray(stream)) throw Error('Original source stream must be an array');
+    let previous = -Infinity;
+    stream.forEach((event, memberIndex) => {
+      validEvent(event, duration);
+      if (event.time < previous) throw Error('Original source times must be ordered');
+      previous = event.time;
+      if (event.boundary) { excludedBoundaryMembers++; return; }
+      originalMembers++;
+      const old = maxima.get(event.time);
+      // Traversal is source0..3 then original member index; strict > therefore
+      // keeps the earliest source/index when raw strengths are exactly equal.
+      if (!old || event.strength > old.event.strength)
+        maxima.set(event.time, { event, source: sourceIndex as 0 | 1 | 2 | 3, memberIndex });
+    });
+  });
+  const base = baseline.pulse?.onsets ?? baseline.onsets;
+  if (!Array.isArray(base)) throw Error('Canonical baseline pool must be an array');
+  const canonical = new Map<number, Readonly<Onset>>(), origins = new Map<number, SalienceOrigin>();
+  const basePool: Readonly<Onset>[] = [];
+  let previousBase = -Infinity;
+  base.forEach((event, baseIndex) => {
+    validEvent(event, duration);
+    if (event.time < previousBase || canonical.has(event.time)) throw Error('Canonical baseline times must be ordered and unique');
+    previousBase = event.time;
+    // A new third-role overlay is not an acceptable pre-bridge baseline.
+    if (event.role !== undefined && !['beat', 'half', 'quarter', 'free'].includes(event.role)) throw Error('Expected original baseline roles');
+    if (!event.boundary && !maxima.has(event.time)) throw Error('Baseline regular onset lacks an original physical member');
+    const copy = Object.freeze({ ...event }); basePool.push(copy); canonical.set(copy.time, copy);
+    origins.set(copy.time, Object.freeze({ kind: 'baseline-canonical', baseIndex, source: null, memberIndex: null }));
+  });
+  for (const [time, winner] of maxima) if (!canonical.has(time)) {
+    const copy = { ...winner.event }; delete copy.role; delete copy.boundary;
+    canonical.set(time, Object.freeze(copy));
+    origins.set(time, Object.freeze({ kind: 'raw-member-max', baseIndex: null, source: winner.source, memberIndex: winner.memberIndex }));
+  }
+  const domains = {} as Record<Difficulty, SalienceDomain>, thresholds = {} as Record<Difficulty, number>;
+  for (const mode of MODES) {
+    const spec = SPECS[mode], baseIndices: number[] = [];
+    basePool.forEach((event, index) => { if (oldRoleEligible(event, spec.max)) baseIndices.push(index); });
+    const sorted = baseIndices.map(index => basePool[index].strength).sort((a, b) => a - b);
+    const value = sorted[Math.floor(sorted.length * .75)];
+    // Preserve the ORIGINAL zero/empty fallback and arithmetic grouping exactly.
+    const threshold = Math.min(spec.threshold, (value || spec.threshold) * .55);
+    domains[mode] = Object.freeze({ mode, basis: baseline.pulse ? 'baseline-pulse' : 'baseline-onsets',
+      baseIndices: Object.freeze(baseIndices), count: baseIndices.length, q75: value ?? null, threshold });
+    thresholds[mode] = threshold;
+  }
+  const ordered = [...canonical.entries()].sort((a, b) => a[0] - b[0]);
+  return Object.freeze({ version: SALIENCE_VERSION, fingerprint: baseline.fingerprint, duration,
+    byTime: new FixedIndex(ordered), originsByTime: new FixedIndex(ordered.map(([time]) => [time, origins.get(time)!] as const)),
+    basePool: Object.freeze(basePool), domains: Object.freeze(domains), thresholds: Object.freeze(thresholds),
+    regularFrames: maxima.size, originalMembers, excludedBoundaryMembers });
+}
