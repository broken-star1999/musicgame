+    const pivotTime = timeAtOrigin + (pivotOrdinal - originN) * period;
+    const clock = clockOf(period, pivotOrdinal, pivotTime, pivotTime - pivotOrdinal * period);
+    const signature = JSON.stringify([clock.period, clock.pivotOrdinal, clock.pivotTime]);
+    if (seen.has(signature)) { work.repeatedClockStops++; stopReason = 'repeated-clock'; break; }
+    seen.add(signature);
+    const value = evaluate(clock); evaluations.push(value);
+    trials.push({ iteration, clock, eligible: value.eligible, reason: value.reason, counts: value.fitCounts, loss: value.fitLoss,
+      primaryTargets: value.primaryTargets, olsFromIteration: iteration - 1, unconstrainedPeriod, periodClamped }); work.trialRecords++;
+  }
+  let best = 0;
+  for (let i = 1; i < evaluations.length; i++) {
+    const value = evaluations[i], old = evaluations[best];
+    if (value.eligible && !old.eligible || value.eligible === old.eligible && value.fitLoss.total < old.fitLoss.total) best = i;
+  }
+  const value = evaluations[best];
+  return { version: 'EC1-source-affine/v1', source: input.source, duration: input.duration,
+    from: input.from, to: input.to, ownerFrom: input.ownerFrom, ownerTo: input.ownerTo, eligible: value.eligible, reason: value.reason,
+    period: value.clock.period, anchor: value.clock.anchor, clock: value.clock, primaryTargets: value.primaryTargets,
+    fitBindings: value.fitBindings, ownerBindings: value.ownerBindings, fitCounts: value.fitCounts, ownerCounts: value.ownerCounts,
+    fitLoss: value.fitLoss, ownerLoss: value.ownerLoss, trials, selectedIteration: trials[best].iteration, stopReason, work };
+}
