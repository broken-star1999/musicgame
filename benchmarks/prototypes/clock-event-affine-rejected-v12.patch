+/** Finite role evidence plus immutable chart salience; no source amplitude term. */
+export function selectEventClockOnsets(onsets: readonly EventClockOnset[], gap: number, threshold: number,
+  timing: (onset: EventClockOnset) => number, metadata: EventClockMetadata): EventClockOnset[] {
+  const evidence = new Map(metadata.roleEvidence.map(value => [value.time, value]));
+  const events = onsets.filter(onset => onset.strength >= threshold || onset.role === 'beat').slice().sort((a, b) => a.time - b.time);
+  const times = events.map(timing), scores = new Float64Array(events.length + 1), previous = new Int32Array(events.length), take = new Uint8Array(events.length);
+  for (let i = 0; i < events.length; i++) {
+    let low = 0, high = i;
+    while (low < high) { const middle = (low + high) >>> 1; if (times[i] - times[middle] >= gap - 1e-6) low = middle + 1; else high = middle; }
+    previous[i] = low;
+    const observation = evidence.get(events[i].time), roleValue = observation ? observation.compatibility / observation.denominator : 0;
+    const value = scores[low] + events[i].strength ** 2 + .005 + roleValue, choose = value > scores[i] + 1e-10;
+    scores[i + 1] = choose ? value : scores[i]; take[i] = Number(choose);
+  }
+  const selected: EventClockOnset[] = [];
+  for (let i = events.length - 1; i >= 0;) { if (take[i]) { selected.push(events[i]); i = previous[i] - 1; } else i--; }
+  return selected.reverse();
+}
