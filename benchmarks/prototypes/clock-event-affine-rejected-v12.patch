+++ b/src/core/rational-application.ts
@@ -0,0 +1,203 @@
+import type { Analysis, Onset, Rhythm, RhythmSection } from '../types';
+import type { ClockInput, ClockResult, RoleBinding } from './event-clock-contracts';
+import { readoutEventClock } from './event-clock-readout';
+import { compactSalience, prepareSalience, type ArrangementSalience, type SaliencePreparation } from './event-clock-salience';
+
+export type EventClockRole = 'beat' | 'half' | 'third' | 'quarter' | 'free';
+export interface EventClockOnset extends Omit<Onset, 'role'> { role?: EventClockRole }
+export interface EventClockEvidence {
+  time: number; eventId: number; denominator: 1 | 2 | 3 | 4; fraction: number; compatibility: number;
+  source: 0 | 1 | 2 | 3; sourceMemberIndex: number; sourceStrength: number; sourceBand: number;
+  candidateId: string; localOrdinal: number;
+}
+export interface EventClockMetadata {
+  version: 'EC1-affine/v1';
+  primaryHeads: { time: number; targetTime: number; ordinal: number; chain: number; period: number }[];
+  roleEvidence: EventClockEvidence[];
+  unknownIntervals: { from: number; to: number }[];
+  knownSegments: number; sourceFrames: number; assignments: number;
+}
+export interface EventClockAnalysis extends Omit<Analysis, 'pulse' | 'rhythm'> {
+  pulse?: { onsets: EventClockOnset[]; sections: RhythmSection[] };
+  rhythm?: Rhythm & { method?: 'EC1-affine/v1' };
+  eventClock?: EventClockMetadata;
+  arrangementSalience: ArrangementSalience;
+}
+export interface EventClockContext {
+  readonly streams: readonly (readonly Onset[])[];
+  readonly blocks: ClockInput['blocks'];
+  readonly sampleRate: number;
+}
+export interface EventClockMember { readonly source: 0 | 1 | 2 | 3; readonly index: number; readonly time: number; readonly strength: number }
+export interface EventClockBundle { readonly id: number; readonly time: number; readonly strength: number; readonly sourceMask: number; readonly members: readonly EventClockMember[] }
+export interface EventClockBundlePreparation {
+  readonly events: readonly EventClockBundle[]; readonly representatives: readonly Onset[];
+  readonly memberCount: number; readonly boundaryMembersExcluded: number;
+}
+
+/** Exact union for physical identity only. Max salience does not select clocks. */
+export function prepareEventClockBundles(streams: readonly (readonly Onset[])[], duration: number): EventClockBundlePreparation {
+  if (!Array.isArray(streams) || streams.length !== 4 || !Number.isFinite(duration) || duration <= 0)
+    throw Error('Four original streams and finite duration are required');
+  const groups = new Map<number, { members: EventClockMember[]; representative: Onset }>();
+  let memberCount = 0, boundaryMembersExcluded = 0;
+  streams.forEach((stream, sourceIndex) => {
+    if (!Array.isArray(stream)) throw Error('Original source must be an array');
+    let previous = -Infinity;
+    stream.forEach((event, index) => {
+      if (!event || !Number.isFinite(event.time) || event.time < 0 || event.time >= duration || event.time < previous
+        || !Number.isFinite(event.strength) || event.strength < 0 || !Number.isSafeInteger(event.band) || event.band < 0 || event.band > 2)
+        throw Error('Invalid original physical member');
+      previous = event.time;
+      if (event.boundary) { boundaryMembersExcluded++; return; }
+      const member: EventClockMember = { source: sourceIndex as 0 | 1 | 2 | 3, index, time: event.time, strength: event.strength };
+      const copy = { ...event }; delete copy.role;
+      const old = groups.get(event.time);
+      if (!old) groups.set(event.time, { members: [member], representative: copy });
+      else { old.members.push(member); if (copy.strength > old.representative.strength) old.representative = copy; }
+      memberCount++;
+    });
+  });
+  const representatives: Onset[] = [];
+  const events = [...groups].sort((a, b) => a[0] - b[0]).map(([time, group], id): EventClockBundle => {
+    let sourceMask = 0, strength = 0;
+    for (const member of group.members) { sourceMask |= 1 << member.source; strength = Math.max(strength, Math.min(1, member.strength)); }
+    representatives.push({ ...group.representative });
+    return { id, time, strength, sourceMask, members: group.members };
+  });
+  return { events, representatives, memberCount, boundaryMembersExcluded };
+}
+
+export function eventClockNoteTime(onset: EventClockOnset, metadata: EventClockMetadata | undefined, bpmOverride: number | undefined,
+  legacyTiming: (onset: EventClockOnset) => number): number {
+  return metadata && bpmOverride === undefined ? onset.time : legacyTiming(onset);
+}
+export function eventClockSingleFingerEvents(events: readonly EventClockOnset[], metadata: EventClockMetadata, gap: number): EventClockOnset[] {
+  const heads = new Map(metadata.primaryHeads.map(head => [head.time, head]));
+  return events.filter(event => {
+    const head = event.role === 'beat' ? heads.get(event.time) : undefined;
+    return !head || head.ordinal % Math.max(1, Math.ceil((gap - 1e-6) / head.period)) === 0;
+  });
+}
+function tempoFrom(beats: readonly number[]): { time: number; bpm: number }[] {
+  return beats.slice(1).map((time, i) => {
+    const from = Math.max(0, i - 1), to = Math.min(beats.length - 1, i + 2);
+    return { time, bpm: Math.round(60 * (to - from) / (beats[to] - beats[from]) * 10) / 10 };
+  });
+}
+function bindingRole(binding: RoleBinding): Exclude<EventClockRole, 'free'> {
+  const allowed = binding.denominator === 1 ? [0] : binding.denominator === 2 ? [.5]
+    : binding.denominator === 3 ? [1 / 3, 2 / 3] : binding.denominator === 4 ? [.25, .75] : [];
+  if (!allowed.includes(binding.fraction) || binding.primary !== (binding.denominator === 1)) throw Error('Invalid selected role binding');
+  return binding.denominator === 1 ? 'beat' : binding.denominator === 2 ? 'half' : binding.denominator === 3 ? 'third' : 'quarter';
+}
+
+/** One real readout, then direct materialization. No second fit or role binder. */
+export function applyEventClockAnalysis(baseline: Analysis, context: EventClockContext,
+  progress?: (fraction: number, stage: string) => void): {
+    analysis: EventClockAnalysis; readout: ClockResult; bundles: EventClockBundlePreparation; salience: SaliencePreparation;
+  } {
+  if (!Number.isFinite(context.sampleRate) || context.sampleRate <= 0) throw Error('Invalid original sample rate');
+  const salience = prepareSalience(baseline, context.streams);
+  const bundles = prepareEventClockBundles(context.streams, baseline.duration);
+  const readout = readoutEventClock({ duration: baseline.duration, streams: context.streams, physical: bundles.events, blocks: context.blocks,
+    progress: (owner, total) => progress?.((owner + 1) / Math.max(1, total), '正在对齐真实起音与局部节拍') });
+  return { analysis: overlayEventClockAnalysis(baseline, context, readout, bundles, salience), readout, bundles, salience };
+}
+
+/** Actual pure materialization seam used by apply; fixtures do not invoke the clock. */
+export function overlayEventClockAnalysis(baseline: Analysis, context: EventClockContext, readout: ClockResult,
+  bundles: EventClockBundlePreparation, salience: SaliencePreparation): EventClockAnalysis {
+  if (salience.fingerprint !== baseline.fingerprint || salience.duration !== baseline.duration) throw Error('Salience input identity differs');
+  const arrangementSalience = compactSalience(salience);
+  if (readout.version !== 'EC1-affine/v1' || readout.duration !== baseline.duration) throw Error('Unexpected EC1 result identity');
+  const unknown = readout.unknownIntervals.map(interval => ({ from: interval.from, to: interval.to }));
+  let covered = 0, previousTo = -Infinity;
+  for (const interval of unknown) {
+    if (!Number.isFinite(interval.from) || !Number.isFinite(interval.to) || interval.from < 0 || interval.to > baseline.duration
+      || interval.to <= interval.from || interval.from < previousTo) throw Error('Invalid EC1 unknown interval');
+    if (interval.from <= covered) covered = interval.to;
+    previousTo = interval.to;
+  }
+  if (!readout.heads.length && !readout.knownSegments.length && covered === baseline.duration) {
+    if (readout.roleBindings.length || readout.geometry.length || readout.primaryIds.length) throw Error('Wholly unknown output contains selected evidence');
+    return { ...baseline, arrangementSalience };
+  }
+  if (readout.heads.length < 2 || !readout.knownSegments.length || readout.geometry.length < 2)
+    throw Error('局部节拍拟合没有建立足够的真实起点，请更换节奏更清楚的音乐。');
+  const isUnknown = (time: number): boolean => unknown.some(interval => time >= interval.from && time < interval.to);
+  previousTo = -Infinity;
+  for (const segment of readout.knownSegments) {
+    if (!Number.isFinite(segment.from) || !Number.isFinite(segment.to) || segment.from < 0 || segment.to > baseline.duration
+      || segment.to <= segment.from || segment.from < previousTo || !Number.isFinite(segment.period) || segment.period <= 0
+      || !Number.isInteger(segment.source) || segment.source < 0 || segment.source > 3
+      || !Number.isSafeInteger(segment.chain) || segment.chain < 0) throw Error('Invalid EC1 known segment');
+    previousTo = segment.to;
+  }
+  const byTime = new Map<number, EventClockOnset>();
+  for (const event of salience.basePool) {
+    const copy: EventClockOnset = { ...event };
+    if (!event.boundary && !isUnknown(event.time)) copy.role = 'free';
+    byTime.set(event.time, copy);
+  }
+  if (readout.primaryIds.length !== readout.heads.length || readout.primaryIds.some((id, index) => id !== readout.heads[index].eventId))
+    throw Error('EC1 primary ID tape differs from actual heads');
+  const primary = new Map<number, typeof readout.heads[number]>(), geometryByOrdinal = new Map<string, typeof readout.geometry[number]>();
+  let previousGeometry = -Infinity;
+  for (const target of readout.geometry) {
+    const key = `${target.chain}:${target.ordinal}`;
+    if (!Number.isFinite(target.time) || target.time < 0 || target.time >= baseline.duration || target.time <= previousGeometry
