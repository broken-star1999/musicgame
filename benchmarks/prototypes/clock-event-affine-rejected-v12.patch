@@ -0,0 +1,211 @@
+import { fitSourceClock, type AffineBinding } from './event-clock-affine';
+import { chooseClockPath, type PathCandidate, type PathOwner } from './event-clock-path';
+import type { ClockInput, ClockResult, ClockWork, ClockHead, RoleBinding, GeometryTarget, KnownSegment,
+  UnknownInterval, OwnerSummary, ClockChange, SourceId, PeriodProposal, PhaseProposal } from './event-clock-contracts';
+
+interface Candidate extends PathCandidate {
+  readonly ownerIndex: number; readonly source: SourceId;
+  readonly ownedBindings: readonly AffineBinding[];
+}
+const LIMITS = { maximumDuration: 300, maximumPhysical: 200000, maximumBlocks: 512,
+  maximumHypotheses: 64, maximumPhases: 16, maximumGeometry: 20000, maximumAbsOrdinal: 2147482624 } as const;
+function adjacent(value: number, direction: 1 | -1): number {
+  const scratch = new DataView(new ArrayBuffer(8));
+  scratch.setFloat64(0, value); const bits = scratch.getBigUint64(0);
+  scratch.setBigUint64(0, value > 0 ? bits + BigInt(direction) : bits - BigInt(direction));
+  return scratch.getFloat64(0);
+}
+function fitWindow(from: number, to: number, duration: number): readonly [number, number] {
+  let a = Math.max(0, Math.min(from + (to - from) / 2 - 4, duration - 8)), b = Math.min(duration, a + 8);
+  if (b - a > 8) {
+    if (b === duration) a = adjacent(a, 1); else b = adjacent(b, -1);
+  }
+  if (b - a > 8 || b <= a) throw Error('Invalid bounded fit window');
+  return [a, b];
+}
+function workRecord(): ClockWork {
+  return { physicalReads: 0, sourceReads: 0, originalBlocks: 0, ownedBlocks: 0, proposals: 0,
+    finiteProposals: 0, fitCalls: 0, eligibleCandidates: 0, edgeTrials: 0, validEdges: 0,
+    exactStateMerges: 0, maximumFrontier: 0, retainedStates: 0, geometryRestTargets: 0,
+    selectedHeads: 0, selectedBindings: 0, fitWork: {} };
+}
+
+/** New EC1 pipeline: fit independent original source hypotheses, compare their
+ * owner emissions over a complete finite path, then reconstruct an explicitly
+ * labelled reference clock. Physical note times and source identities are never
+ * interpolated; only missing reference beat labels may become virtual rests.
+ */
+export function readoutEventClock(input: ClockInput): ClockResult {
+  if (!input || !Number.isFinite(input.duration) || input.duration <= 0 || input.duration > LIMITS.maximumDuration
+    || !Array.isArray(input.streams) || input.streams.length !== 4 || !Array.isArray(input.physical)
+    || input.physical.length > LIMITS.maximumPhysical || !Array.isArray(input.blocks) || input.blocks.length > LIMITS.maximumBlocks)
+    throw Error('Invalid EC1 physical input');
+  const work = workRecord(), physicalByTime = new Map<number, number>(), physicalById = new Map<number, number>();
+  let previousId = -1, previousTime = -Infinity;
+  for (const event of input.physical) {
+    work.physicalReads++;
+    if (!event || !Number.isSafeInteger(event.id) || event.id <= previousId || !Number.isFinite(event.time)
+      || event.time < 0 || event.time >= input.duration || event.time <= previousTime) throw Error('Invalid ordered physical identity inventory');
+    physicalByTime.set(event.time, event.id); physicalById.set(event.id, event.time);
+    previousId = event.id; previousTime = event.time;
+  }
+  const actualTimes = new Set<number>();
+  for (const stream of input.streams) {
+    if (!Array.isArray(stream) || stream.length > LIMITS.maximumPhysical) throw Error('Invalid original EC1 source stream');
+    let previous = -Infinity;
+    for (const event of stream) {
+      work.sourceReads++;
+      if (!event || !Number.isFinite(event.time) || event.time < previous || event.time < 0 || event.time >= input.duration
+        || !Number.isFinite(event.strength) || event.strength < 0 || !Number.isInteger(event.band) || event.band < 0 || event.band > 2
+        || event.boundary !== undefined && typeof event.boundary !== 'boolean')
+        throw Error('Invalid original source member');
+      previous = event.time;
+      if (!event.boundary) {
+        if (!physicalByTime.has(event.time)) throw Error('Original source member missing from physical inventory');
+        actualTimes.add(event.time);
+      }
+    }
+  }
+  if (actualTimes.size !== physicalByTime.size) throw Error('Physical inventory contains an invented event');
+  const blockByOwner = new Map<number, number>();
+  input.blocks.forEach((block, index) => {
+    work.originalBlocks++;
+    if (!block || !Number.isFinite(block.time) || !Number.isFinite(block.from) || !Number.isFinite(block.to)
+      || block.from < 0 || block.to > input.duration || block.to < block.from || !Array.isArray(block.hypotheses)
+      || block.hypotheses.length > LIMITS.maximumHypotheses) throw Error('Invalid original EC1 proposal block');
+    if (block.time >= 0 && block.time < input.duration) {
+      const owner = Math.round(block.time / 2);
+      if (Math.abs(block.time - owner * 2) > 1e-9 || blockByOwner.has(owner)) throw Error('Duplicate/noncanonical original owner block');
+      blockByOwner.set(owner, index);
+    }
+  });
+  const ownerCount = Math.ceil(input.duration / 2), pathOwners: PathOwner[] = [], candidatesById = new Map<string, Candidate>();
+  const summaries: OwnerSummary[] = [];
+  for (let ownerIndex = 0; ownerIndex < ownerCount; ownerIndex++) {
+    const from = ownerIndex * 2, to = Math.min(input.duration, from + 2), originalIndex = blockByOwner.get(ownerIndex) ?? null;
+    const [windowFrom, windowTo] = fitWindow(from, to, input.duration);
+    const candidates: Candidate[] = []; let fitCandidates = 0, rank = 0;
+    const block = originalIndex === null ? null : input.blocks[originalIndex];
+    if (block) block.hypotheses.forEach((hypothesis: PeriodProposal, hypothesisIndex: number) => {
+      if (!hypothesis || !Array.isArray(hypothesis.phases) || hypothesis.phases.length > LIMITS.maximumPhases) throw Error('Invalid original phase proposals');
+      hypothesis.phases.forEach((proposal: PhaseProposal, phaseIndex: number) => {
+        work.proposals++;
+        if (!proposal || typeof proposal !== 'object') throw Error('Invalid original phase record');
+        if (proposal.meanResidual !== null && !Number.isFinite(proposal.meanResidual)) throw Error('Invalid original phase residual');
+        const period = hypothesis.period, anchor = proposal.anchor === null ? NaN : proposal.anchor + (proposal.meanResidual ?? 0);
+        if (period === null || !Number.isFinite(period) || period < .27 || period > 1.2 || !Number.isFinite(anchor)) return;
+        work.finiteProposals++;
+        for (let source = 0; source < 4; source++) {
+          work.fitCalls++; fitCandidates++;
+          const fit = fitSourceClock({ duration: input.duration, events: input.streams[source], period, anchor,
+            from: windowFrom, to: windowTo, ownerFrom: from, ownerTo: to, source: source as SourceId });
+          for (const [key, value] of Object.entries(fit.work)) if (typeof value === 'number') work.fitWork[key] = (work.fitWork[key] ?? 0) + value;
+          const candidateRank = rank++;
+          if (!fit.eligible) continue;
+          if (fit.version !== 'EC1-source-affine/v1' || fit.source !== source) throw Error('Unexpected source fit identity');
+          const id = `${ownerIndex}:${hypothesisIndex}:${phaseIndex}:${source}`;
+          const heads = fit.ownerBindings.filter(binding => binding.primary).map(binding => {
+            const eventId = physicalByTime.get(binding.time), original = input.streams[source][binding.sourceMemberIndex];
+            if (eventId === undefined || !original || original.boundary || original.time !== binding.time || binding.source !== source)
+              throw Error('Fitted head lost its original source identity');
+            return { eventId, time: binding.time, targetTime: binding.targetTime, localOrdinal: binding.localOrdinal };
+          }).sort((a, b) => a.time - b.time);
+          const c: Candidate = { id, ownerIndex, source: source as SourceId, period: fit.period, anchor: fit.anchor,
+            pivotOrdinal: fit.clock.pivotOrdinal, pivotTime: fit.clock.pivotTime,
+            loss: fit.ownerLoss.total, rank: candidateRank, heads, ownedBindings: fit.ownerBindings };
+          candidates.push(c); candidatesById.set(id, c); work.eligibleCandidates++;
+        }
+      });
+    });
+    pathOwners.push({ from, to, candidates });
+    summaries.push({ blockIndex: ownerIndex, from, to, inputBlockIndex: originalIndex,
+      fitCandidates, eligibleCandidates: candidates.length, frontier: 0, selectedId: null,
+      selectedLoss: 1, source: null, period: null, heads: 0, roleBindings: 0, transition: null });
+    work.ownedBlocks++;
+    input.progress?.(ownerIndex, ownerCount);
+  }
+  const path = chooseClockPath(pathOwners);
+  Object.assign(work, path.work);
+  for (let index = 0; index < summaries.length; index++) summaries[index] = { ...summaries[index], frontier: path.frontiers[index] };
+  const rawHeads: ClockHead[] = [], rawBindings: RoleBinding[] = [], knownSegments: KnownSegment[] = [], unknownIntervals: UnknownInterval[] = [], changes: ClockChange[] = [];
+  let chain = -1, offset = 0, previous: Candidate | null = null;
+  path.choices.forEach((choice, ownerIndex) => {
+    summaries[ownerIndex] = { ...summaries[ownerIndex], transition: choice.edge };
+    const owner = pathOwners[ownerIndex], candidate = choice.candidateId === null ? null : candidatesById.get(choice.candidateId);
+    if (choice.candidateId !== null && !candidate) throw Error('Backtrace references a missing actual fit');
+    if (!candidate) {
+      unknownIntervals.push({ from: owner.from, to: owner.to, blockIndex: ownerIndex,
+        reason: owner.candidates.length ? 'unknown-selected-by-finite-objective' : 'no-eligible-affine-fit' });
+      previous = null; return;
+    }
+    if (!previous || choice.edge.reset) { chain++; offset = 0; }
+    else offset += choice.edge.shift;
+    if (!Number.isSafeInteger(offset) || Math.abs(offset) > LIMITS.maximumAbsOrdinal) throw Error('Unsafe composed beat ordinal');
+    if (previous) {
+      const base = { from: owner.from, beforePeriod: previous.period, afterPeriod: candidate.period,
+        beforeSource: previous.source, afterSource: candidate.source, phaseDistance: choice.edge.phaseDistance };
+      if (choice.edge.reset) changes.push({ ...base, kind: 'phase-reset' });
+      else if (Math.abs(candidate.period - previous.period) > 1e-10) changes.push({ ...base, kind: 'tempo-update' });
+      if (candidate.source !== previous.source) changes.push({ ...base, kind: 'source-relay' });
+    }
+    for (const h of candidate.heads) {
+      const binding = candidate.ownedBindings.find(b => b.primary && b.time === h.time);
+      if (!binding) throw Error('Missing exact selected primary binding');
+      rawHeads.push({ ...h, ordinal: h.localOrdinal + offset, chain, period: candidate.period, source: candidate.source,
+        sourceMemberIndex: binding.sourceMemberIndex, compatibility: binding.compatibility, blockIndex: ownerIndex, candidateId: candidate.id });
+    }
+    for (const b of candidate.ownedBindings) {
+      const eventId = physicalByTime.get(b.time), original = input.streams[candidate.source][b.sourceMemberIndex];
+      if (eventId === undefined || !original || original.time !== b.time || original.boundary) throw Error('Role binding invented a physical source member');
+      rawBindings.push({ eventId, time: b.time, source: candidate.source, sourceMemberIndex: b.sourceMemberIndex,
+        denominator: b.denominator, compatibility: b.compatibility, fraction: b.fraction, primary: b.primary,
+        localOrdinal: b.localOrdinal, candidateId: candidate.id, blockIndex: ownerIndex });
+    }
+    knownSegments.push({ from: owner.from, to: owner.to, chain, period: candidate.period, source: candidate.source });
+    summaries[ownerIndex] = { ...summaries[ownerIndex], selectedId: candidate.id, selectedLoss: candidate.loss,
+      source: candidate.source, period: candidate.period, heads: candidate.heads.length, roleBindings: candidate.ownedBindings.length };
+    previous = candidate;
+  });
+  const originByChain = new Map<number, number>();
+  for (const head of rawHeads) if (!originByChain.has(head.chain)) originByChain.set(head.chain, head.ordinal);
+  const heads = rawHeads.map(head => ({ ...head, ordinal: head.ordinal - originByChain.get(head.chain)! }));
+  let lastId = -1, lastTime = -Infinity, lastChain = -1, lastOrdinal = -1;
+  for (const head of heads) {
+    if (head.eventId <= lastId || head.time <= lastTime || physicalById.get(head.eventId) !== head.time
+      || !Number.isSafeInteger(head.ordinal) || head.ordinal < 0 || head.chain === lastChain && head.ordinal <= lastOrdinal)
+      throw Error('Inconsistent global physical/ordinal head sequence');
+    lastId = head.eventId; lastTime = head.time; lastChain = head.chain; lastOrdinal = head.ordinal;
+  }
+  const primaryIds = new Set(heads.map(head => head.eventId)), bindingIds = new Set<number>();
+  const roleBindings = rawBindings.filter(binding => {
+    if (bindingIds.has(binding.eventId) || primaryIds.has(binding.eventId) && !binding.primary) return false;
+    bindingIds.add(binding.eventId); return true;
+  }).sort((a, b) => a.time - b.time);
+  const geometry: GeometryTarget[] = [];
+  for (let index = 0; index < heads.length; index++) {
+    const head = heads[index], next = heads[index + 1];
+    const sameChain = next?.chain === head.chain, gap = sameChain ? next.ordinal - head.ordinal : 1;
+    const step = sameChain ? (next.time - head.time) / gap : head.period;
+    geometry.push({ time: head.time, ordinal: head.ordinal, chain: head.chain, period: step,
+      source: head.source, eventId: head.eventId, blockIndex: head.blockIndex, kind: 'observed' });
+    if (sameChain) for (let ordinal = head.ordinal + 1; ordinal < next.ordinal; ordinal++) {
+      if (geometry.length >= LIMITS.maximumGeometry) throw Error('EC1 reference geometry budget exceeded');
+      const time = head.time + (ordinal - head.ordinal) / gap * (next.time - head.time);
+      geometry.push({ time, ordinal, chain: head.chain, period: step, source: head.source,
+        eventId: null, blockIndex: Math.min(ownerCount - 1, Math.floor(time / 2)), kind: 'interpolated-rest' });
+      work.geometryRestTargets++;
+    }
+  }
+  let lastGeometry = -Infinity;
+  for (const target of geometry) {
+    if (!Number.isFinite(target.time) || target.time < 0 || target.time >= input.duration || target.time <= lastGeometry)
+      throw Error('EC1 reference geometry is not strictly recording-ordered');
+    lastGeometry = target.time;
+  }
+  work.selectedHeads = heads.length; work.selectedBindings = roleBindings.length;
+  return { version: 'EC1-affine/v1', selection: 'finite-candidate-dynamic-programming', duration: input.duration,
+    primaryIds: heads.map(head => head.eventId), heads, roleBindings, geometry, knownSegments, unknownIntervals,
+    owners: summaries, changes, work,
+    pathObjective: { loss: path.loss, resets: path.resets, sourceChanges: path.sourceChanges },
+    exactScope: 'Exact DP over generated finite local fits; no continuous/global musical optimum. Kernel work is self-reported, top-level fit calls explicit. Reference rests are declared interpolation, not physical note heads.' };
+}
diff --git a/src/core/event-clock-salience.ts b/src/core/event-clock-salience.ts
