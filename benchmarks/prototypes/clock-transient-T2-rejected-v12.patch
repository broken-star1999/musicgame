+import FFT from 'fft.js';
+import { describe, expect, it } from 'vitest';
+import { analyzeAudio } from './analysis';
+import { acousticProfileAt, accumulateAcousticPower, createAcousticFrames } from './acoustic-evidence';
+
+const RATE = 22050, N = 1024, HOP = 221;
+
+describe('physical low-transient evidence', () => {
+  it('recognizes a short LF attack after its measured flux frame without moving that onset', () => {
+    const starts = Array.from({ length: 8 }, (_, i) => .8 + i * .5);
+    const samples = new Float32Array(RATE * 5.5);
+    for (const time of starts) {
+      const first = Math.round(time * RATE);
+      for (let j = 0; j < N; j++) samples[first + j] = .6 * Math.sin(2 * Math.PI * 4 * j / N);
+    }
+    // Measured attack times from the original detector, before peak descriptors
+    // existed. The later acoustic maximum must not become the note timestamp.
+    const measuredTimes = [.7719401360544217, 1.2730739229024943, 1.7742077097505669, 2.2753414965986396,
+      2.776475283446712, 3.2776090702947847, 3.778742857142857, 4.27987664399093];
+    const analysis = analyzeAudio(samples, RATE);
+    starts.forEach((time, i) => {
+      const onset = analysis.onsets.filter(event => Math.abs(event.time - time) <= .05)
+        .sort((a, b) => Math.abs(a.time - time) - Math.abs(b.time - time) || a.time - b.time)[0];
+      expect(onset).toBeDefined();
+      expect(onset.time).toBe(measuredTimes[i]);
+      expect(onset.boundary).toBeUndefined();
+      // The original current-frame comparison sees a still-rising envelope.
+      expect(onset.acoustic?.lowDecay).toBe(0);
+      const peak = onset.acoustic?.lowTransient;
+      expect(peak).toBeDefined();
+      expect(peak!.hasHistory && peak!.hasFuture).toBe(true);
+      expect(peak!.peakOffsetFrames).toBeGreaterThan(0);
+      expect(peak!.powerFraction * peak!.rise * peak!.decay).toBeGreaterThan(.9);
+    });
+  });
+
+  it('preserves a distinct raw-FFT burst peak and ratios when its gain changes', () => {
+    const frames = 50, count = N + (frames - 1) * HOP;
+    const window = Float64Array.from({ length: N }, (_, j) => .5 - .5 * Math.cos(2 * Math.PI * j / (N - 1)));
+    const profiles = [.1, 1].map(gain => {
+      const samples = new Float32Array(count), first = 20 * HOP;
+      for (let j = 0; j < N; j++) samples[first + j] = gain * Math.cos(2 * Math.PI * 4 * j / N);
+      const state = createAcousticFrames(frames, N, HOP, RATE), fft = new FFT(N);
+      const input = new Float64Array(N), spectrum = fft.createComplexArray();
+      for (let frame = 0; frame < frames; frame++) {
+        for (let j = 0; j < N; j++) input[j] = samples[frame * HOP + j] * window[j];
+        fft.realTransform(spectrum, input);
+        for (let bin = 1; bin < N / 2; bin++)
+          accumulateAcousticPower(state, frame, bin, Math.hypot(spectrum[2 * bin], spectrum[2 * bin + 1]));
+      }
+      const peak = acousticProfileAt(state, 18)?.lowTransient;
+      expect(peak).toBeDefined();
+      return peak!;
+    });
+    for (const peak of profiles) {
+      expect(peak.peakOffsetFrames).toBe(2);
+      expect(peak.hasHistory && peak.hasFuture).toBe(true);
+      expect(peak.powerFraction).toBeGreaterThan(.99);
+      expect(peak.rise).toBe(1); expect(peak.decay).toBe(1);
+      for (const key of ['powerFraction', 'rise', 'decay'] as const)
+        expect(Math.abs(peak[key] - profiles[1][key])).toBeLessThanOrEqual(1e-6);
+    }
+  });
+
+  it('chooses the earliest equal physical peak and never creates an f0 profile', () => {
+    const state = createAcousticFrames(40, N, HOP, RATE);
+    for (const [frame, amplitude] of [[5, 1], [10, 1], [11, 3], [12, 3], [16, 1]])
+      accumulateAcousticPower(state, frame, 4, amplitude);
+    accumulateAcousticPower(state, 11, 192, 1);
+    const profile = acousticProfileAt(state, 10);
+    expect(profile?.lowTransient).toEqual({ peakOffsetFrames: 1, powerFraction: .9, rise: .8, decay: .8,
+      hasHistory: true, hasFuture: true });
+    expect(acousticProfileAt(state, 10)).toBe(profile);
+    expect(acousticProfileAt(state, 0)).toBeUndefined();
+    expect(state.profiles.has(0)).toBe(false);
+  });
+
+  it('requires the entire peak-search window instead of truncating at the file edge or an invalid frame', () => {
+    const tail = createAcousticFrames(24, N, HOP, RATE);
+    accumulateAcousticPower(tail, 20, 4, 2);
+    const current = acousticProfileAt(tail, 20);
+    expect(current).toBeDefined();
+    expect(current!.powerFractions[0]).toBe(1);
+    expect(current!.lowTransient).toBeUndefined();
+
+    const invalid = createAcousticFrames(40, N, HOP, RATE);
+    accumulateAcousticPower(invalid, 10, 4, 2);
+    invalid.bandPower[0][12] = NaN;
+    const knownCurrent = acousticProfileAt(invalid, 10);
+    expect(knownCurrent).toBeDefined();
+    expect(knownCurrent!.lowTransient).toBeUndefined();
+  });
+
+  it('marks missing pre/post context unknown even when a complete search finds a real peak', () => {
+    const opening = createAcousticFrames(18, N, HOP, RATE);
+    accumulateAcousticPower(opening, 1, 4, 1);
+    accumulateAcousticPower(opening, 3, 4, 3);
+    expect(acousticProfileAt(opening, 1)?.lowTransient).toEqual({ peakOffsetFrames: 2, powerFraction: 1,
+      rise: 0, decay: 1, hasHistory: false, hasFuture: true });
+
+    const closing = createAcousticFrames(35, N, HOP, RATE);
+    accumulateAcousticPower(closing, 29, 4, 1);
+    accumulateAcousticPower(closing, 34, 4, 3);
+    expect(acousticProfileAt(closing, 29)?.lowTransient).toEqual({ peakOffsetFrames: 5, powerFraction: 1,
+      rise: 1, decay: 0, hasHistory: true, hasFuture: false });
+  });
+});
