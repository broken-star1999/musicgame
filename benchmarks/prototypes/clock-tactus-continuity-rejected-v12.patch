index 0000000..e77f597
--- /dev/null
+++ b/src/core/source-continuity.ts
@@ -0,0 +1,73 @@
+import { inspectSourceRoleEvidence, type SourceRoleInspection, type SourceRoleRequest, type SourceRoleTrack } from './source-role-evidence';
+
+/** Prospective engineering policy, fixed before any new feature/music scores.
+ * These are observation sufficiency rules, not probabilities or human labels.
+ * A nested faster train can support both clocks; that ambiguity is intentional.
+ */
+export const SOURCE_CONTINUITY_POLICY = Object.freeze({
+  ruleId: 'source-continuity/v1', minimumOpportunities: 4, minimumMatched: 4,
+  minimumMatchedSpan: 1, minimumCoverage: .5,
+});
+export type SourceId = 0 | 1 | 2 | 3;
+export interface SupportSummary {
+  readonly source: SourceId;
+  readonly opportunities: number;
+  readonly matched: number;
+  readonly coverage: number | null;
+  readonly matchedSpan: number;
+  readonly supported: boolean;
+  readonly sufficientWindow: boolean;
+}
+export interface ContinuityAssessment {
+  readonly ruleId: 'source-continuity/v1';
+  readonly action: 'continue' | 'relay' | 'change-candidate' | 'insufficient-old-window' | 'unsupported';
+  readonly activeSource: SourceId;
+  readonly old: readonly SupportSummary[];
+  readonly proposed: readonly SupportSummary[] | null;
+  readonly oldSupportedSources: readonly SourceId[];
+  readonly proposedSupportedSources: readonly SourceId[];
+  readonly changeSuppressedByOldSupport: boolean;
+  readonly interpretation: string;
+}
+
+function summarize(track: SourceRoleTrack): SupportSummary {
+  const p = SOURCE_CONTINUITY_POLICY;
+  const sufficientWindow = track.opportunities >= p.minimumOpportunities;
+  return Object.freeze({ source: track.source, opportunities: track.opportunities, matched: track.matched,
+    coverage: track.coverage, matchedSpan: track.matchedSpan, sufficientWindow,
+    supported: sufficientWindow && track.matched >= p.minimumMatched && track.matchedSpan >= p.minimumMatchedSpan
+      && track.coverage !== null && track.coverage >= p.minimumCoverage });
+}
+
+/** Uses the OLD carried clock to decide whether continuation remains observed.
+ * Neither loudness nor the new grid redefines the old primary observations.
+ * Sources are alternatives, including mixed; their overlapping rows are never
+ * added together as independent votes. Full ordered words remain in inspection,
+ * but this conservative first policy uses primary tapes only, not word scores.
+ */
+export function assessSourceContinuity(evidence: SourceRoleInspection, activeSource: SourceId): ContinuityAssessment {
+  if (!Number.isInteger(activeSource) || activeSource < 0 || activeSource > 3) throw Error('Invalid active source');
+  if (evidence.old.sources.length !== 4 || evidence.old.sources.some((s, i) => s.source !== i)
+    || evidence.proposed && (evidence.proposed.sources.length !== 4 || evidence.proposed.sources.some((s, i) => s.source !== i)))
+    throw Error('Four ordered source alternatives are required');
+  const old = evidence.old.sources.map(summarize), proposed = evidence.proposed?.sources.map(summarize) ?? null;
+  const oldSupportedSources = old.filter(s => s.supported).map(s => s.source);
+  const proposedSupportedSources = proposed?.filter(s => s.supported).map(s => s.source) ?? [];
+  const oldSufficient = old.every(s => s.sufficientWindow);
+  const action = oldSupportedSources.length
+    ? old[activeSource].supported ? 'continue' : 'relay'
+    : !oldSufficient ? 'insufficient-old-window' : proposedSupportedSources.length ? 'change-candidate' : 'unsupported';
+  return Object.freeze({ ruleId: SOURCE_CONTINUITY_POLICY.ruleId, action, activeSource,
+    old: Object.freeze(old), proposed: proposed && Object.freeze(proposed),
+    oldSupportedSources: Object.freeze(oldSupportedSources), proposedSupportedSources: Object.freeze(proposedSupportedSources),
+    changeSuppressedByOldSupport: oldSupportedSources.length > 0 && proposedSupportedSources.length > 0,
+    interpretation: 'Conservative source/clock continuity rule only. Supported alternatives and nested clocks remain semantically ambiguous.' });
+}
+
+/** This path always computes facts from the actual four source streams. */
+export function inspectSourceContinuity(input: SourceRoleRequest, activeSource: SourceId): {
+  readonly evidence: SourceRoleInspection; readonly assessment: ContinuityAssessment;
+} {
+  const evidence = inspectSourceRoleEvidence(input);
+  return { evidence, assessment: assessSourceContinuity(evidence, activeSource) };
+}
