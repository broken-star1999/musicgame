+        const oldState = carrier, oldSource = activeSource;
+        let change: ChangeChoice | null = null;
+        // A true tempo update at the previous actual head cannot reinterpret
+        // rest targets which have already been committed after that boundary.
+        if (lastCommitted === carrier.virtualTarget) {
+          const seenPeriods = new Set<number>();
+          for (const candidate of eligible) {
+            if (seenPeriods.has(candidate.period!) || candidate.period === carrier.period) continue;
+            seenPeriods.add(candidate.period!); work.candidateTrials++;
+            const evidence = inspect(carrier.virtualTarget, carrier.period, oldContext.from, oldContext.to,
+              { virtualTarget: carrier.virtualTarget, period: candidate.period! });
+            const policy = assess(evidence, activeSource);
+            if (policy.action !== 'change-candidate' || !evidence.proposed) continue;
+            for (const source of policy.proposedSupportedSources) {
+              const built = factory('tempo-update', candidate.candidateId, source,
+                () => tempoChangeWitness(oldState, oldSource, source, candidate.period!, oldContext));
+              if (!built) continue;
+              const value: ChangeChoice = { ...rank(built.evidence.proposed!.sources[source], candidate.period!, candidate, work),
+                kind: 'tempo-update', candidate, built, match: null };
+              if (better(value, change)) change = value;
+            }
+          }
+        }
+        for (const candidate of eligible) {
+          work.candidateTrials++;
+          const evidence = inspect(candidate.anchor!, candidate.period!, from, windowEnd(from));
+          for (const track of evidence.old.sources) {
+            if (!isSupported(track)) continue;
+            const seedMatch = legalSeed(track, candidate.period!, from, to, carrier, true); if (!seedMatch) continue;
+            const seed = makeSeed(seedMatch, candidate.period!), newContext = context(seed.virtualTarget);
+            const built = factory('phase-reset', candidate.candidateId, track.source,
+              () => phaseChangeWitness(oldState, oldSource, track.source, seed, newContext));
+            if (!built) continue;
+            const value: ChangeChoice = { ...rank(built.evidence.proposed!.sources[track.source], candidate.period!, candidate, work),
+              kind: 'phase-reset', candidate, built, match: seedMatch };
+            if (better(value, change)) change = value;
+          }
+        }
+        if (!change) { becomeUnknown(target, 'no-supported-explicit-clock-change'); break; }
+        if (change.kind === 'tempo-update') {
+          closeKnown(Math.max(from, carrier.virtualTarget)); work.updateTempoCalls++;
