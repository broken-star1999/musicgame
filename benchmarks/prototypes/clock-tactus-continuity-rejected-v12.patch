+++ b/src/core/tactus-readout.ts
@@ -0,0 +1,697 @@
+/** Static prototype preparation. This module is not called during preparation.
+ * The greedy/hysteretic readout consumes original physical streams and original
+ * hypotheses. It never consumes RME1 selected paths, baseline roles or truth. */
+import { inspectSourceRoleEvidence, type RawSourceEvent, type SourceRoleInspection, type SourceRoleTrack } from './source-role-evidence';
+import { assessSourceContinuity, SOURCE_CONTINUITY_POLICY, type SourceId, type ContinuityAssessment } from './source-continuity';
+import { sourceStateKey, sourceRelayWitness, tempoChangeWitness, phaseChangeWitness,
+  type PhysicalIdentity, type BuiltChange, type WitnessContext } from './source-change-witness';
+import { createCarrier, seedAfterUnknown, advancePrimary, relaySource, updateTempo, resetPhase, markUnknown,
+  type KnownCarrier, type UnknownCarrier, type CarrierSeed } from './tactus-carrier';
+
+export interface ReadoutPhase {
+  readonly anchor: number | null;
+  readonly meanResidual: number | null;
+  readonly coverage: number | null;
+  readonly supported: boolean;
+  readonly unknown: boolean;
+}
+export interface ReadoutHypothesis { readonly period: number | null; readonly phases: readonly ReadoutPhase[] }
+export interface ReadoutBlock {
+  readonly time: number;
+  readonly from: number;
+  readonly to: number;
+  readonly hypotheses: readonly ReadoutHypothesis[];
+  readonly preferredPeriod?: number | null;
+}
+export interface ReadoutInput {
+  readonly duration: number;
+  readonly streams: readonly (readonly RawSourceEvent[])[];
+  readonly physical: readonly PhysicalIdentity[];
+  readonly blocks: readonly ReadoutBlock[];
+  readonly progress?: (blockIndex: number, totalBlocks: number) => void;
+}
+export interface ReadoutCandidate {
+  readonly candidateId: string;
+  readonly inputBlockIndex: number;
+  readonly hypothesisIndex: number;
+  readonly phaseIndex: number;
+  readonly period: number | null;
+  readonly anchor: number | null;
+  readonly eligible: boolean;
+  readonly reason: string;
+}
+export interface PrimaryHead {
+  readonly eventId: number;
+  readonly time: number;
+  readonly targetTime: number;
+  readonly ordinal: number;
+  readonly chain: number;
+  readonly period: number;
+  readonly source: SourceId;
+  readonly sourceMemberIndex: number;
+  readonly compatibility: number;
+  readonly blockIndex: number;
+}
+export interface GeometryTarget {
+  readonly time: number;
+  readonly ordinal: number;
+  readonly chain: number;
+  readonly period: number;
+  readonly source: SourceId;
+  readonly eventId: number | null;
+  readonly blockIndex: number;
+}
+export interface KnownSegment {
+  readonly from: number;
+  readonly to: number;
+  readonly chain: number;
+  readonly period: number;
+  readonly source: SourceId;
+}
+export interface UnknownInterval { readonly from: number; readonly to: number; readonly reason: string; readonly blockIndex: number }
+export interface ReadoutChange {
+  readonly blockIndex: number;
+  readonly kind: 'source-relay' | 'tempo-update' | 'phase-reset';
+  readonly candidateId: string | null;
+  readonly score: number;
+  readonly meanCompatibility: number;
+  /** Effective outgoing clock/source boundary; may precede its decision owner. */
+  readonly effectiveFrom: number;
+  readonly built: BuiltChange;
+}
+export interface OwnerDiagnostic {
+  readonly blockIndex: number;
+  readonly from: number;
+  readonly to: number;
+  readonly inputBlockIndex: number | null;
+  readonly candidates: readonly ReadoutCandidate[];
+  status: string;
+  seedCandidateId: string | null;
+  seedSource: SourceId | null;
+  seedScore: number | null;
+  seedMeanCompatibility: number | null;
+  partialUnknown: boolean;
+  readonly factoryRejections: { readonly kind: string; readonly candidateId: string | null; readonly source: SourceId; readonly message: string }[];
+  heads: number;
+  targets: number;
+  inspections: number;
+}
+export interface ReadoutWork {
+  physicalValidationReads: number;
+  sourceValidationReads: number;
+  sourceMembers: number;
+  boundaryMembersExcluded: number;
+  sourceBlocks: number;
+  ownedBlocks: number;
+  contextOnlyBlocks: number;
+  originalHypotheses: number;
+  originalPhases: number;
+  eligibleCandidates: number;
+  sourceInspectionCalls: number;
+  sourceInspectionCacheHits: number;
+  sourceInspectionCacheEntries: number;
+  sourcePolicyCalls: number;
+  sourceRelayFactoryCalls: number;
+  tempoFactoryCalls: number;
+  phaseFactoryCalls: number;
+  factoryReturns: number;
+  factoryThrows: number;
+  factoryInternalInspectionCallsMinimum: number;
+  factoryInternalInspectionCallsMaximum: number;
+  factoryInternalPolicyCallsMinimum: number;
+  factoryInternalPolicyCallsMaximum: number;
+  helperWork: Record<string, number>;
+  returnedFactoryHelperWork: Record<string, number>;
+  createCarrierCalls: number;
+  seedAfterUnknownCalls: number;
+  advancePrimaryCalls: number;
+  relaySourceCalls: number;
+  updateTempoCalls: number;
+  resetPhaseCalls: number;
+  markUnknownCalls: number;
+  normalTargetTrials: number;
+  restTargets: number;
+  headMatches: number;
+  nearestQueries: number;
+  binaryComparisons: number;
+  distanceComparisons: number;
+  duplicateTieReads: number;
+  candidateTrials: number;
+  phaseSeedTrials: number;
+  loopIterations: number;
+  maximumOwnerIterations: number;
+  maximumOwnerCacheEntries: number;
+  maximumOwnerFactoryAttempts: number;
+  rankingMatchReads: number;
+  windowEndpointAdjustments: number;
+  explicitWindowScratchBytes: 8;
+  retrospectiveMetadataSegments: number;
+  retrospectiveMetadataSplits: number;
+  censoredSeedQueries: number;
+  censoredSeedMatches: number;
+  nearestEligibilityReads: number;
+  uncensoredSeedFallbackQueries: number;
+  uncensoredSeedFallbackMatches: number;
+}
+export interface ReadoutResult {
+  readonly version: 'TC1-readout/v1';
+  readonly duration: number;
+  readonly primaryIds: readonly number[];
+  readonly heads: readonly PrimaryHead[];
+  readonly geometry: readonly GeometryTarget[];
+  readonly knownSegments: readonly KnownSegment[];
+  readonly unknownIntervals: readonly UnknownInterval[];
+  readonly owners: readonly OwnerDiagnostic[];
+  readonly changes: readonly ReadoutChange[];
+  readonly contextOnlyBlocks: readonly { readonly inputBlockIndex: number; readonly time: number }[];
+  readonly work: ReadoutWork;
+  readonly selection: 'greedy-hysteresis-not-global-optimization';
+}
+
+const OWNED_SECONDS = 2, EPS = 1e-9, MIN_PERIOD = .27, MAX_PERIOD = 1.2;
+const MAX_HYPOTHESES = 22, MAX_PHASES = 4, MAX_CANDIDATES = 88, MAX_OWNERS = 1_000_000;
+export const READOUT_LIMITS = Object.freeze({ maximumOwners: MAX_OWNERS, maximumCandidatesPerOriginalBlock: MAX_CANDIDATES,
+  maximumOwnerIterations: 4096, maximumOwnerInspectionCacheEntries: 8192, maximumOwnerFactoryAttempts: 8192 });
+const timingTolerance = (period: number): number => Math.min(.09, .2 * period);
+
+interface Prepared {
+  readonly byTime: ReadonlyMap<number, number>;
+  readonly regularIndices: readonly (readonly number[])[];
+  readonly associated: ReadonlyMap<number, { readonly inputBlockIndex: number; readonly candidates: readonly ReadoutCandidate[] }>;
+  readonly context: readonly { readonly inputBlockIndex: number; readonly time: number }[];
+  readonly count: number;
+}
+
+function prepare(input: ReadoutInput, work: ReadoutWork): Prepared {
+  if (!input || !Number.isFinite(input.duration) || input.duration <= 0 || !Array.isArray(input.streams) || input.streams.length !== 4
+    || !Array.isArray(input.physical) || !Array.isArray(input.blocks)) throw Error('Finite duration, four raw streams, physical inventory and original blocks required');
+  const count = Math.ceil(input.duration / OWNED_SECONDS);
+  if (!Number.isSafeInteger(count) || count > MAX_OWNERS) throw Error('Owned timeline exceeds explicit allocation bound');
+  work.ownedBlocks = count; work.sourceBlocks = input.blocks.length;
+  const originalTimes = new Set<number>();
+  const regularIndices = input.streams.map(stream => {
+    if (!Array.isArray(stream)) throw Error('Raw source stream must be an array');
+    const regular: number[] = []; let previous = -Infinity;
+    stream.forEach((event, index) => {
+      work.sourceValidationReads++;
+      if (!event || !Number.isFinite(event.time) || event.time < 0 || event.time >= input.duration || event.time < previous
+        || !Number.isFinite(event.strength) || event.strength < 0) throw Error('Invalid original raw source member');
+      previous = event.time;
+      if (event.boundary) { work.boundaryMembersExcluded++; return; }
+      originalTimes.add(event.time); regular.push(index); work.sourceMembers++;
+    });
+    return regular;
+  });
+  const byTime = new Map<number, number>(); let previousId = -1, previousTime = -Infinity;
+  for (const event of input.physical) {
+    work.physicalValidationReads++;
+    if (!event || !Number.isSafeInteger(event.id) || event.id <= previousId || !Number.isFinite(event.time)
