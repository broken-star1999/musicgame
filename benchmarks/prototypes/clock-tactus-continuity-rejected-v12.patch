diff --git a/src/core/source-change-witness.ts b/src/core/source-change-witness.ts
new file mode 100644
index 0000000..5b0a69c
--- /dev/null
+++ b/src/core/source-change-witness.ts
@@ -0,0 +1,110 @@
+import { inspectSourceContinuity, type ContinuityAssessment, type SourceId } from './source-continuity';
+import type { SourceRoleInspection, SourceRoleRequest, SourceRoleTrack } from './source-role-evidence';
+import { stateKey, type KnownCarrier, type CarrierSeed, type ChangeWitness, type ChangeDestination } from './tactus-carrier';
+
+export interface PhysicalIdentity { readonly id: number; readonly time: number }
+export interface WitnessContext {
+  readonly streams: SourceRoleRequest['streams'];
+  /** Exact-time global bundles from the actual source streams, not reference beats. */
+  readonly physical: readonly PhysicalIdentity[];
+  readonly from: number;
+  readonly to: number;
+}
+export interface BuiltChange {
+  readonly witness: ChangeWitness;
+  readonly evidence: SourceRoleInspection;
+  readonly assessment: ContinuityAssessment;
+}
+export const sourceStateKey = (source: SourceId): string => `source:${source}`;
+
+function validateState(state: KnownCarrier, source: SourceId): void {
+  if (state.sourceStateKey !== sourceStateKey(source)) throw Error('Source state does not match the active source');
+  stateKey(state); // Validate the complete actual carrier using its public contract.
+}
+function destination(state: KnownCarrier): ChangeDestination {
+  return { chainId: state.chainId, lastPrimaryId: state.lastPrimaryId, lastPrimaryTime: state.lastPrimaryTime,
+    virtualTarget: state.virtualTarget, period: state.period, beatOrdinal: state.beatOrdinal, sourceStateKey: state.sourceStateKey };
+}
+function currentWindow(context: WitnessContext, pivot: number): void {
+  if (context.from !== pivot || !Number.isFinite(context.to) || context.to <= pivot || context.to - pivot > 8)
+    throw Error('Change evidence must start at its current virtual pivot and span at most eight seconds');
+}
+function build(state: KnownCarrier, to: ChangeDestination, kind: ChangeWitness['kind'], source: SourceId,
+  context: WitnessContext, evidence: SourceRoleInspection, assessment: ContinuityAssessment, track: SourceRoleTrack): BuiltChange {
+  const byTime = new Map<number, number>(), byId = new Map<number, number>();
+  let previousId = -1, previousTime = -Infinity;
+  for (const event of context.physical) {
+    if (!Number.isSafeInteger(event.id) || event.id <= previousId || !Number.isFinite(event.time) || event.time < 0 || event.time <= previousTime)
+      throw Error('Physical bundle identities/times must strictly increase');
+    byTime.set(event.time, event.id); byId.set(event.id, event.time); previousId = event.id; previousTime = event.time;
+  }
+  const originalTimes = new Set(context.streams.flatMap(stream => stream.filter(e => !e.boundary).map(e => e.time)));
+  if (byTime.size !== originalTimes.size || [...byTime.keys()].some(time => !originalTimes.has(time)))
+    throw Error('Physical inventory must exactly cover the original regular source frames');
+  if (byId.get(state.lastPrimaryId) !== state.lastPrimaryTime || byId.get(to.lastPrimaryId) !== to.lastPrimaryTime)
+    throw Error('Old and proposed primary identities must be real source bundles');
+  const ids = new Set([state.lastPrimaryId, to.lastPrimaryId]);
+  for (const point of track.primary) if (point.memberIndex !== null) {
+    const original = context.streams[source]?.[point.memberIndex];
+    if (!original || original.boundary || original.time !== point.eventTime) throw Error('Support lost its original source member');
+    const id = byTime.get(original.time); if (id === undefined) throw Error('Supported source member lacks its physical bundle');
+    ids.add(id);
+  }
+  const physicalEventIds = [...ids].sort((a, b) => a - b);
+  const payload = { interval: { from: context.from, to: context.to }, activeSource: assessment.activeSource,
+    chosenSource: source, action: assessment.action, old: assessment.old, proposed: assessment.proposed,
+    oldCarrier: evidence.old.carrier, proposedCarrier: evidence.proposed?.carrier ?? null,
+    scope: 'Actual source tapes under a fixed engineering rule; not calibrated change probability or human-beat truth.' };
+  const proofId = JSON.stringify([assessment.ruleId, kind, stateKey(state), to, context.from, context.to, physicalEventIds]);
+  const witness: ChangeWitness = Object.freeze({ schema: 'tactus-change-witness/v1', kind, fromStateKey: stateKey(state),
+    to: Object.freeze(to), evidence: Object.freeze({ ruleId: assessment.ruleId, proofId,
+      physicalEventIds: Object.freeze(physicalEventIds), payload: Object.freeze(payload) }) });
+  return { witness, evidence, assessment };
+}
+
+/** A same-phase relay only changes source, never tempo or virtual phase. */
+export function sourceRelayWitness(state: KnownCarrier, active: SourceId, next: SourceId, context: WitnessContext): BuiltChange {
+  validateState(state, active);
+  currentWindow(context, state.virtualTarget);
+  const { evidence, assessment } = inspectSourceContinuity({ streams: context.streams,
+    oldCarrier: { virtualTarget: state.virtualTarget, period: state.period }, from: context.from, to: context.to }, active);
+  if (assessment.action !== 'relay' || next === active || !assessment.oldSupportedSources.includes(next)) throw Error('No observed same-clock relay');
+  return build(state, { ...destination(state), sourceStateKey: sourceStateKey(next) }, 'source-relay', next,
+    context, evidence, assessment, evidence.old.sources[next]);
+}
+
+/** A new period branches only after OLD-clock support fails across all sources.
+ * New observations are tested at the carried virtual beat boundary, not at an
+ * arbitrary local grid anchor. The kernel independently checks this binding.
+ */
+export function tempoChangeWitness(state: KnownCarrier, active: SourceId, next: SourceId, period: number, context: WitnessContext): BuiltChange {
+  validateState(state, active);
+  currentWindow(context, state.virtualTarget);
+  if (!Number.isFinite(period) || period <= 0 || period === state.period) throw Error('A genuinely different finite period is required');
+  const { evidence, assessment } = inspectSourceContinuity({ streams: context.streams,
+    oldCarrier: { virtualTarget: state.virtualTarget, period: state.period },
+    proposed: { virtualTarget: state.virtualTarget, period }, from: context.from, to: context.to }, active);
+  if (assessment.action !== 'change-candidate' || !assessment.proposedSupportedSources.includes(next)) throw Error('Old support has not failed or proposed tempo lacks support');
+  return build(state, { ...destination(state), period, sourceStateKey: sourceStateKey(next) }, 'tempo-update', next,
+    context, evidence, assessment, evidence.proposed!.sources[next]);
+}
+
+/** Explicit phase discontinuity starts a new chain, using a real unconsumed head. */
+export function phaseChangeWitness(state: KnownCarrier, active: SourceId, next: SourceId, seed: CarrierSeed, context: WitnessContext): BuiltChange {
+  validateState(state, active);
+  currentWindow(context, seed.virtualTarget);
+  if (seed.sourceStateKey !== sourceStateKey(next) || seed.observation.id <= state.consumedCursor
+    || seed.observation.time <= state.lastPrimaryTime || seed.virtualTarget <= state.virtualTarget)
+    throw Error('New phase needs a later unconsumed physical primary and source binding');
+  const { evidence, assessment } = inspectSourceContinuity({ streams: context.streams,
+    oldCarrier: { virtualTarget: state.virtualTarget, period: state.period },
+    proposed: { virtualTarget: seed.virtualTarget, period: seed.period }, from: context.from, to: context.to }, active);
+  if (!context.streams[next]?.some(event => !event.boundary && event.time === seed.observation.time)
+    || !Number.isFinite(seed.tolerance) || seed.tolerance < 0 || seed.tolerance > evidence.proposed!.tolerance
+    || Math.abs(seed.observation.time - seed.virtualTarget) > seed.tolerance)
+    throw Error('New phase seed must be an original member of the proposed source within its physical tolerance');
+  if (assessment.action !== 'change-candidate' || !assessment.proposedSupportedSources.includes(next)) throw Error('No observed phase-change candidate');
+  return build(state, { chainId: state.chainId + 1, lastPrimaryId: seed.observation.id, lastPrimaryTime: seed.observation.time,
+    virtualTarget: seed.virtualTarget, period: seed.period, beatOrdinal: 0, sourceStateKey: seed.sourceStateKey }, 'phase-reset', next,
+    context, evidence, assessment, evidence.proposed!.sources[next]);
+}
