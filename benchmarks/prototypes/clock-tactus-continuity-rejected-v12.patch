+          activeSource = change.source; startKnown(Math.max(from, carrier.virtualTarget), carrier, activeSource);
+        } else {
+          if (!change.match) throw Error('Accepted phase change lacks its physical seed');
+          const transitionAt = change.match.target, gapStart = Math.max(from, target, carrier.lastPrimaryTime, lastCommitted);
+          closeKnown(Math.min(gapStart, transitionAt));
+          if (gapStart < transitionAt) appendUnknown(gapStart, transitionAt, 'explicit-phase-change-unresolved-gap', blockIndex);
+          work.resetPhaseCalls++; carrier = resetPhase(carrier, makeSeed(change.match, change.candidate.period!), change.built.witness);
+          activeSource = change.source; startKnown(transitionAt, carrier, activeSource); appendHead(carrier, change.match, blockIndex);
+        }
+        changes.push({ blockIndex, kind: change.kind, candidateId: change.candidate.candidateId,
+          score: change.score, meanCompatibility: change.meanCompatibility,
+          effectiveFrom: carrier.virtualTarget, built: change.built });
+      }
+    }
+    closeKnown(to);
+    owner.heads = heads.length - headStart; owner.targets = geometry.length - geometryStart;
+    owner.inspections = work.sourceInspectionCalls - inspectionStart;
+    const hasUnknown = unknownIntervals.length > unknownStart, hasKnown = ownerHasKnown;
+    owner.partialUnknown = hasUnknown && hasKnown;
+    owner.status = hasUnknown ? hasKnown ? 'partial-unknown' : 'unknown' : hasKnown ? 'known' : 'unavailable';
+    work.maximumOwnerIterations = Math.max(work.maximumOwnerIterations, ownerIterations);
+    work.maximumOwnerCacheEntries = Math.max(work.maximumOwnerCacheEntries, cache.size);
+    work.maximumOwnerFactoryAttempts = Math.max(work.maximumOwnerFactoryAttempts, ownerFactories);
+    input.progress?.(blockIndex, prepared.count);
+  }
+  return { version: 'TC1-readout/v1', duration: input.duration, primaryIds: heads.map(head => head.eventId), heads, geometry,
+    knownSegments, unknownIntervals, owners, changes, contextOnlyBlocks: prepared.context, work,
+    selection: 'greedy-hysteresis-not-global-optimization' };
+}
