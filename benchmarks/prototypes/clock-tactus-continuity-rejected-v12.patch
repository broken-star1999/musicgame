+          continue;
+        }
+        if (oldAssessment.action === 'insufficient-old-window') { becomeUnknown(target, 'insufficient-old-clock-observation-window'); break; }
+        if (oldAssessment.oldSupportedSources.length) throw Error('A supported old clock reached change enumeration');
