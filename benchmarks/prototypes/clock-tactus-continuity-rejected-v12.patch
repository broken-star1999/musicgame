+++ b/src/core/source-role-evidence.ts
@@ -0,0 +1,248 @@
+/** Pure source-conditioned observations. No candidate/clock selection, fitted
+ * threshold, source preference, role rebinding, amplitude winner, or NN.
+ * Source0=mixed; source1/2/3=original low/mid/high detector streams.
+ */
+export interface RawSourceEvent {
+  readonly time: number;
+  readonly strength: number;
+  readonly boundary?: boolean;
+  /** Original metadata may exist but is never consumed as role evidence. */
+  readonly band?: number;
+  readonly role?: unknown;
+}
+export interface SourceRoleCarrier { readonly virtualTarget: number; readonly period: number }
+export interface SourceRoleRequest {
+  readonly streams: readonly (readonly RawSourceEvent[])[];
+  readonly oldCarrier: SourceRoleCarrier;
+  readonly proposed?: SourceRoleCarrier;
+  /** Common observed half-open time interval; raw streams retain original indices. */
+  readonly from: number;
+  readonly to: number;
+}
+export interface SourcePrimaryObservation {
+  readonly ordinal: number;
+  readonly targetTime: number;
+  readonly censored: boolean;
+  readonly memberIndex: number | null;
+  readonly eventTime: number | null;
+  readonly residual: number | null;
+}
+export interface SourceWordToken {
+  readonly memberIndex: number;
+  readonly time: number;
+  readonly strength: number;
+  readonly bin: number;
+}
+export interface SourceCycleWord {
+  readonly ordinal: number;
+  readonly from: number;
+  readonly to: number;
+  readonly complete: boolean;
+  readonly mask12: number;
+  /** Ordered original members; multiplicity is retained even inside one bin. */
+  readonly tokens: readonly SourceWordToken[];
+}
+export interface SourceRoleTrack {
+  readonly source: 0 | 1 | 2 | 3;
+  readonly name: 'mixed' | 'low' | 'mid' | 'high';
+  readonly primary: readonly SourcePrimaryObservation[];
+  readonly opportunities: number;
+  readonly matched: number;
+  readonly coverage: number | null;
+  readonly longestConsecutive: number;
+  readonly firstMatchTime: number | null;
+  readonly lastMatchTime: number | null;
+  readonly matchedSpan: number;
+  readonly rawMembersInInterval: number;
+  readonly words: readonly SourceCycleWord[];
+}
+export interface CarrierRoleEvidence {
+  readonly carrier: SourceRoleCarrier;
+  readonly from: number;
+  readonly to: number;
+  readonly tolerance: number;
+  readonly targets: readonly { readonly ordinal: number; readonly time: number; readonly censored: boolean }[];
+  readonly sources: readonly SourceRoleTrack[];
+}
+export interface SourcePrimaryRelation {
+  readonly source: 0 | 1 | 2 | 3;
+  readonly oldOpportunities: number;
+  readonly proposedOpportunities: number;
+  readonly oldMemberIndices: readonly number[];
+  readonly proposedMemberIndices: readonly number[];
+  readonly shared: readonly number[];
+  readonly oldOnly: readonly number[];
+  readonly proposedOnly: readonly number[];
+  /** Set relations are observations, not metrical equivalence or change permission. */
+  readonly sameMembers: boolean;
+  readonly oldSubsetOfProposed: boolean;
+  readonly proposedSubsetOfOld: boolean;
+}
+export interface SourceRoleWork {
+  originalValidationReads: number;
+  boundaryMembersExcluded: number;
+  carrierEvaluations: number;
+  targetRecords: number;
+  primaryQueries: number;
+  binaryComparisons: number;
+  distanceComparisons: number;
+  duplicateTieReads: number;
+  wordMemberReads: number;
+  wordTokens: number;
+  cycleWords: number;
+  explicitTypedBytes: 0;
+}
+export interface SourceRoleInspection {
+  readonly old: CarrierRoleEvidence;
+  readonly proposed?: CarrierRoleEvidence;
+  readonly comparisons?: readonly SourcePrimaryRelation[];
+  readonly work: SourceRoleWork;
+}
+
+const NAMES = ['mixed', 'low', 'mid', 'high'] as const;
+const MAX_CYCLES = 20000; // Explicit allocation guard, not a musical support gate.
+
+/** For a fixed carrier, source membership/time determines every support choice.
+ * Strength is retained in word tokens but never affects IDs, bins or coverage.
+ * A full closed tolerance window must lie inside [from,to); censored targets do
+ * not enter a denominator. The12 bins never replace continuous-time support.
+ */
+export function inspectSourceRoleEvidence(input: SourceRoleRequest): SourceRoleInspection {
+  if (!Number.isFinite(input.from) || input.from < 0 || !Number.isFinite(input.to) || input.to <= input.from
+    || !Array.isArray(input.streams) || input.streams.length !== 4) throw Error('A finite observed interval and four original streams are required');
+  const work: SourceRoleWork = { originalValidationReads: 0, boundaryMembersExcluded: 0, carrierEvaluations: 0,
+    targetRecords: 0, primaryQueries: 0, binaryComparisons: 0, distanceComparisons: 0, duplicateTieReads: 0,
+    wordMemberReads: 0, wordTokens: 0, cycleWords: 0, explicitTypedBytes: 0 };
+  const regular = input.streams.map(stream => {
+    if (!Array.isArray(stream)) throw Error('Original source stream must be an array');
+    let previous = -Infinity;
+    const indices: number[] = [];
+    stream.forEach((event, memberIndex) => {
+      work.originalValidationReads++;
+      if (!event || !Number.isFinite(event.time) || event.time < 0 || event.time < previous
+        || !Number.isFinite(event.strength) || event.strength < 0) throw Error('Invalid original source event');
+      previous = event.time;
+      if (event.boundary) work.boundaryMembersExcluded++; else indices.push(memberIndex);
+    });
+    return indices;
+  });
+  const lowerBound = (source: number, time: number): number => {
+    const indices = regular[source], stream = input.streams[source];
+    let low = 0, high = indices.length;
+    while (low < high) {
+      const middle = (low + high) >>> 1; work.binaryComparisons++;
+      if (stream[indices[middle]].time < time) low = middle + 1; else high = middle;
+    }
+    return low;
+  };
+  const inspectCarrier = (carrier: SourceRoleCarrier): CarrierRoleEvidence => {
+    const v = carrier.virtualTarget, period = carrier.period;
+    if (!Number.isFinite(v) || !Number.isFinite(period) || period <= 0) throw Error('Finite virtual target and positive period are required');
+    for (const anchor of [v, input.from, input.to]) {
+      const before = anchor - period, after = anchor + period;
+      if (!Number.isFinite(before) || !Number.isFinite(after) || before >= anchor || after <= anchor)
+        throw Error('Carrier period cannot make finite numerical progress at the observed anchors');
+    }
+    const firstCycle = Math.floor((input.from - v) / period), lastCycle = Math.floor((input.to - v) / period);
+    if (!Number.isSafeInteger(firstCycle) || !Number.isSafeInteger(lastCycle)
+      || Math.abs(firstCycle) > Number.MAX_SAFE_INTEGER - 4 || Math.abs(lastCycle) > Number.MAX_SAFE_INTEGER - 4
+      || lastCycle - firstCycle + 1 > MAX_CYCLES)
+      throw Error('Carrier exceeds the explicit cycle-allocation bound');
+    work.carrierEvaluations++;
+    const tolerance = Math.min(.09, .2 * period);
+    const targets: { ordinal: number; time: number; censored: boolean }[] = [];
+    let previousBoundary = -Infinity;
+    for (let ordinal = firstCycle - 1; ordinal <= lastCycle + 1; ordinal++) {
+      const time = v + ordinal * period;
+      if (!Number.isFinite(time) || time <= previousBoundary) throw Error('Carrier targets cannot make finite numerical progress');
+      previousBoundary = time;
+      if (time < input.from || time >= input.to) continue;
+      // Original subtraction predicates; an endpoint equal to `to` is outside
+      // the observed half-open interval and hence conservatively censored.
+      const censored = time - input.from < tolerance || input.to - time <= tolerance;
+      targets.push({ ordinal, time, censored }); work.targetRecords++;
+    }
+    const sources = input.streams.map((stream, sourceIndex): SourceRoleTrack => {
+      const source = sourceIndex as 0 | 1 | 2 | 3, indices = regular[source];
+      let opportunities = 0, matched = 0, longestConsecutive = 0, run = 0;
+      let firstMatchTime: number | null = null, lastMatchTime: number | null = null, lastMember = -1;
+      const primary: SourcePrimaryObservation[] = [];
+      for (const target of targets) {
+        let chosen: number | null = null, distance = Infinity;
+        if (!target.censored) {
+          opportunities++; work.primaryQueries++;
+          const right = lowerBound(source, target.time);
+          let left = right - 1;
+          // Equal-time duplicates retain the earliest ORIGINAL member index.
+          while (left > 0 && stream[indices[left - 1]].time === stream[indices[left]].time) { left--; work.duplicateTieReads++; }
+          for (const position of [left, right]) {
+            if (position < 0 || position >= indices.length) continue;
+            const member = indices[position], d = Math.abs(stream[member].time - target.time); work.distanceComparisons++;
+            if (d > tolerance) continue;
+            if (d < distance || d === distance && (chosen === null || stream[member].time < stream[chosen].time
+              || stream[member].time === stream[chosen].time && member < chosen)) { chosen = member; distance = d; }
+          }
+        }
+        if (chosen !== null) {
+          if (chosen <= lastMember) throw Error('Nonoverlapping primary windows reused or reordered a source member');
+          lastMember = chosen; matched++; run++; longestConsecutive = Math.max(longestConsecutive, run);
+          if (firstMatchTime === null) firstMatchTime = stream[chosen].time;
+          lastMatchTime = stream[chosen].time;
+        } else run = 0;
+        primary.push({ ordinal: target.ordinal, targetTime: target.time, censored: target.censored, memberIndex: chosen,
+          eventTime: chosen === null ? null : stream[chosen].time, residual: chosen === null ? null : stream[chosen].time - target.time });
+      }
+      const words: { ordinal: number; from: number; to: number; complete: boolean; mask12: number; tokens: SourceWordToken[] }[] = [];
+      // Include each cycle intersecting the interval, including empty cycles.
+      for (let ordinal = firstCycle - 1; ordinal <= lastCycle + 1; ordinal++) {
+        const from = v + ordinal * period, to = v + (ordinal + 1) * period;
+        if (!Number.isFinite(from) || !Number.isFinite(to) || to <= from) throw Error('Carrier cycle cannot make finite numerical progress');
+        if (to <= input.from || from >= input.to) continue;
+        words.push({ ordinal, from, to, complete: from >= input.from && to <= input.to, mask12: 0, tokens: [] }); work.cycleWords++;
+      }
+      const byOrdinal = new Map(words.map(word => [word.ordinal, word]));
+      let rawMembersInInterval = 0;
+      for (let i = lowerBound(source, input.from); i < indices.length; i++) {
+        const memberIndex = indices[i], event = stream[memberIndex]; work.wordMemberReads++;
+        if (event.time >= input.to) break;
+        let ordinal = Math.floor((event.time - v) / period);
+        // Correct only floating-point boundary ownership, never fit an offset.
+        for (let corrections = 0; event.time < v + ordinal * period; corrections++) {
+          if (corrections >= 2 || Math.abs(ordinal) > Number.MAX_SAFE_INTEGER - 4
+            || v + (ordinal - 1) * period >= v + ordinal * period) throw Error('Carrier cycle ownership cannot progress backwards');
+          ordinal--;
+        }
+        for (let corrections = 0; event.time >= v + (ordinal + 1) * period; corrections++) {
+          if (corrections >= 2 || Math.abs(ordinal) > Number.MAX_SAFE_INTEGER - 4
+            || v + (ordinal + 2) * period <= v + (ordinal + 1) * period) throw Error('Carrier cycle ownership cannot progress forwards');
+          ordinal++;
+        }
+        const word = byOrdinal.get(ordinal);
+        if (!word) throw Error('Original event is missing its carrier cycle');
+        const fraction = (event.time - word.from) / period;
+        const bin = Math.max(0, Math.min(11, Math.floor(fraction * 12)));
+        word.tokens.push({ memberIndex, time: event.time, strength: event.strength, bin }); word.mask12 |= 1 << bin;
+        rawMembersInInterval++; work.wordTokens++;
+      }
+      return { source, name: NAMES[source], primary, opportunities, matched, coverage: opportunities ? matched / opportunities : null,
+        longestConsecutive, firstMatchTime, lastMatchTime, matchedSpan: firstMatchTime === null ? 0 : lastMatchTime! - firstMatchTime,
+        rawMembersInInterval, words };
+    });
+    return { carrier: { virtualTarget: v, period }, from: input.from, to: input.to, tolerance, targets, sources };
+  };
+  const old = inspectCarrier(input.oldCarrier);
+  if (!input.proposed) return { old, work };
+  const proposed = inspectCarrier(input.proposed);
+  const comparisons = old.sources.map((track, sourceIndex): SourcePrimaryRelation => {
+    const other = proposed.sources[sourceIndex];
+    const oldMemberIndices = track.primary.flatMap(value => value.memberIndex === null ? [] : [value.memberIndex]);
+    const proposedMemberIndices = other.primary.flatMap(value => value.memberIndex === null ? [] : [value.memberIndex]);
+    const oldSet = new Set(oldMemberIndices), newSet = new Set(proposedMemberIndices);
+    const shared = oldMemberIndices.filter(id => newSet.has(id)), oldOnly = oldMemberIndices.filter(id => !newSet.has(id));
+    const proposedOnly = proposedMemberIndices.filter(id => !oldSet.has(id));
+    return { source: sourceIndex as 0 | 1 | 2 | 3, oldOpportunities: track.opportunities, proposedOpportunities: other.opportunities,
+      oldMemberIndices, proposedMemberIndices, shared, oldOnly, proposedOnly, sameMembers: !oldOnly.length && !proposedOnly.length,
+      oldSubsetOfProposed: !oldOnly.length, proposedSubsetOfOld: !proposedOnly.length };
+  });
+  return { old, proposed, comparisons, work };
+}
