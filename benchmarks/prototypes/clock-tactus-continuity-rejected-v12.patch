+++ b/src/core/tactus-carrier.ts
@@ -0,0 +1,260 @@
+/** Unexecuted geometry primitive. This is not a tracker or a source/change
+ * detector. ChangeWitness is an evidence-binding interface, not proof that the
+ * source observations establish a musical tempo/phase change. ROOT must connect
+ * and independently validate an actual evidence producer before musical use. */
+export interface PrimaryObservation { readonly id: number; readonly time: number }
+export interface ObservedGrid { readonly period: number; readonly anchor: number }
+export interface CarrierSeed {
+  readonly observation: PrimaryObservation;
+  readonly virtualTarget: number;
+  readonly period: number;
+  readonly tolerance: number;
+  /** Must encode ALL source/role/pending-change memory used by future scoring. */
+  readonly sourceStateKey: string;
+}
+export interface KnownCarrier {
+  readonly status: 'known';
+  readonly chainId: number;
+  readonly lastPrimaryId: number;
+  readonly lastPrimaryTime: number;
+  readonly virtualTarget: number;
+  /** Duration of the next beat, selected at this virtual primary boundary. */
+  readonly period: number;
+  /** Includes unobserved intervening primary targets when m > 1. */
+  readonly beatOrdinal: number;
+  readonly consumedCursor: number;
+  readonly sourceStateKey: string;
+  /** Descriptive only in this primitive: never used to re-anchor the carrier. */
+  readonly observedGrid: ObservedGrid | null;
+  readonly lastChangeProofId: string | null;
+}
+export interface UnknownCarrier {
+  readonly status: 'unknown';
+  readonly nextChainId: number;
+  readonly consumedCursor: number;
+  readonly unavailableUntil: number;
+  readonly unavailableRuleId: string;
+  readonly unavailableProofId: string;
+}
+export type Carrier = KnownCarrier | UnknownCarrier;
+
+export interface ChangeDestination {
+  readonly chainId: number;
+  readonly lastPrimaryId: number;
+  readonly lastPrimaryTime: number;
+  readonly virtualTarget: number;
+  readonly period: number;
+  readonly beatOrdinal: number;
+  readonly sourceStateKey: string;
+}
+export interface ChangeWitness {
+  readonly schema: 'tactus-change-witness/v1';
+  readonly kind: 'tempo-update' | 'phase-reset' | 'source-relay';
+  /** Complete future-relevant old state binding, including consumed cursor.
+   * Descriptive grid/audit IDs are excluded as documented by continuationKey. */
+  readonly fromStateKey: string;
+  readonly to: ChangeDestination;
+  readonly evidence: {
+    readonly ruleId: string;
+    readonly proofId: string;
+    readonly physicalEventIds: readonly number[];
+    /** Opaque source evidence. This module never treats a Boolean as validity. */
+    readonly payload: Readonly<Record<string, unknown>>;
+  };
+}
+export interface UnknownEvidence {
+  readonly from: number;
+  readonly to: number;
+  readonly ruleId: string;
+  readonly proofId: string;
+}
+export interface TempoDestination { readonly period: number; readonly sourceStateKey: string }
+
+function finite(value: number, name: string): void {
+  if (!Number.isFinite(value)) throw Error(`${name} must be finite`);
+}
+function positive(value: number, name: string): void {
+  finite(value, name); if (value <= 0) throw Error(`${name} must be positive`);
+}
+function identifier(value: number, name: string, minimum = 0): void {
+  if (!Number.isSafeInteger(value) || value < minimum) throw Error(`${name} must be a safe integer >= ${minimum}`);
+}
+function text(value: string, name: string): void {
+  if (typeof value !== 'string' || !value.length) throw Error(`${name} must be nonempty`);
+}
+function observation(value: PrimaryObservation): void {
+  if (!value) throw Error('Missing observation');
+  identifier(value.id, 'observation.id'); finite(value.time, 'observation.time');
+  if (value.time < 0) throw Error('observation.time must be nonnegative');
+}
+function tolerance(value: number, period: number): void {
+  finite(value, 'tolerance');
+  if (value < 0 || value >= period / 2) throw Error('tolerance must be in [0,period/2)');
+}
+function validateSeed(seed: CarrierSeed): void {
+  if (!seed) throw Error('Missing seed');
+  observation(seed.observation); finite(seed.virtualTarget, 'virtualTarget');
+  if (seed.virtualTarget < 0) throw Error('virtualTarget must be nonnegative');
+  positive(seed.period, 'period'); tolerance(seed.tolerance, seed.period); text(seed.sourceStateKey, 'sourceStateKey');
+  if (Math.abs(seed.observation.time - seed.virtualTarget) > seed.tolerance) throw Error('Seed observation outside closed tolerance');
+}
+function known(state: KnownCarrier): void {
+  if (!state || state.status !== 'known') throw Error('Known carrier required');
+  identifier(state.chainId, 'chainId'); identifier(state.lastPrimaryId, 'lastPrimaryId');
+  finite(state.lastPrimaryTime, 'lastPrimaryTime'); finite(state.virtualTarget, 'virtualTarget');
+  if (state.lastPrimaryTime < 0 || state.virtualTarget < 0) throw Error('Negative carrier time');
+  positive(state.period, 'period'); identifier(state.beatOrdinal, 'beatOrdinal');
+  identifier(state.consumedCursor, 'consumedCursor');
+  if (state.consumedCursor < state.lastPrimaryId) throw Error('Cursor precedes actual primary');
+  text(state.sourceStateKey, 'sourceStateKey');
+  if (state.observedGrid) { positive(state.observedGrid.period, 'grid.period'); finite(state.observedGrid.anchor, 'grid.anchor'); }
+  if (state.lastChangeProofId !== null) text(state.lastChangeProofId, 'lastChangeProofId');
+}
+function unknown(state: UnknownCarrier): void {
+  if (!state || state.status !== 'unknown') throw Error('Unknown carrier required');
+  identifier(state.nextChainId, 'nextChainId'); identifier(state.consumedCursor, 'consumedCursor', -1);
+  finite(state.unavailableUntil, 'unavailableUntil');
+  if (state.unavailableUntil < 0) throw Error('Negative unknown end');
+  text(state.unavailableRuleId, 'unavailableRuleId'); text(state.unavailableProofId, 'unavailableProofId');
+}
+function validate(state: Carrier): void { if (state?.status === 'known') known(state); else unknown(state as UnknownCarrier); }
+function freezeKnown(state: KnownCarrier): KnownCarrier { return Object.freeze(state); }
+function destination(state: KnownCarrier): ChangeDestination {
+  return { chainId: state.chainId, lastPrimaryId: state.lastPrimaryId, lastPrimaryTime: state.lastPrimaryTime,
+    virtualTarget: state.virtualTarget, period: state.period, beatOrdinal: state.beatOrdinal, sourceStateKey: state.sourceStateKey };
+}
+
+/** Initialization only; a tracker must not call this to bypass an existing chain. */
+export function createCarrier(seed: CarrierSeed, chainId = 0): KnownCarrier {
+  validateSeed(seed); identifier(chainId, 'chainId');
+  return freezeKnown({ status: 'known', chainId, lastPrimaryId: seed.observation.id,
+    lastPrimaryTime: seed.observation.time, virtualTarget: seed.virtualTarget, period: seed.period,
+    beatOrdinal: 0, consumedCursor: seed.observation.id, sourceStateKey: seed.sourceStateKey,
+    observedGrid: null, lastChangeProofId: null });
+}
+
+/** Observation residual never becomes a phase update. No new period is inferred. */
+export function advancePrimary(state: KnownCarrier, next: PrimaryObservation, m: number, closedTolerance: number): KnownCarrier {
+  known(state); observation(next); identifier(m, 'm', 1); tolerance(closedTolerance, state.period);
+  if (next.id <= state.consumedCursor || next.time <= state.lastPrimaryTime) throw Error('Primary must follow cursor and actual time');
+  const target = state.virtualTarget + m * state.period, ordinal = state.beatOrdinal + m;
+  finite(target, 'next virtualTarget'); identifier(ordinal, 'next beatOrdinal');
+  if (target <= state.virtualTarget) throw Error('Target did not advance numerically');
+  if (Math.abs(next.time - target) > closedTolerance) throw Error('Observation outside persistent target closed tolerance');
+  return freezeKnown({ ...state, lastPrimaryId: next.id, lastPrimaryTime: next.time,
+    virtualTarget: target, beatOrdinal: ordinal, consumedCursor: next.id });
+}
+
+/** Re-division/relabeling changes only the observation descriptor. In particular
+ * A -> A+kP (a gauge change) cannot move any primary target or target ordinal. */
+export function observeGrid(state: KnownCarrier, grid: ObservedGrid): KnownCarrier {
+  known(state); if (!grid) throw Error('Missing observed grid');
+  positive(grid.period, 'grid.period'); finite(grid.anchor, 'grid.anchor');
+  return freezeKnown({ ...state, observedGrid: Object.freeze({ period: grid.period, anchor: grid.anchor }) });
+}
+
+/** A secondary observation can advance consumption past the last primary.
+ * lastPrimaryId and virtualTarget remain independent of this global cursor. */
+export function advanceCursor(state: KnownCarrier, cursor: number): KnownCarrier;
+export function advanceCursor(state: UnknownCarrier, cursor: number): UnknownCarrier;
+export function advanceCursor(state: Carrier, cursor: number): Carrier;
+export function advanceCursor(state: Carrier, cursor: number): Carrier {
+  validate(state); identifier(cursor, 'cursor', -1);
+  if (cursor < state.consumedCursor) throw Error('Cursor moved backward');
+  return Object.freeze({ ...state, consumedCursor: cursor });
+}
+
+/** Same future iff all persisted predictive memory is equal. observedGrid and
+ * audit proof IDs are excluded ONLY because this primitive never reads them for
+ * future legality/scoring. A full tracker must add any such dependencies to its
+ * own context key. Exact carrier doubles are retained; no phase binning occurs. */
+export function continuationKey(state: Carrier): string {
+  validate(state);
+  return state.status === 'known'
+    ? JSON.stringify(['known', state.chainId, state.lastPrimaryId, state.lastPrimaryTime, state.virtualTarget,
+      state.period, state.beatOrdinal, state.sourceStateKey])
+    : JSON.stringify(['unknown', state.nextChainId, state.unavailableUntil]);
+}
+export function stateKey(state: Carrier): string { return JSON.stringify([continuationKey(state), state.consumedCursor]); }
+
+function witness(state: KnownCarrier, next: KnownCarrier, kind: ChangeWitness['kind'], proof: ChangeWitness): void {
+  if (!proof || proof.schema !== 'tactus-change-witness/v1' || proof.kind !== kind) throw Error('Explicit bound change witness required');
+  if (proof.fromStateKey !== stateKey(state)) throw Error('Witness belongs to a different complete old state');
+  const expected = destination(next), actual = proof.to;
+  if (!actual || (Object.keys(expected) as (keyof ChangeDestination)[]).some(key => actual[key] !== expected[key]))
+    throw Error('Witness destination differs from proposed change');
+  const evidence = proof.evidence;
+  if (!evidence) throw Error('Missing witness evidence reference');
+  text(evidence.ruleId, 'evidence.ruleId'); text(evidence.proofId, 'evidence.proofId');
+  if (!Array.isArray(evidence.physicalEventIds) || !evidence.physicalEventIds.length) throw Error('Witness must reference physical observations');
+  let previous = -1;
+  for (const id of evidence.physicalEventIds) { identifier(id, 'evidence physical ID'); if (id <= previous) throw Error('Evidence IDs must increase'); previous = id; }
+  if (!evidence.physicalEventIds.includes(state.lastPrimaryId) || !evidence.physicalEventIds.includes(next.lastPrimaryId))
+    throw Error('Witness must bind old and new actual primary identities');
+  if (!evidence.payload || typeof evidence.payload !== 'object' || Array.isArray(evidence.payload)) throw Error('Opaque evidence payload object required');
+  // Binding validation deliberately does NOT certify the source evidence rule.
+}
+
+/** Genuine tempo update at the carried virtual beat boundary. There is no rho
+ * alias minimization and no simultaneous phase shift. Witness semantics belong
+ * to the independently validated source/change producer, not this primitive. */
+export function updateTempo(state: KnownCarrier, next: TempoDestination, proof: ChangeWitness): KnownCarrier {
+  known(state); if (!next) throw Error('Missing tempo destination');
+  positive(next.period, 'next period'); text(next.sourceStateKey, 'next sourceStateKey');
+  if (next.period === state.period) throw Error('Tempo update must change period; use source relay for source-only changes');
+  const result = freezeKnown({ ...state, period: next.period, sourceStateKey: next.sourceStateKey });
+  witness(state, result, 'tempo-update', proof);
+  return freezeKnown({ ...result, lastChangeProofId: proof.evidence.proofId });
+}
+
+/** A source can hand over the same continuing clock without changing tempo,
+ * phase, actual primary, target ordinal, cursor or chain. */
+export function relaySource(state: KnownCarrier, sourceStateKey: string, proof: ChangeWitness): KnownCarrier {
+  known(state); text(sourceStateKey, 'relay sourceStateKey');
+  if (sourceStateKey === state.sourceStateKey) throw Error('Source relay must change source state');
+  const result = freezeKnown({ ...state, sourceStateKey });
+  witness(state, result, 'source-relay', proof);
+  return freezeKnown({ ...result, lastChangeProofId: proof.evidence.proofId });
+}
+
+/** A real phase discontinuity starts an explicit new chain at a later physical
+ * observation. It cannot be hidden inside a grid or tempo update. */
+export function resetPhase(state: KnownCarrier, seed: CarrierSeed, proof: ChangeWitness): KnownCarrier {
+  known(state); validateSeed(seed);
+  if (seed.observation.id <= state.consumedCursor || seed.observation.time <= state.lastPrimaryTime)
+    throw Error('Phase reset must use a new unconsumed later primary');
+  if (seed.virtualTarget <= state.virtualTarget) throw Error('Phase reset virtual target must advance strictly');
+  const result = createCarrier(seed, state.chainId + 1);
+  witness(state, result, 'phase-reset', proof);
+  return freezeKnown({ ...result, lastChangeProofId: proof.evidence.proofId });
+}
+
+/** The caller must establish this unsupported span using an actual evidence
+ * rule. It is not a free reset edge and this primitive does not infer absence. */
+export function markUnknown(state: KnownCarrier, gap: UnknownEvidence): UnknownCarrier {
+  known(state); if (!gap) throw Error('Missing unsupported-span evidence');
+  finite(gap.from, 'gap.from'); finite(gap.to, 'gap.to');
+  if (gap.from < Math.max(state.lastPrimaryTime, state.virtualTarget) || gap.to <= gap.from)
+    throw Error('Unknown interval must follow actual and virtual primary times');
+  text(gap.ruleId, 'gap.ruleId'); text(gap.proofId, 'gap.proofId');
+  identifier(state.chainId + 1, 'next chainId');
+  return Object.freeze({ status: 'unknown', nextChainId: state.chainId + 1, consumedCursor: state.consumedCursor,
+    unavailableUntil: gap.to, unavailableRuleId: gap.ruleId, unavailableProofId: gap.proofId });
+}
+
+/** Old phase, period and source-role history have been discarded. The consumed
+ * physical cursor survives, so a new chain cannot reuse an old observation. */
+export function seedAfterUnknown(state: UnknownCarrier, seed: CarrierSeed): KnownCarrier {
+  unknown(state); validateSeed(seed);
+  if (seed.observation.id <= state.consumedCursor || seed.observation.time < state.unavailableUntil || seed.virtualTarget < state.unavailableUntil)
+    throw Error('New seed must follow consumed IDs and the unsupported interval');
+  return createCarrier(seed, state.nextChainId);
+}
+
+/** Reward convention: greater is better. This is a geometry/context dominance
+ * predicate only; caller scoring must depend solely on the complete key+cursor.
+ * New source summaries or pending witness obligations must enter sourceStateKey. */
+export function dominates(a: Carrier, rewardA: number, b: Carrier, rewardB: number): boolean {
+  finite(rewardA, 'rewardA'); finite(rewardB, 'rewardB');
+  return continuationKey(a) === continuationKey(b) && a.consumedCursor <= b.consumedCursor && rewardA >= rewardB;
+}
