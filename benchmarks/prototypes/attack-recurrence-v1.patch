index 0000000..fbdffe3
--- /dev/null
+++ b/src/core/phase-lattice.ts
@@ -0,0 +1,196 @@
+/** A phase-only continuity prior. All positions and periods are in seconds.
+ * Coverage and continuity select among existing supported phases of the one
+ * existing preferred period. This helper never reads audio or creates onsets. */
+export interface PhaseLatticeEvidence {
+  readonly anchor: number;
+  readonly meanResidual: number;
+  readonly coverage: number;
+  readonly unknown: boolean;
+  readonly supported: boolean;
+}
+export interface PhaseLatticeBlock {
+  readonly time: number;
+  readonly preferredPeriod: number | null;
+  readonly hypotheses: readonly {
+    readonly period: number;
+    readonly phases: readonly PhaseLatticeEvidence[];
+  }[];
+}
+export interface PhaseLatticeStateProfile {
+  phaseIndex: number;
+  anchor: number;
+  coverage: number;
+  forward: number;
+  backward: number;
+  maxMarginal: number;
+}
+export interface PhaseLatticeBlockProfile {
+  index: number;
+  time: number;
+  period: number | null;
+  hypothesisIndex: number | null;
+  reason: 'missing-period' | 'missing-hypothesis' | 'no-supported-phase' | 'eligible';
+  states: PhaseLatticeStateProfile[];
+  chosenState: number | null;
+  chosenPhaseIndex: number | null;
+  chosenAnchor: number | null;
+  chainIndex: number | null;
+  chainScore: number | null;
+  otherScore: number | null;
+  margin: number | null;
+  reliability: number;
+}
+export interface PhaseLatticeWork {
+  frames: number;
+  blocks: number;
+  eligibleBlocks: number;
+  eligibleStates: number;
+  maximumStates: number;
+  chains: number;
+  forwardTransitions: number;
+  backwardTransitions: number;
+  positiveFrames: number;
+  alignmentEvaluations: number;
+  changedFrames: number;
+  typedBytes: number;
+  returnedTypedBytes: number;
+  scratchTypedBytes: number;
+  profileBlocks: number;
+  profileStates: number;
+}
+export interface PhaseLatticeResult {
+  effectiveEnvelope: Float64Array;
+  blocks: PhaseLatticeBlockProfile[];
+  /** Eligible-state slots in original phase order; -1 means a chain break. */
+  path: Int8Array;
+  /** Sum of independent chain best scores; each block also records its Z. */
+  score: number;
+  reliability: Float64Array;
+  work: PhaseLatticeWork;
+}
+const STEP = .01, BLOCK_SECONDS = 2, TOLERANCE = .05, EPS = 1e-9, MAX_STATES = 4;
+
+export function applyPhaseLattice(envelope: Float64Array, input: readonly PhaseLatticeBlock[]): PhaseLatticeResult {
+  if (!(envelope instanceof Float64Array)) throw Error('Phase lattice requires a Float64 envelope');
+  for (const value of envelope)
+    if (!(Number.isFinite(value) && value >= 0)) throw Error('Invalid original phase envelope');
+  const n = input.length, slots = n * MAX_STATES;
+  const effectiveEnvelope = envelope.slice(), counts = new Uint8Array(n), periods = new Float64Array(n);
+  const anchors = new Float64Array(slots), coverage = new Float64Array(slots), phaseIndices = new Int8Array(slots);
+  const forward = new Float64Array(slots), backward = new Float64Array(slots), predecessor = new Int8Array(slots);
+  const path = new Int8Array(n), reliability = new Float64Array(n);
+  path.fill(-1); predecessor.fill(-1);
+  const profiles: PhaseLatticeBlockProfile[] = [];
+  const work: PhaseLatticeWork = { frames: envelope.length, blocks: n, eligibleBlocks: 0, eligibleStates: 0,
+    maximumStates: 0, chains: 0, forwardTransitions: 0, backwardTransitions: 0, positiveFrames: 0,
+    alignmentEvaluations: 0, changedFrames: 0, typedBytes: 0, returnedTypedBytes: 0,
+    scratchTypedBytes: 0, profileBlocks: n, profileStates: 0 };
+  for (let i = 0; i < n; i++) {
+    const block = input[i];
+    if (!Number.isFinite(block.time)) throw Error('Invalid phase block time');
+    const profile: PhaseLatticeBlockProfile = { index: i, time: block.time, period: null, hypothesisIndex: null,
+      reason: 'missing-period', states: [], chosenState: null, chosenPhaseIndex: null, chosenAnchor: null,
+      chainIndex: null, chainScore: null, otherScore: null, margin: null, reliability: 0 };
+    profiles.push(profile);
+    const period = block.preferredPeriod;
+    if (!(period !== null && Number.isFinite(period) && period > 0)) continue;
+    profile.period = period; periods[i] = period;
+    const hypothesisIndex = block.hypotheses.findIndex(h => Number.isFinite(h.period) && Math.abs(h.period - period) <= EPS);
+    if (hypothesisIndex < 0) { profile.reason = 'missing-hypothesis'; continue; }
+    profile.hypothesisIndex = hypothesisIndex;
+    const phases = block.hypotheses[hypothesisIndex].phases;
+    if (phases.length > MAX_STATES) throw Error('Phase hypothesis exceeds the original four-state bound');
+    profile.reason = 'no-supported-phase';
+    for (let j = 0; j < phases.length; j++) {
+      const phase = phases[j], anchor = phase.anchor + phase.meanResidual;
+      if (!phase.supported || phase.unknown || !Number.isFinite(phase.anchor) || !Number.isFinite(phase.meanResidual)
+        || !Number.isFinite(anchor) || !Number.isFinite(phase.coverage) || phase.coverage < 0 || phase.coverage > 1) continue;
+      const at = i * MAX_STATES + counts[i]++;
+      anchors[at] = anchor; coverage[at] = phase.coverage; phaseIndices[at] = j;
+    }
+    if (counts[i]) { profile.reason = 'eligible'; work.eligibleBlocks++; }
+    work.eligibleStates += counts[i]; work.maximumStates = Math.max(work.maximumStates, counts[i]);
+  }
+  const transition = (previous: number, previousState: number, current: number, currentState: number): number => {
+    const midpoint = (input[previous].time + input[current].time) / 2;
+    const z = (midpoint - anchors[current * MAX_STATES + currentState]) / periods[current]
+      - (midpoint - anchors[previous * MAX_STATES + previousState]) / periods[previous];
+    if (!Number.isFinite(z)) throw Error('Nonfinite phase transition arithmetic');
+    const d = z - Math.round(z);
+    return 4 * d * d;
+  };
+  let score = 0, begin = 0;
+  while (begin < n) {
+    if (!counts[begin]) { begin++; continue; }
+    let end = begin;
+    while (end + 1 < n && counts[end + 1]) end++;
+    const chainIndex = work.chains++;
+    for (let i = begin; i <= end; i++) for (let s = 0; s < counts[i]; s++) {
+      const at = i * MAX_STATES + s;
+      if (i === begin) { forward[at] = coverage[at]; continue; }
+      let best = -Infinity, bestState = -1;
+      for (let p = 0; p < counts[i - 1]; p++) {
+        work.forwardTransitions++;
+        const value = forward[(i - 1) * MAX_STATES + p] - transition(i - 1, p, i, s);
+        if (value > best) { best = value; bestState = p; }
+      }
+      forward[at] = coverage[at] + best; predecessor[at] = bestState;
+    }
+    for (let i = end - 1; i >= begin; i--) for (let s = 0; s < counts[i]; s++) {
+      let best = -Infinity;
+      for (let u = 0; u < counts[i + 1]; u++) {
+        work.backwardTransitions++;
+        const at = (i + 1) * MAX_STATES + u;
+        const value = coverage[at] - transition(i, s, i + 1, u) + backward[at];
+        if (value > best) best = value;
+      }
+      backward[i * MAX_STATES + s] = best;
+    }
