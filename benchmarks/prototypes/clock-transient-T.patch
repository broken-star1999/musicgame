+import type { AcousticEvidence } from '../types';
+
+/** Raw power of the original one-sided k=1..n/2-1 amplitude loop.
+ * These six arrays add no FFT and retain no spectrum per frame. */
+export interface AcousticFrames {
+  bandPower: [Float64Array, Float64Array, Float64Array];
+  sumPower: Float64Array;
+  sumPowerSquared: Float64Array;
+  frequencyPower: Float64Array;
+  frames: number; n: number; hop: number; sampleRate: number; lag: number;
+  profiles: Map<number, AcousticEvidence | undefined>;
+  work: { powerBins: number; profileRequests: number; profilesBuilt: number; invalidProfiles: number; extraFFTCalls: 0; typedArrays: 6; typedBytes: number };
+}
+export function createAcousticFrames(frames: number, n: number, hop: number, sampleRate: number): AcousticFrames {
+  return {
+    bandPower: [new Float64Array(frames), new Float64Array(frames), new Float64Array(frames)],
+    sumPower: new Float64Array(frames), sumPowerSquared: new Float64Array(frames), frequencyPower: new Float64Array(frames),
+    frames, n, hop, sampleRate, lag: Math.ceil(n / hop), profiles: new Map(),
+    work: { powerBins: 0, profileRequests: 0, profilesBuilt: 0, invalidProfiles: 0, extraFFTCalls: 0, typedArrays: 6, typedBytes: 6 * frames * Float64Array.BYTES_PER_ELEMENT },
+  };
+}
+export function accumulateAcousticPower(state: AcousticFrames, frame: number, bin: number, amplitude: number): void {
+  const frequency = bin * state.sampleRate / state.n;
+  const power = amplitude * amplitude, band = frequency < 250 ? 0 : frequency < 2500 ? 1 : 2;
+  state.bandPower[band][frame] += power;
+  state.sumPower[frame] += power;
+  state.sumPowerSquared[frame] += power * power;
+  state.frequencyPower[frame] += frequency * power;
+  state.work.powerBins++;
+}
+const valid = (x: number): boolean => Number.isFinite(x) && x >= 0;
+const bounded = (x: number): number => Math.max(0, Math.min(1, x));
+/** Only called for retained regular measured onsets. f0 is left-censored and
+ * deliberately never receives a profile. Invalid current data means missing. */
+export function acousticProfileAt(state: AcousticFrames, frame: number): AcousticEvidence | undefined {
+  state.work.profileRequests++;
+  if (!(Number.isInteger(frame) && frame > 0 && frame < state.frames)) return undefined;
+  if (state.profiles.has(frame)) return state.profiles.get(frame);
+  const bands = state.bandPower.map(values => values[frame]), total = state.sumPower[frame];
+  const square = state.sumPowerSquared[frame], frequency = state.frequencyPower[frame], totalSquared = total * total;
+  if (![...bands, total, square, frequency, totalSquared].every(valid) || !(state.sampleRate > 0 && Number.isFinite(state.sampleRate))) {
+    state.profiles.set(frame, undefined); state.work.invalidProfiles++; return undefined;
+  }
+  const low = bands[0], pastFrame = frame - state.lag, futureFrame = frame + state.lag;
+  const past = pastFrame >= 0 ? state.bandPower[0][pastFrame] : NaN;
+  const future = futureFrame < state.frames ? state.bandPower[0][futureFrame] : NaN;
+  const hasHistory = valid(past) && Number.isFinite(low + past);
+  const hasFuture = valid(future) && Number.isFinite(low + future);
+  const profile: AcousticEvidence = {
+    powerFractions: total > 0 ? bands.map(value => bounded(value / total)) as [number, number, number] : [0, 0, 0],
+    centroidNormalized: total > 0 ? bounded((frequency / total) / (state.sampleRate / 2)) : 0,
+    concentration: totalSquared > 0 ? bounded(square / totalSquared) : 0,
+    lowRise: hasHistory && low + past > 0 ? bounded(Math.max(0, low - past) / (low + past)) : 0,
+    lowDecay: hasFuture && low + future > 0 ? bounded(Math.max(0, low - future) / (low + future)) : 0,
+    hasHistory, hasFuture,
+  };
+  if (!profile.powerFractions.every(Number.isFinite) || ![profile.centroidNormalized, profile.concentration, profile.lowRise, profile.lowDecay].every(Number.isFinite)) {
+    state.profiles.set(frame, undefined); state.work.invalidProfiles++; return undefined;
+  }
+  state.profiles.set(frame, profile); state.work.profilesBuilt++;
+  return profile;
+}
