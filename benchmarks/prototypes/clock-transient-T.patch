diff --git a/src/core/transient-envelope.ts b/src/core/transient-envelope.ts
new file mode 100644
--- /dev/null
+++ b/src/core/transient-envelope.ts
@@ -0,0 +1,25 @@
+import type { Onset } from '../types';
+
+/** Fixed T hypothesis: preserve each old event amplitude, add its own physical
+ * low-band attack/decay bonus, then apply the original Gaussian/max projection.
+ * This is not an instrument classifier or a proven musical beat-layer model. */
+export function transientEnvelope(projected: Onset[], frames: number, reference: number) {
+  const oldEnvelope = new Float64Array(frames), envelope = new Float64Array(frames);
+  const bonuses = projected.map(onset => {
+    const p = onset.acoustic;
+    if (!(onset.strength > 0) || onset.boundary || !p || !p.hasHistory || !p.hasFuture) return 0;
+    const values = [...p.powerFractions, p.centroidNormalized, p.concentration, p.lowRise, p.lowDecay];
+    if (!values.every(value => Number.isFinite(value) && value >= 0 && value <= 1)) return 0;
+    return p.powerFractions[0] * p.lowRise * p.lowDecay;
+  });
+  for (let i = 0; i < projected.length; i++) {
+    const onset = projected[i], center = Math.round(onset.time / .01), oldAmplitude = onset.strength / reference;
+    const amplitude = oldAmplitude + bonuses[i];
+    for (let d = -4; d <= 4; d++) if (center + d >= 0 && center + d < frames) {
+      const kernel = Math.exp(-d * d / 5);
+      oldEnvelope[center + d] = Math.max(oldEnvelope[center + d], oldAmplitude * kernel);
+      envelope[center + d] = Math.max(envelope[center + d], amplitude * kernel);
+    }
+  }
+  return { oldEnvelope, envelope, bonuses };
+}
