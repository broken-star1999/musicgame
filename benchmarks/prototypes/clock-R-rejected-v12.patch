+    expect(generateChart(base, 'one').notes.map(note => note.time)).toEqual([1, 1.5]);
+    expect(generateChart({ ...base, recognition: { engine: 'beat-this' } }, 'one').notes.map(note => note.time)).toEqual([1, 1.5]);
+    expect(base).toEqual(original);
