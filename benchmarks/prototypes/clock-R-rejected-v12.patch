+      { ...onset(1.6, 0.2), role: 'beat' },
+    ];
+    const original = structuredClone(events);
+    expect(selectMusicalOnsets(events, 0.4, 0.1).map(event => event.time)).toEqual([1, 1.6]);
+    expect(selectMusicalOnsets(events, 0.4, 0.1, event => event.time, 'salience')).toEqual([events[1]]);
+    expect(events).toEqual(original);
+  });
+
+  it('uses the role backbone to break equal salience scores', () => {
+    const events: Onset[] = [{ ...onset(1, 0.5), role: 'half' }, { ...onset(1.1, 0.5), role: 'beat' }];
+    expect(selectMusicalOnsets(events, 0.3, 0.1, event => event.time, 'salience')).toEqual([events[1]]);
+  });
+
+  it('protects an eligible measured attack from a conflicting uncertain opening cue', () => {
+    const cue: Onset = { ...onset(0, 1), boundary: true };
+    const measured: Onset = { ...onset(0.2, 0.2), role: 'beat' };
+    expect(selectMusicalOnsets([cue, measured], 0.3, 0.1, event => event.time, 'salience')).toEqual([measured]);
+    const atGap = { ...measured, time: 0.3 };
+    expect(selectMusicalOnsets([cue, atGap], 0.3, 0.1, event => event.time, 'salience')).toEqual([cue, atGap]);
+    expect(selectMusicalOnsets([cue, onset(0.2, 0.01)], 0.3, 0.1, event => event.time, 'salience')).toEqual([cue]);
+  });
+
+  it('routes only explicit signal results to salience selection', () => {
+    const events: Onset[] = [
+      { ...onset(1, 0.2), role: 'beat' },
+      { ...onset(1.25, 1), role: 'beat' },
+      { ...onset(1.5, 0.2), role: 'beat' },
+    ];
+    const base: Analysis = { duration: 3, bpm: 120, confidence: 1, fingerprint: 'signal-salience-route', onsets: events, energy: [], energyStep: 0.05, waveform: [], rhythm: { beats: [1, 1.5, 2], tempo: [], confidence: 1, downbeats: [], meterConfidence: 0 } };
+    const original = structuredClone(base);
